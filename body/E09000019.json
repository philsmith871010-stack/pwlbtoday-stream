rngov.co.uk/documents/s47380/appendix-1-q4-202526-capital-programme.pdf","committee":"Executive","date":"25/06/2026","key":true},{"title":"Appendix 2 - Approved and Indicative Capital Programme Q4 2025-26","url":"https://islington.moderngov.co.uk/documents/s47381/appendix-2-approved-and-indicative-capital-programme-q4-2025.pdf","committee":"Executive","date":"25/06/2026","key":true}],"read_documents":[{"title":"Treasury Management Outturn - 1033284","url":"https://islington.moderngov.co.uk/documents/s47870/Committee report Treasury Full Year 2026 LIs.pdf","committee":"Executive","date":"2026-07-30","category":"treasury","fy":"2025/26"}],"calendar":{"upcoming":[{"date":"2026-09-21","committee":"Environment, Climate and Transport Scrutiny Committee","time":"7.30 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-22","committee":"Audit and Risk Committee","time":"7.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-22","committee":"Pensions Board","time":"4.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-22","committee":"Health, Wellbeing and Adult Social Care Scrutiny Committee","time":"7.30 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-24","committee":"Council","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-10-01","committee":"Children and Young People Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-10-08","committee":"Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-10-15","committee":"Health, Wellbeing and Adult Social Care Scrutiny Committee","time":"7.30 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"}],"recent":[{"date":"2026-09-15","committee":"Pensions Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-15","committee":"Children and Young People Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-17","committee":"Executive","time":"5.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-17","committee":"Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.islington.gov.uk"},{"date":"2026-09-18","committee":"Joint Overview and Scrutiny Committee on Health","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://democracy.islington.gov.uk"}]},"news":[],"news_drafts":[{"headline":"The council has headroom of only \u00a310.8m above its minimum reserve threshold, while facing quantified risks ranging from \u00a315\u201360m each.","lead":"Limited headroom relative to quantified, well-understood risks (particularly temporary accommodation and social care demand) means the council has minimal flexibility to absorb financial shocks without falling below its minimum reserve level.","iso":"2026-09-22","paper_title":"B5) General Fund Reserves Policy - ARC 22.09.26","paper_url":"https://islington.moderngov.co.uk/documents/s48208/48208.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Islington's reserves are materially below comparable Inner London boroughs, at 49% of Core Spending Power versus a peer average of 61%.","lead":"Reserve adequacy below peer comparators is a key early indicator of financial distress. The comparison to boroughs in EFS is particularly material to lenders assessing whether Islington is on a similar trajectory.","iso":"2026-09-22","paper_title":"B5) General Fund Reserves Policy - ARC 22.09.26","paper_url":"https://islington.moderngov.co.uk/documents/s48208/48208.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"The council's MTFS gap of \u00a3105.7m nearly equals its usable reserves of \u00a3104.9m, meaning reserves cannot solve the structural deficit.","lead":"A lender needs to know whether the council has a credible plan to close its structural gap or will rely on reserve depletion. Reserves nearly equal in size to the gap provide limited time to deliver savings without financial distress.","iso":"2026-09-22","paper_title":"B5) General Fund Reserves Policy - ARC 22.09.26","paper_url":"https://islington.moderngov.co.uk/documents/s48208/48208.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-22","committee":"Audit and Risk Committee","paper_title":"B5) General Fund Reserves Policy - ARC 22.09.26","paper_url":"https://islington.moderngov.co.uk/documents/s48208/48208.pdf","headline":"The council has headroom of only \u00a310.8m above its minimum reserve threshold, while facing quantified risks ranging from \u00a315\u201360m each.","detail":"The council's minimum reserve threshold is 25% of Core Spending Power, equating to \u00a394.1m. Current Budget Risk reserves of \u00a359.8m plus General Balances of \u00a345.2m provide headroom of \u00a310.8m above this minimum. However, the paper provides illustrative risks that could materialise, including temporary accommodation demand surges (\u00a315\u201340m), Fair Funding system impacts (\u00a360m), and adult social care demand shocks (\u00a310\u201325m), any of which would exceed or significantly erode this headroom.","category":"reserves","matters":"Limited headroom relative to quantified, well-understood risks (particularly temporary accommodation and social care demand) means the council has minimal flexibility to absorb financial shocks without falling below its minimum reserve level.","figures":"\u00a310.8m headroom; temporary accommodation \u00a315\u201340m; Fair Funding \u00a360m; adult social care \u00a310\u201325m","quote":"25% of CSP in 2026/27 equates to \u00a394.1m. Budget Risk reserves equate to 28% giving headroom above the minimum level of reserves of \u00a311m as set out in Table 2 below.","material":true},{"iso":"2026-09-22","committee":"Audit and Risk Committee","paper_title":"B5) General Fund Reserves Policy - ARC 22.09.26","paper_url":"https://islington.moderngov.co.uk/documents/s48208/48208.pdf","headline":"Islington's reserves are materially below comparable Inner London boroughs, at 49% of Core Spending Power versus a peer average of 61%.","detail":"Benchmarking against Inner London boroughs using the most recent published accounts shows Islington's reserves at 49% of CSP versus an average of 61% across Inner London. By an alternative measure (reserves as percentage of gross expenditure), Islington holds 14% compared to a peer average of 20%. The paper notes that only two Inner London boroughs have lower reserves than Islington, and both are currently in Exceptional Financial Support.","category":"reserves","matters":"Reserve adequacy below peer comparators is a key early indicator of financial distress. The comparison to boroughs in EFS is particularly material to lenders assessing whether Islington is on a similar trajectory.","figures":"49% of CSP vs 61% peer average; 14% of gross expenditure vs 20% peer average","quote":"Using the last complete set of published accounts (2024/25), the average percentage of all General Fund reserves to CSP was 61%. Islington's calculation was approximately 49% and therefore below average... The only two Inner London Boroughs with lower reserves than Islington are in EFS.","material":true},{"iso":"2026-09-22","committee":"Audit and Risk Committee","paper_title":"B5) General Fund Reserves Policy - ARC 22.09.26","paper_url":"https://islington.moderngov.co.uk/documents/s48208/48208.pdf","headline":"The council's MTFS gap of \u00a3105.7m nearly equals its usable reserves of \u00a3104.9m, meaning reserves cannot solve the structural deficit.","detail":"The council faces a medium-term funding gap of \u00a3105.7m over five years. Its total usable reserves (Budget Risk, Core Funding, and General Balances) amount to \u00a3104.9m. The paper explicitly models that if this gap is not closed through recurrent savings and available Budget Risk reserves are required to balance the position, risk reserves would be exhausted before the 2029/30 budget could be agreed. This demonstrates that reserves provide resilience but cannot sustainably fund structural deficits.","category":"savings","matters":"A lender needs to know whether the council has a credible plan to close its structural gap or will rely on reserve depletion. Reserves nearly equal in size to the gap provide limited time to deliver savings without financial distress.","figures":"\u00a3105.7m MTFS gap; \u00a3104.9m usable reserves; reserves would be exhausted before 2029/30 in a do-nothing scenario","quote":"The council faces a reported MTFS gap of \u00a3105.7m. General Fund reserves provide resilience against budget risk but are not sufficient to fund structural budget gaps.","material":true},{"iso":"2026-09-22","committee":"Audit and Risk Committee","paper_title":"B2)VFM Report 22 Sept 26 CMT ARC (jc 040926)","paper_url":"https://islington.moderngov.co.uk/documents/s48205/48205.pdf","headline":"Financial sustainability assessment unchanged; no significant risks identified","detail":"The financial sustainability domain shows no change from 2024/25, remaining rated as no significant risks identified. The council's financial resilience has not deteriorated despite the governance and effectiveness risks identified elsewhere.","category":"other","matters":"Financial stability is foundational; an unchanged stable assessment indicates the council is not facing immediate solvency concerns despite the governance issues.","figures":"No significant risks in financial sustainability domain","quote":"There has been an indicative no change in the risk rating of (1) financial sustainability to \"no significant risks identified\" compared with 2024/25.","material":true},{"iso":"2026-09-22","committee":"Audit and Risk Committee","paper_title":"B2)VFM Report 22 Sept 26 CMT ARC (jc 040926)","paper_url":"https://islington.moderngov.co.uk/documents/s48205/48205.pdf","headline":"Effectiveness assessment downgraded; significant risk identified in housing compliance following regulation downgrade","detail":"The IEEE (improving economy, efficiency and effectiveness) assessment shows a downgrade with one significant risk identified: Consumer Regulation Downgrade and Housing Compliance Risks. The paper notes this is subject to further audit work.","category":"governance","matters":"Housing compliance failures trigger regulatory intervention by the housing regulator, cause service disruption, and damage council reputation.","figures":"1 significant risk in IEEE domain","quote":"(3) improving economy, efficiency and effectiveness (IEEE) criteria, with \"one significant risk identified.\" This is illustrated by a report extract and is subject to further audit work","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-15"},"name":"Islington","daily_post":{"iso":"2026-09-21","since_iso":"2026-08-22","distress":false,"headline":"Committee exploring acceleration of net zero target, with cost implications unknown.","lead":"Earlier target would require accelerated portfolio restructuring, likely creating material transition costs and potentially concentrating investment risk.","also":["2 other findings in this window"],"watch":"Environment, Climate and Transport Scrutiny Committee on 2026-09-21","n_findings":3,"n_documents":0,"top_paper_title":"pension net zero optionsept26","top_paper_url":"https://islington.moderngov.co.uk/documents/s48117/48117.pdf","draft":true},"findings_total":581,"news_drafts_total":3}}