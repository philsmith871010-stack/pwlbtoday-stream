ps://democratic.bridgend.gov.uk"},{"date":"2026-10-21","committee":"Council","time":"16:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-10-22","committee":"Corporate Overview and Scrutiny Committee","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-11-04","committee":"Cabinet Committee Equalities and Employee Relations","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-11-04","committee":"Town & Community Council Forum","time":"16:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-11-09","committee":"Social Services, Health and Wellbeing Overview and Scrutiny Committee (Formerly Subject Overview & Scrutiny Committee 2)","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-11-17","committee":"Cabinet","time":"14:30","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-11-18","committee":"Council","time":"16:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-11-19","committee":"Governance and Audit Committee","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-11-23","committee":"Education and Youth Services Overview and Scrutiny Committee (Formerly Subject Overview & Scrutiny Committee 1)","time":"11:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-12-07","committee":"Communities, Environment and Housing Overview and Scrutiny Committee (Formerly Subject Overview & Scrutiny Committee 3)","time":"16:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-12-10","committee":"Corporate Overview and Scrutiny Committee","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-12-15","committee":"Cabinet","time":"14:30","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk/ieListDocuments.aspx?CId=141&MId=5074"},{"date":"2026-12-16","committee":"Council","time":"16:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk/ieListDocuments.aspx?CId=142&MId=5086"}],"recent":[{"date":"2026-07-27","committee":"Corporate Overview and Scrutiny Committee","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-08-21","committee":"Corporate Overview and Scrutiny Committee","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk/ieListDocuments.aspx?CId=397&MId=5114"},{"date":"2026-09-02","committee":"Cabinet Committee Equalities and Employee Relations","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-09-07","committee":"Corporate Overview and Scrutiny Committee","time":"10:00","status":"Confirmed; Extraordinary Meeting of Corporate Overview and Scrutiny Committee","webcast":false,"url":"https://democratic.bridgend.gov.uk/ieListDocuments.aspx?CId=397&MId=5116"},{"date":"2026-09-10","committee":"Social Services, Health and Wellbeing Overview and Scrutiny Committee (Formerly Subject Overview & Scrutiny Committee 2)","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-09-21","committee":"Education and Youth Services Overview and Scrutiny Committee (Formerly Subject Overview & Scrutiny Committee 1)","time":"11:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-09-22","committee":"Cabinet","time":"14:30","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-09-23","committee":"Council","time":"16:00","status":"Confirmed; Remote Only","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-09-24","committee":"Governance and Audit Committee","time":"10:00","status":"Confirmed","webcast":false,"url":"https://democratic.bridgend.gov.uk"},{"date":"2026-09-25","committee":"Corporate Overview and Scrutiny Committee","time":"10:00","status":"Confirmed; Extraordinary Meeting of Corporate Overview and Scrutiny Committee (Hybrid)","webcast":false,"url":"https://democratic.bridgend.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Bridgend's 2025-26 accounts certified early, but audit found multiple errors in draft figures","lead":"Bridgend Council's external auditors are certifying the 2025-26 accounts on 25 September, six days ahead of the statutory 30 September deadline. The Governance and Audit Committee was told that auditors had identified a series of misstatements in the draft accounts, all later corrected by council officers. These included member allowances overstated by \u00a30.061 million, minimum revenue provision (the amount the council must set aside from each year's budget to repay past borrowing) understated by \u00a30.291 million, transactions from the South East Wales Corporate Joint Committee initially omitted, and property valuations that had not been updated. The auditor also flagged that indexation, the annual revaluation uplift applied to council property assets, has not been applied to a category of existing use value assets and could become cumulatively material over five years. The council's previous year accounts received a clean bill of health from auditors.","iso":"2026-09-24","paper_title":"Covering Report for Governance and Audit Committee Annual Report 2025-26","paper_url":"https://democratic.bridgend.gov.uk/documents/s38668/38668.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Bridgend accounts clear audit but required material corrections to draft figures","lead":"Bridgend Council's auditors gave the council an unqualified audit opinion \u2014 a clean bill of health \u2014 on its 2024/25 accounts. However, the draft accounts for 2025/26 required material corrections before certification, the Governance and Audit Committee heard. The initial draft omitted transactions and balances from the South East Wales Corporate Joint Committee, a material joint venture arrangement, which were added only in September's revised version. Auditors also identified that the council had understated its minimum revenue provision \u2014 the amount it must set aside each year to repay past borrowing \u2014 by \u00a30.291 million due to incorrect accounting treatment for the purchase of the Rhiw. Member allowances were overstated by \u00a30.061 million. All corrections were made by management before the auditor certified the accounts on 25 September, ahead of the statutory deadline.","iso":"2026-09-24","paper_title":"Covering Report for Governance and Audit Committee Annual Report 2025-26","paper_url":"https://democratic.bridgend.gov.uk/documents/s38668/38668.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Bridgend faces \u00a319.25m refinancing bill as lender raises rate on decades-old loans","lead":"Bridgend Council will repay \u00a319.25 million of bank loans after the lender exercised its right to increase the interest rate from 4.65 per cent to 7.52 per cent, effective 22 July 2026. Rather than accept the higher rate on the LOBO loans\u2014long-term borrowing where lenders may propose rate increases on set dates\u2014the council chose to repay at par and refinance. The repayment comes as the council faces a broader tightening of its financial position. Its underlying need to borrow, the amount it has spent on long-lived assets it has not yet paid for, is forecast to grow from \u00a3182.56 million to \u00a3200.82 million by March 2028 as capital commitments progress. The council is currently using \u00a369.97 million of its own cash reserves to fund capital spending instead of borrowing, a position the treasury report suggests cannot be sustained indefinitely as reserves deplete.","iso":"2026-09-22","paper_title":"Treasury Management Report Quarter 1 2026-27","paper_url":"https://democratic.bridgend.gov.uk/documents/s38639/38639.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-29","committee":"Governance and Audit Committee","paper_title":"Appendix B_BCBC_Audit_of_Accounts_Report_2025-26_Final","paper_url":"https://democratic.bridgend.gov.uk/documents/s38687/38687.pdf","headline":"Bridgend's draft Minimum Revenue Provision was understated by \u00a30.291 million relating to the Rhiw purchase, requiring correction during audit.","detail":"An error was identified in the MRP calculation relating to the accounting treatment for purchase of the Rhiw asset. The MRP was understated by \u00a30.291 million and corrected during audit. MRP is the mechanism councils use to ensure they set aside sufficient resources to repay borrowing as it falls due.","category":"capital","matters":"MRP controls are fundamental to a council's debt management; an understatement indicates potential pressure on capital financing resources or weaknesses in how capital transactions are accounted for.","figures":"\u00a30.291 million understatement corrected","quote":"Correction identified by the Council Minimum Revenue Provision (MRP) understated by \u00a30.291m due to the accounting treatment for the purchase of the Rhiw.","material":false},{"iso":"2026-09-29","committee":"Governance and Audit Committee","paper_title":"Appendix B_BCBC_Audit_of_Accounts_Report_2025-26_Final","paper_url":"https://democratic.bridgend.gov.uk/documents/s38687/38687.pdf","headline":"A category of asset valuations was not indexed as required, creating a control weakness that could become materially cumululative over five years.","detail":"The auditor identified that indexation had not been applied to a category of Existing Use Value (EUV) assets in the asset register. While the shortfall is not material in 2025-26, the auditor notes it could become cumulatively material over the five-year valuation cycle, indicating a persistent control gap in how assets are managed and valued.","category":"audit","matters":"A lender assesses whether a council's control environment reliably produces accurate financial information; undetected control failures that could compound over time pose incremental risk.","figures":"Value not specified as immaterial in current year but cumulative risk flagged over five-year cycle","quote":"We also identified that indexation had not been applied to a category of EUV assets. The value of these assets is not material to the accounts this year, but indexation could become cumulatively material over the five-year valuation cycle.","material":true},{"iso":"2026-09-29","committee":"Governance and Audit Committee","paper_title":"Appendix B_BCBC_Audit_of_Accounts_Report_2025-26_Final","paper_url":"https://democratic.bridgend.gov.uk/documents/s38687/38687.pdf","headline":"Bridgend's initial 2025-26 draft accounts omitted all South East Wales Corporate Joint Committee transactions and balances, which were added only in a revised September draft.","detail":"The first draft of the accounts completely failed to include SEW CJC transactions and balances. These were added to a revised draft provided in September based on draft SEW CJC accounts. The auditor found no misstatements once the transactions were included, but this represents a significant gap in the council's financial reporting control process.","category":"governance","matters":"A lender needs confidence in the completeness and accuracy of financial reporting controls; missing material transactions entirely from initial draft accounts indicates control weaknesses that could affect future reliability.","figures":"SEW CJC transactions are material but figure not specified in this report","quote":"The initial 2025-26 draft accounts did not include SEW CJC transactions and balances. These were added to the revised draft provided in September, based on the draft SEW CJC accounts.","material":true},{"iso":"2026-09-29","committee":"Governance and Audit Committee","paper_title":"Appendix B_BCBC_Audit_of_Accounts_Report_2025-26_Final","paper_url":"https://democratic.bridgend.gov.uk/documents/s38687/38687.pdf","headline":"Bridgend receives an unqualified audit opinion on its 2025-26 accounts.","detail":"The Auditor General for Wales intends to issue an unqualified audit opinion, confirming the accounts give a true and fair view and have been properly prepared in accordance with standards. No uncorrected misstatements above the reporting threshold remain.","category":"audit","matters":"A lender needs confidence that accounts comply with standards and present a reliable picture of the council's financial position.","figures":"Materiality set at \u00a35.941 million (1% of gross expenditure); reporting threshold \u00a30.297 million","quote":"We intend to issue an unqualified opinion on the accounts.","material":true},{"iso":"2026-09-24","committee":"Governance and Audit Committee","paper_title":"Appendix A - Governance Audit Committee Annual Report 2025-26","paper_url":"https://democratic.bridgend.gov.uk/documents/s38669/38669.pdf","headline":"Committee questioned whether council is incurring interest on borrowed funds that are not being spent.","detail":"During review of Treasury Management and Investment Strategy, the Governance and Audit Committee specifically asked whether the council has borrowed money for capital spending but left it unspent, thereby incurring interest costs without deploying the capital. The committee's note that treasury management was 'working well' suggests they received adequate reassurance, but the specific question raises capital execution efficiency as a topic of review.","category":"capital","matters":"Unutilized borrowing increases a council's debt burden and interest costs without delivering the planned capital assets or service improvements; poor capital execution efficiency matters to lenders assessing financial risk.","figures":"No specific amounts disclosed","quote":"whether the Council was borrowing money, and therefore paying interest, that was not being used","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-24"},"name":"Bridgend","daily_post":{"iso":"2026-09-28","since_iso":"2026-08-29","distress":false,"headline":"Committee questioned whether council is incurring interest on borrowed funds that are not being spent.","lead":"Unutilized borrowing increases a council's debt burden and interest costs without delivering the planned capital assets or service improvements; poor capital execution efficiency matters to lenders assessing financial risk.","also":["18 other findings in this window","11 papers caught"],"watch":"Governance and Audit Committee on 2026-09-29","n_findings":19,"n_documents":11,"top_paper_title":"Appendix A - Governance Audit Committee Annual Report 2025-26","top_paper_url":"https://democratic.bridgend.gov.uk/documents/s38669/38669.pdf","draft":true},"findings_total":102,"news_drafts_total":3}}