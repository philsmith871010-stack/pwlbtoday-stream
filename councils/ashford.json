"url":"http://ashford.moderngov.co.uk/documents/s32080/medium-term-financial-plan.pdf","type":"mtfs","type_label":"MTFS","weight":7,"committee":"Cabinet","meeting_id":4917,"meeting_date":"2025-11-13","published":"2025-11-05","filename":"E07000105-ashford-2025-11-13-cabinet-32080-medium-term-financial-plan.pdf"},{"id":34217,"title":"Annual Governance Statement - Covering","url":"http://ashford.moderngov.co.uk/documents/s34217/annual-governance-statement-covering.pdf","type":"ags","type_label":"Governance statement","weight":6,"committee":"Audit Committee","meeting_id":5111,"meeting_date":"2026-06-23","published":"2026-06-15","filename":"E07000105-ashford-2026-06-23-audit-committee-34217-annual-governance-statement-covering.pdf"},{"id":34218,"title":"Annual Governance Statement","url":"http://ashford.moderngov.co.uk/documents/s34218/annual-governance-statement.pdf","type":"ags","type_label":"Governance statement","weight":6,"committee":"Audit Committee","meeting_id":5111,"meeting_date":"2026-06-23","published":"2026-06-15","filename":"E07000105-ashford-2026-06-23-audit-committee-34218-annual-governance-statement.pdf"},{"id":31425,"title":"Financial Monitoring - Quarterly Report","url":"http://ashford.moderngov.co.uk/documents/s31425/financial-monitoring-quarterly-report.pdf","type":"monitoring","type_label":"Monitoring","weight":5,"committee":"Cabinet","meeting_id":4913,"meeting_date":"2025-07-31","published":"2025-07-23","filename":"E07000105-ashford-2025-07-31-cabinet-31425-financial-monitoring-quarterly-report.pdf"},{"id":32073,"title":"Financial Monitoring - Quarterly Report (General Fund)","url":"http://ashford.moderngov.co.uk/documents/s32073/financial-monitoring-quarterly-report-general-fund.pdf","type":"monitoring","type_label":"Monitoring","weight":5,"committee":"Cabinet","meeting_id":4917,"meeting_date":"2025-11-13","published":"2025-11-05","filename":"E07000105-ashford-2025-11-13-cabinet-32073-financial-monitoring-quarterly-report-ge.pdf"},{"id":32081,"titl