mocracy.salford.gov.uk/documents/s91533/mm-school-budgets-2026-27-cabinet-report.pdf","committee":"Cabinet","date":"10/03/2026","key":true},{"title":"Treasury Management Q3 update Report for 2025-26 OSB v4","url":"https://sccdemocracy.salford.gov.uk/documents/s91382/treasury-management-q3-update-report-for-2025-26-osb-v4.pdf","committee":"Overview and Scrutiny Board","date":"04/03/2026","key":true},{"title":"SCC statement of accounts 2024-25 final AA 250226 (1)","url":"https://sccdemocracy.salford.gov.uk/documents/s91183/scc-statement-of-accounts-2024-25-final-aa-250226-1.pdf","committee":"Audit and Accounts Committee","date":"25/02/2026","key":true},{"title":"07b Capital Strategy and Programme 2026-27 - 2028-29","url":"https://sccdemocracy.salford.gov.uk/documents/s91195/07b-capital-strategy-and-programme-2026-27-2028-29.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07bii Appx A ROD Capital Programme 2627 to 2829","url":"https://sccdemocracy.salford.gov.uk/documents/s91166/07bii-appx-a-rod-capital-programme-2627-to-2829.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07e MTFS 2627 to 2829","url":"https://sccdemocracy.salford.gov.uk/documents/s91198/07e-mtfs-2627-to-2829.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07 Summary of proposed Revenue Budget 2026-27","url":"https://sccdemocracy.salford.gov.uk/documents/s91191/07-summary-of-proposed-revenue-budget-2026-27.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07a Revenue Budget 2026-27","url":"https://sccdemocracy.salford.gov.uk/documents/s91194/07a-revenue-budget-2026-27.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07aii Appx A Record of Decision (Cabinet) - Proposed 2026-27 Revenue Budget","url":"https://sccdemocracy.salford.gov.uk/documents/s91167/07aii-appx-a-record-of-decision-cabinet-proposed-2026-27-rev.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07f SCC Budget 2026-27 - Conservative Group Amendment","url":"https://sccdemocracy.salford.gov.uk/documents/s91201/07f-scc-budget-2026-27-conservative-group-amendment.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07g SCC Budget 2026-27 - Liberal Democrat Group","url":"https://sccdemocracy.salford.gov.uk/documents/s91245/07g-scc-budget-2026-27-liberal-democrat-group.pdf","committee":"Council","date":"25/02/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-22","committee":"Cabinet","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-23","committee":"Audit and Accounts Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-23","committee":"Audit and Accounts Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-28","committee":"Growth & Prosperity Scrutiny Panel","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-07","committee":"Overview and Scrutiny Board","time":"2.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-07","committee":"Health and Adults Scrutiny Panel","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-13","committee":"Cabinet","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-14","committee":"Children's Scrutiny Panel","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"}],"recent":[{"date":"2026-09-02","committee":"Health and Adults Scrutiny Panel","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-08","committee":"Cabinet","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-09","committee":"Children's Scrutiny Panel","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-14","committee":"Community and Neighbourhoods Scrutiny Panel","time":"2.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-16","committee":"Council","time":"9.30 am","status":"Confirmed","webcast":true,"url":"https://sccdemocracy.salford.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Salford's cash reserves fall 32% as council relies more on internal borrowing","lead":"Salford's available investment balances fell from \u00a3106.2m to \u00a372.7m in the year to March 2026, a decline of nearly a third, while the council simultaneously increased its internal borrowing (using its own reserves to fund capital projects rather than taking loans) from \u00a3224.7m to \u00a3256.6m. The council attributes higher-than-forecast cash balances to slippage in its capital programme, with actual capital spending reaching only \u00a3103.9m against a forecast of \u00a3113.6m. The combination means the council is drawing down its liquidity cushion while depending more on its reserves to bridge the gap between planned spending and external borrowing. The council also holds \u00a3163m in LOBO loans, representing 59 per cent of its total external debt. During 2025-26, one lender exercised its option to propose a higher interest rate; the council declined multiple prepayment offers.\n\n---","iso":"2026-09-16","paper_title":"11 Treasury Management Annual Report 2025-26","paper_url":"https://salford.moderngov.co.uk/documents/s97038/97038.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-23","committee":"Audit and Accounts Committee","paper_title":"Internal Audit Quarterly Progress Report July to Sept 26","paper_url":"https://salford.moderngov.co.uk/documents/s97288/97288.pdf","headline":"Income generation scheme for scrap materials has control weaknesses at both council depots","detail":"Separate Limited assurance audits of scrap material income generation at SHR Depot and TP Depot each identified significant control weaknesses, with 1 high-priority action and 8-9 medium-priority actions at each site. This is an area where the council is attempting to generate revenue but controls are not robust.","category":"income","matters":"A lender financing the council needs to assess whether budgeted income from revenue-raising schemes is reliable. Limited assurance findings in an income generation function suggest planned income may not be achieved and proper controls over cash handling are not in place.","figures":"Two Limited assurance audits: SHR Depot (1 high, 9 medium, 1 low priority actions); TP Depot (1 high, 7 medium, 1 low priority actions); both issued 18 August 2026.","quote":"Scrap Materials (Income Generation) \u2013 SHRD Limited 1 9 1 Issued 18/08/26","material":true},{"iso":"2026-09-23","committee":"Audit and Accounts Committee","paper_title":"Internal Audit Quarterly Progress Report July to Sept 26","paper_url":"https://salford.moderngov.co.uk/documents/s97288/97288.pdf","headline":"Disabled Facilities Grant audit report delayed \u2013 action plan still in development and not yet finalised","detail":"Audit of Disabled Facilities Grant administration received Limited assurance with 4 high-priority and 7 medium-priority actions identified, but as of publication the report remains on hold with action plan still in development. This means audit findings have not yet been formally agreed or acted upon.","category":"audit","matters":"DFG is a ring-fenced grant funding housing adaptations for disabled people. An unfinalized Limited audit in this area means the control weaknesses have not yet been formally documented or agreement reached on remedial actions, which affects both grant delivery and council performance against statutory housing obligations.","figures":"Limited assurance; 4 high-priority, 7 medium-priority, 1 low-priority actions; report status as of publication: on hold pending return to council.","quote":"Disabled Facilities Grant Limited 4 7 1 Reporting (action plan in development pending return to the council)","material":true},{"iso":"2026-09-23","committee":"Audit and Accounts Committee","paper_title":"Internal Audit Quarterly Progress Report July to Sept 26","paper_url":"https://salford.moderngov.co.uk/documents/s97288/97288.pdf","headline":"Multiple Limited assurance reports on children's services financial administration with significant high-priority actions unresolved","detail":"Newcroft Children's Home received Limited assurance on financial administration with 3 high-priority actions (August 2026). Earlier in the audit cycle, Next Step Leaving Care had 16 high-priority actions from a Limited financial administration audit (December 2025). Moorside Primary School's nursery and extended hours facilities are subject to ongoing financial management audit. This pattern suggests systemic control weaknesses in how the council manages financial administration across children's settings.","category":"audit","matters":"Children's services represents a large budget area. Repeated Limited assurance findings in financial administration across different children's settings indicates the council may have systemic issues managing spending controls in this directorate, affecting both budget reliability and value-for-money.","figures":"Newcroft Children's Home: 3 high-priority actions; Next Step Leaving Care: 16 high-priority actions from Limited report (December 2025); Moorside Primary School draft report: 2 high-priority actions.","quote":"Newcroft Childrens Home (Financial Administration) Limited 3 0 0 Issued 11/08/26","material":true},{"iso":"2026-09-23","committee":"Audit and Accounts Committee","paper_title":"Internal Audit Quarterly Progress Report July to Sept 26","paper_url":"https://salford.moderngov.co.uk/documents/s97288/97288.pdf","headline":"Child Protection cash and safe procedures \u2013 high priority actions remain unimplemented after post-implementation review","detail":"A Limited assurance audit of cash handling in Child Protection was followed by a post-implementation review in April 2026, which found zero of five high-priority actions and zero of one medium-priority action had been implemented. This indicates no progress on remedying significant control weaknesses in a core safeguarding function six months after audit identification.","category":"audit","matters":"A finance director or lender would need to understand why a control weakness in Child Protection cash handling remains unaddressed. This indicates either resource constraints, organisational disruption, or deprioritisation of the improvement plan for a safeguarding control issue.","figures":"0 of 5 high-priority actions implemented; 0 of 1 medium-priority action implemented; post-implementation review issued 16 April 2026.","quote":"Cash & Safe (Child Protection) - PIR Limited* 0 of 5 0 of 1 0 of 0 Issued 16/04/26","material":true},{"iso":"2026-09-23","committee":"Audit and Accounts Committee","paper_title":"Internal Audit Quarterly Progress Report July to Sept 26","paper_url":"https://salford.moderngov.co.uk/documents/s97288/97288.pdf","headline":"Unusually high number of Limited assurance audits issued in the quarter across multiple service areas","detail":"Six audits received Limited assurance during the quarter, covering Construction Design and Management oversight, Newcroft Children's Home financial administration, Disabled Facilities Grant, and Scrap Materials income generation at two separate depots. The paper notes this is 'unusually higher' than normal, though qualifies that three were management-requested targeted reviews rather than full audits.","category":"audit","matters":"Multiple Limited assurance reports indicate significant control weaknesses across different areas. A lender financing council operations needs to understand whether these are isolated issues or reflect broader systemic problems with financial and operational controls.","figures":"6 Limited assurance reports issued in this quarter; together with reports from prior quarters still in progress, multiple service areas are flagged with significant control weaknesses.","quote":"whilst there is an unusually higher number of Limited assurance reports, three of these were in response to management concerns and relatively shorter / specific lines of enquiry. These are not indicative of wider systemic issues.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-16"},"name":"Salford","daily_post":{"iso":"2026-09-19","since_iso":"2026-08-20","distress":false,"headline":"\u00a3163m of LOBO debt carries refinancing risk; one loan exercised an option during the year and multiple prepayment offers were declined.","lead":"A lender needs to know that material debt (\u00a3163m) carries embedded refinancing risk; if rates rise unexpectedly, the council faces potential forced rate increases or repayment decisions.","also":["35 other findings in this window","2 papers caught"],"watch":"Cabinet on 2026-09-22","n_findings":36,"n_documents":2,"top_paper_title":"11 Treasury Management Annual Report 2025-26","top_paper_url":"https://salford.moderngov.co.uk/documents/s97038/97038.pdf","draft":true},"findings_total":116,"news_drafts_total":1}}