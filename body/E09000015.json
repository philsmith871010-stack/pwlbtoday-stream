lendar":{"upcoming":[{"date":"2026-09-24","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-30","committee":"Standing Advisory Council for Religious Education","time":"7.30 pm","status":"Confirmed","webcast":false,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-10-01","committee":"Council","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-10-15","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-10-22","committee":"Pension Board","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-11-04","committee":"Standing Advisory Council for Religious Education","time":"4.30 pm","status":"New; Moved from 30 Sep 2026","webcast":false,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-11-10","committee":"Overview and Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-11-12","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"}],"recent":[{"date":"2026-07-28","committee":"Performance and Finance Scrutiny Sub-Committee","time":"6.30 pm","status":"Postponed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-07-30","committee":"Pension Board","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-07","committee":"Pension Fund Committee","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-09","committee":"Planning Policy Advisory Panel","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-10","committee":"Overview and Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Sancroft Community Care recovering from temporary refurbishment disruption and returning to profitability while expanding bed capacity.","lead":"Shows operational recovery and capacity expansion aligned with local needs, though audit of prior year accounts is still pending and may reveal issues.","iso":"2026-09-24","paper_title":"Appendix 4 - Trading Company Update as at Quarter 1 2026-27","paper_url":"https://harrow.moderngov.co.uk/documents/s201856/201856.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Council is contingently liable for 50% of \u00a335m development partnership costs, with \u00a39.2m committed and 2026-27 business plan approvals delayed.","lead":"The Council carries a material contingent liability in a \u00a335m+ development partnership with undefined total scope, full exposure to future costs beyond the \u00a39.2m already recorded, and delayed governance controls.","iso":"2026-09-24","paper_title":"Appendix 4 - Trading Company Update as at Quarter 1 2026-27","paper_url":"https://harrow.moderngov.co.uk/documents/s201856/201856.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Concilium Assets LLP income fell 34% short of budget in 2025-26 due to strategic shift from commercial rental to social housing for homeless families.","lead":"The Council has redirected an asset away from commercial returns toward social provision, creating a significant forecast miss (34%) and embedding planned losses going forward, raising questions about budget discipline and forecasting accuracy.","iso":"2026-09-24","paper_title":"Appendix 4 - Trading Company Update as at Quarter 1 2026-27","paper_url":"https://harrow.moderngov.co.uk/documents/s201856/201856.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Appendix 4 - Trading Company Update as at Quarter 1 2026-27","paper_url":"https://harrow.moderngov.co.uk/documents/s201856/201856.pdf","headline":"Sancroft Community Care recovering from temporary refurbishment disruption and returning to profitability while expanding bed capacity.","detail":"Sancroft showed abnormally low performance in 2025-26 (\u00a3249,704 loss) due to rooms closure for refurbishment. With rooms reopening, 2026-27 is forecast to deliver a profit of \u00a322,705\u2014favourably exceeding the budgeted surplus of \u00a337,271 by \u00a314,566. The company has expanded block contracted bed capacity from 45 originally to 57 (27% increase, with a further 5-bed increase decided operationally in May 2026), and will take on more complex needs residents previously placed with private market providers. The 2025-26 financial accounts remain unaudited; audit is underway.","category":"demand","matters":"Shows operational recovery and capacity expansion aligned with local needs, though audit of prior year accounts is still pending and may reveal issues.","figures":"2025-26: loss of \u00a3249,704; 2026-27: profit forecast \u00a322,705 vs budget \u00a337,271; block beds expanded from 45 to 57","quote":"2025/26 financial performance was adversely affected by the rooms closure due to refurbishment works. As the rooms are coming back into use, income is forecast to the expected level for 2026/27.","material":false},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Appendix 4 - Trading Company Update as at Quarter 1 2026-27","paper_url":"https://harrow.moderngov.co.uk/documents/s201856/201856.pdf","headline":"Council is contingently liable for 50% of \u00a335m development partnership costs, with \u00a39.2m committed and 2026-27 business plan approvals delayed.","detail":"Harrow Strategic Development Partnership is a 50/50 joint venture with Wates Construction covering Poets Corner, Peel Road, Byron Quarter and Grange Farm developments. Total HSDP expenditure to 30 June 2026 is \u00a335.048m; of this \u00a316.636m relates to Milton Road (funded separately by HRA). The Council's contingent 50% share of the remaining \u00a318.412m is \u00a39.206m. The paper explicitly states the Council is in effect underwriting 50% of any HSDP expenditure incurred. Wates has cashflowed pre-construction costs to date, but finance costs (interest on Wates loan) have accumulated to \u00a33.458m. Critically, phase business plans for 2026-27 have not yet been approved, creating governance and visibility gaps.","category":"capital","matters":"The Council carries a material contingent liability in a \u00a335m+ development partnership with undefined total scope, full exposure to future costs beyond the \u00a39.2m already recorded, and delayed governance controls.","figures":"\u00a335.048m total expenditure to June 2026; \u00a318.412m non-HRA spend; \u00a39.206m Council liability (50%); \u00a33.458m finance costs accrued","quote":"As equal partner with Wates in this joint venture arrangement, the Council is responsible for 50% of any expenditure incurred within the HSDP, i.e. \u00a39.206m being the liability up to June 2026.","material":true},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Appendix 4 - Trading Company Update as at Quarter 1 2026-27","paper_url":"https://harrow.moderngov.co.uk/documents/s201856/201856.pdf","headline":"Concilium Assets LLP income fell 34% short of budget in 2025-26 due to strategic shift from commercial rental to social housing for homeless families.","detail":"Concilium Assets LLP operates 53 PRS units acquired to generate commercial rental income. In 2025 the Council decided to repurpose units for longer-term housing for homeless families via Assured Periodic Tenancies instead of private rental sector lettings. Actual income in 2025-26 was \u00a3405,483 against a business plan budget of \u00a3613k\u2014a shortfall of \u00a3208k. A net loss of \u00a3241k is budgeted for 2026-27 as a result of the PRSO implementation. The paper states the Council will benefit from cost reductions elsewhere in the budget for homelessness accommodation.","category":"income","matters":"The Council has redirected an asset away from commercial returns toward social provision, creating a significant forecast miss (34%) and embedding planned losses going forward, raising questions about budget discipline and forecasting accuracy.","figures":"\u00a3405,483 actual vs \u00a3613k budget (2025-26); \u00a3208k shortfall; \u00a3241k loss budgeted (2026-27)","quote":"Council received a total of \u00a3405,483 in 2025/26 for both lease rent and dividend. This is lower than the budgeted sum of \u00a3613k in the business plan due to the transition from PRS activity to using the units for offering longer-term housing to homeless families.","material":false},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"report - CTS","paper_url":"https://harrow.moderngov.co.uk/documents/s201872/201872.pdf","headline":"Council cannot isolate scheme impact from economic factors after one year; retaining scheme pending 2027/28 review","detail":"Council explicitly states it cannot determine with certainty whether scheme changes caused outcomes observed, as other factors including local and national economic circumstances may have influence. Findings based on single financial year; collection rates are evaluated over three-year period. Council recommends retaining current scheme for 2027/28 and conducting further review then.","category":"governance","matters":"Welfare restrictions lacking complete causal evidence of impact, pending longer evaluation, represents appropriate risk management. Uncertainty could matter if economic conditions deteriorate, requiring mid-course correction.","figures":"one financial year evaluated; collection rates measured over three years","quote":"The above findings are based upon a single financial year effect following changes made to the Council Tax Support Scheme in 2025/26 and it is therefore difficult to evaluate the financial effects of the scheme with precision, particularly as collection rates are evaluated over a three-year period.","material":true},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"report - CTS","paper_url":"https://harrow.moderngov.co.uk/documents/s201872/201872.pdf","headline":"72.8% of people who lost CTS eligibility in April 2025 remained up to date with Council Tax payments","detail":"671 claimants lost CTS eligibility from 1 April 2025. Sample review of 10% found 72.8% were up to date with payments, with remainder at various enforcement stages. Of those sampled, 9 had moved homes and 51 were maintaining current payments despite loss of support.","category":"demand","matters":"Positive counterbalance to enforcement escalation. Shows scheme changes, while reducing support to a vulnerable group, did not trigger widespread non-payment in the cohort most directly affected.","figures":"671 lost eligibility; 72.8% up to date in sample; 9 moved, 51 up to date","quote":"Based upon the sample reviewed, 72.8% of former CTS claimants were up to date with their Council Tax.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-07-30"},"name":"Harrow","findings_total":113,"news_drafts_total":3}}