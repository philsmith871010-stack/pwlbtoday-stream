0 pm","status":"Confirmed","webcast":false,"url":"https://bassetlaw.moderngov.co.uk"},{"date":"2026-11-17","committee":"Overview & Scrutiny Committee","time":"6.30 pm","status":"Confirmed; Extraordinary","webcast":false,"url":"https://bassetlaw.moderngov.co.uk"}],"recent":[{"date":"2026-07-16","committee":"Audit & Governance Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://bassetlaw.moderngov.co.uk"},{"date":"2026-07-28","committee":"Overview & Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://bassetlaw.moderngov.co.uk"},{"date":"2026-09-01","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://bassetlaw.moderngov.co.uk"},{"date":"2026-09-08","committee":"Company Governance Sub-Committee (of Cabinet)","time":"1.30 pm","status":"Confirmed","webcast":false,"url":"https://bassetlaw.moderngov.co.uk"},{"date":"2026-09-15","committee":"Overview & Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://bassetlaw.moderngov.co.uk"}]},"news":[],"news_drafts":[{"headline":"Cyber security controls remain incomplete; Incident Response Plan still being finalized","lead":"Cyber incidents could disrupt council operations, corrupt or expose financial data, and disrupt service delivery","iso":"2026-07-16","paper_title":"5c Appendix 1 - Draft Annual Governance Statement 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s17264/17264.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Procurement control weaknesses persist despite 2024/25 action marked complete; Partial Assurance audit rating issued","lead":"Procurement control failures affect value for money, fraud risk, and proper use of public funds; the issue persisting despite being marked resolved suggests either incomplete remediation or recurring problems","iso":"2026-07-16","paper_title":"5c Appendix 1 - Draft Annual Governance Statement 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s17264/17264.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Two of four audit follow-up reviews in 2024/25 showed poor or little progress on implementing prior recommendations","lead":"Non-implementation of audit recommendations indicates control gaps persist; weak follow-through on audit action plans is a red flag for governance quality","iso":"2026-07-16","paper_title":"5c Appendix 1 - Draft Annual Governance Statement 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s17264/17264.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-07-16","committee":"Audit & Governance Committee","paper_title":"5c Appendix 1 - Draft Annual Governance Statement 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s17264/17264.pdf","headline":"Cyber security controls remain incomplete; Incident Response Plan still being finalized","detail":"Despite progress on implementing prior recommendations from an advisory audit on IT Incident Management and Security, the council states \"the ever changing IT environment means that there is still work to be completed to manage the inherent risks.\" The Cyber Incident Response Plan is still being finalized for adoption by Corporate Leadership Team.","category":"governance","matters":"Cyber incidents could disrupt council operations, corrupt or expose financial data, and disrupt service delivery","figures":"No completion date given for Incident Response Plan; no timeline for completing cyber work","quote":"Although good progress has been made on implementing the recommendations that were made as part of an advisory audit on IT Incident Management and Security, the ever changing IT environment means that there is still work to be completed to manage the inherent risks.","material":true},{"iso":"2026-07-16","committee":"Audit & Governance Committee","paper_title":"5c Appendix 1 - Draft Annual Governance Statement 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s17264/17264.pdf","headline":"Procurement control weaknesses persist despite 2024/25 action marked complete; Partial Assurance audit rating issued","detail":"Procurement received a Partial Assurance internal audit rating in 2024/25 but the action was marked complete. Procurement remains a listed governance issue for 2025/26, with ongoing review work to assess compliance with Contract Procedure Rules and Procurement Act 2023, and management of the Welland Procurement Service Level Agreement.","category":"governance","matters":"Procurement control failures affect value for money, fraud risk, and proper use of public funds; the issue persisting despite being marked resolved suggests either incomplete remediation or recurring problems","figures":"Partial Assurance rating in 2024/25; continuing as active issue into 2025/26","quote":"Four Partial Assurance internal audit reports have been issued relating to the controls and processes in place during the 2024/25 financial year. These reports were in respect of Procurement, Landlord Licensing, Sickness Absence and Safeguarding.","material":true},{"iso":"2026-07-16","committee":"Audit & Governance Committee","paper_title":"5c Appendix 1 - Draft Annual Governance Statement 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s17264/17264.pdf","headline":"Two of four audit follow-up reviews in 2024/25 showed poor or little progress on implementing prior recommendations","detail":"Follow-up audits on implementation of 2024/25 recommendations resulted in \"two reasonable progress opinions (positive) one little progress (negative) opinion, and one poor progress (negative) opinion.\" The council has identified this as a 2025/26 governance issue, committing to strengthen arrangements for timely and effective implementation of audit recommendations through enhanced monitoring.","category":"audit","matters":"Non-implementation of audit recommendations indicates control gaps persist; weak follow-through on audit action plans is a red flag for governance quality","figures":"4 follow-up reviews: 2 reasonable progress, 1 little progress, 1 poor progress","quote":"We have performed four follow up reviews during the year to follow up all actions raised as part of the 2024/25 internal audit plan, which resulted in two reasonable progress opinions (positive) one little progress (negative) opinion, and one poor progress (negative) opinion.","material":true},{"iso":"2026-07-16","committee":"Audit & Governance Committee","paper_title":"5c Appendix 1 - Draft Annual Governance Statement 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s17264/17264.pdf","headline":"External audit identified weaknesses in management review processes for statutory financial reporting","detail":"External audit found insufficient management review processes in place to support preparation of draft financial statements. The council has committed to establish sufficient quality review procedures to ensure statutory financial reporting accurately reflects underlying transactions. This was the specific exception cited in the auditor's qualified governance opinion.","category":"audit","matters":"Financial statement reliability is foundational to lending decisions; external audit flagged this as a governance weakness requiring correction","figures":"External Auditor Value for Money opinion: \"Except for the matter relating to financial reporting\" the council's governance arrangements are adequate","quote":"A number of recommendations have been made by external audit to address weaknesses in the management review processes in respect of the Council's statutory reporting. These include sufficient review processes being established and put in place to support the preparation of draft financial statements to ensure sufficient quality review procedures are set up to support accurate statutory financial reporting that this is reflective of the underlying transactions.","material":true},{"iso":"2026-06-18","committee":"Council","paper_title":"4b - Appendix 1 - BDC Annual Treasury Management Review 2025-26","paper_url":"https://bassetlaw.moderngov.co.uk/documents/s16980/16980.pdf","headline":"Capital programme delivered \u00a332.6m against revised budget of \u00a394.6m\u2014a 65% underspend","detail":"Capital delivery was far below budget: General Fund \u00a317.4m of \u00a355.7m (69% miss); HRA \u00a315.2m of \u00a338.9m (61% miss). Despite revised budgets, neither fund had unfinanced capital expenditure, suggesting projects did not proceed rather than being financing-constrained.","category":"capital","matters":"Persistent large variances between budgeted and delivered capital indicate planning or execution challenges, not just one-off delays. A lender must assess whether capital strategies are realistic and whether the council has the capacity to deliver capital programmes.","figures":"Total capital expenditure: 2024-25 actual \u00a321.1m; 2025-26 revised budget \u00a394.6m; actual \u00a332.6m","quote":"Capital Expenditure TOTAL 21,083 94,650* 32,561","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-07-16"},"name":"Bassetlaw","findings_total":62,"news_drafts_total":3}}