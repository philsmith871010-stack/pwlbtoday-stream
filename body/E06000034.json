rrock.gov.uk/documents/s53073/statement-of-accounts-report-2025-26.pdf","committee":"Audit Committee","date":"30/06/2026","key":true},{"title":"Annual Governance Statement 2025-2026 cover report","url":"https://democracy.thurrock.gov.uk/documents/s53075/annual-governance-statement-2025-2026-cover-report.pdf","committee":"Audit Committee","date":"30/06/2026","key":true},{"title":"Thurrock Council's DRAFT 2025-26 Annual Governance Statement","url":"https://democracy.thurrock.gov.uk/documents/s53080/thurrock-council-s-draft-2025-26-annual-governance-statement.pdf","committee":"Audit Committee","date":"30/06/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-30","committee":"Council","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-10-05","committee":"Audit Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-10-07","committee":"Cabinet","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-10-08","committee":"Corporate Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-10-14","committee":"Standing Advisory Council on Religious Education","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-10-21","committee":"Council","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-10-22","committee":"Children's Services Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-11-05","committee":"Corporate Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed; Budget","webcast":true,"url":"https://democracy.thurrock.gov.uk"}],"recent":[{"date":"2026-09-10","committee":"Corporate Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-09-14","committee":"Audit Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-09-16","committee":"Cabinet","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-09-17","committee":"Adult and Health Services Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"},{"date":"2026-09-24","committee":"Place Overview and Scrutiny Committee","time":"7.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.thurrock.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Thurrock's budget depends on emergency government money as asset sales and building programmes slip.","lead":"Thurrock Council set a balanced 2026/27 budget only by assuming \u00a368.9m of exceptional financial support from government \u2014 money to cover treasury costs and operational deficit that the council cannot otherwise afford. This emergency backing reveals how deeply the authority depends on two promised routes to financial recovery: selling assets and delivering capital projects. Both are failing. The asset disposal programme is on track to raise only \u00a312.2m of a \u00a325.3m budget, a shortfall of 52%. The capital programme, after slipping \u00a387.5m (73% of budget) in 2025/26, is already forecasting a \u00a315.6m underspend (20% of budget) in the first quarter of the new year. Commissioners, who now oversee the council, have required stronger governance and stricter oversight on complex schemes. The council holds reserves to manage pressures but is drawing them down \u2014 \u00a317.9m planned for 2026/27 \u2014 rather than closing the underlying gap.","iso":"2026-09-16","paper_title":"Appendix 4 - Capital Budget Summary","paper_url":"https://thurrock.moderngov.co.uk/documents/s54455/54455.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Thurrock council's budget depends entirely on \u00a368.9m government emergency support","lead":"Thurrock council set its 2026/27 net budget of \u00a3267.3m on the assumption of \u00a368.9m of Exceptional Financial Support \u2013 a government permission to treat day-to-day spending as capital spending and pay for it through borrowing or asset sales. This represents almost a quarter of the council's total budget. The commissioners' report flagged this dependency as a sustained red risk, noting the council 'remains dependent upon Exceptional Financial Support and the Capitalisation Direction to achieve a balanced budget'. The underlying drivers include the council's inability to deliver capital projects: it underspent its 2025/26 capital budget by \u00a387.5m (73% of the revised total), and is now forecasting that 43 per cent of planned savings will not be achieved. The council is drawing down \u00a317.9m of earmarked reserves during the year to manage current pressures, principally in adult social care.","iso":"2026-09-16","paper_title":"Appendix 4 - Capital Budget Summary","paper_url":"https://thurrock.moderngov.co.uk/documents/s54455/54455.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Thurrock capital programme shows \u00a315.6m underspend in Q1 as commissioners flag risks","lead":"Thurrock Council's capital programme is forecast to underspend by \u00a315.6m (20% of its revised first-quarter budget) for 2026/27, repeating failures that prompted commissioners to demand stronger governance and oversight. The council underspent its 2025/26 capital budget by \u00a387.5m (73%). These capital challenges reflect wider financial pressures: the council's savings programme is 43% at risk, with \u00a36.4m of \u00a314.9m targets assessed as unachievable or at risk; Adult Social Care external placements are running \u00a314.4m over budget; and the council remains dependent on \u00a368.9m emergency support via capitalisation direction\u2014permission to finance day-to-day spending by borrowing\u2014to balance its budget.","iso":"2026-09-16","paper_title":"Appendix 4 - Capital Budget Summary","paper_url":"https://thurrock.moderngov.co.uk/documents/s54455/54455.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-16","committee":"Cabinet","paper_title":"Briefing Note - Corporate and Improvement Plan - 202526 Q4 and End of Year Performance Report and Annual Report - Corporate OS Comments","paper_url":"https://thurrock.moderngov.co.uk/documents/s54571/54571.pdf","headline":"Agency staffing indicators deteriorating despite improvements in permanent staff recruitment","detail":"The scrutiny committee noted a deterioration in the agency staff indicator. Members questioned whether vacancy savings are being offset by higher agency staff costs. Officers highlighted permanent staff improvements but did not directly address the agency cost concern, prompting the committee to request a detailed agency spend report for a future meeting.","category":"overspend","matters":"Agency staff typically costs 20-30% more than permanent equivalents; deteriorating indicators suggest cost pressures that may undermine savings from improved permanent recruitment","figures":"No figures provided in this document","quote":"Members queried slippage in divestments and capital investment, along with the deterioration in the agency staff indicator","material":true},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"Briefing Note - Corporate and Improvement Plan - 202526 Q4 and End of Year Performance Report and Annual Report - Corporate OS Comments","paper_url":"https://thurrock.moderngov.co.uk/documents/s54571/54571.pdf","headline":"Capital investment and asset divestment receipts have slipped due to legal processes and factors outside council control","detail":"Members queried slippage in both capital investment and divestments. Officers explained delays were due to legal processes and deferred receipts outside the council's control, noting that profiling such slippage across the financial year is not always possible.","category":"capital","matters":"Slippage in capital receipts and divestments directly impacts liquidity and funding plans; delays may impair the council's ability to fund planned investment or replace receipts with alternative funding","figures":"No figures provided in this document","quote":"Delays to divestments were attributed to legal processes and deferred receipts outside the Council's control. Profiling slippage across the year is not always possible.","material":true},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"Briefing Note - Corporate and Improvement Plan - 202526 Q4 and End of Year Performance Report and Annual Report - Corporate OS Comments","paper_url":"https://thurrock.moderngov.co.uk/documents/s54571/54571.pdf","headline":"Thurrock has moved from staffing crisis to stabilisation despite ongoing wage competition from London employers","detail":"Officers reported improvements in recruiting and retaining permanent staff through a strengthened senior structure and targeted recruitment. The briefing states that while councils in intervention often face significant recruitment challenges, Thurrock has moved from crisis to stabilisation. However, staff turnover continues due to wage competition from London employers offering higher market rates.","category":"people","matters":"Staffing stability and cost control are essential to financial sustainability; recovery from crisis in a critical area indicates improving operational management and service resilience","figures":"No figures provided in this document","quote":"While councils in intervention often face significant recruitment challenges, Thurrock has moved from a position of crisis to one of stabilisation.","material":true},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"Appendix 3 - Revenue Reserves 2026-27","paper_url":"https://thurrock.moderngov.co.uk/documents/s54454/54454.pdf","headline":"Council is divesting from its investment portfolio and incurring \u00a31.878m in legal costs to do so.","detail":"The Treasury Equalisation Reserve is being drawn down by \u00a31.878m from an opening balance of \u00a36.537m, with this entire drawdown attributed to legal costs of divesting the council's investments. The paper does not explain why the council is exiting its investment portfolio. This represents a material decision to liquidate investments, incurring significant professional fees.","category":"other","matters":"Material investment divestment could indicate either a strategic treasury repositioning or liquidity pressures requiring asset liquidation. For a lender evaluating the council's financial resilience and treasury capacity, this shift warrants investigation into whether it reflects deliberate strategy or financial constraint.","figures":"\u00a31.878m drawn from \u00a36.537m opening balance for divestment legal costs; forecast balance \u00a34.659m.","quote":"Funding for Legal costs associated with Divestment of the Council's investments","material":true},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"Appendix 3 - Revenue Reserves 2026-27","paper_url":"https://thurrock.moderngov.co.uk/documents/s54454/54454.pdf","headline":"Adult Social Care reserves being heavily drawn down (\u00a39.578m), including a new demographic pressure reserve created in December 2024 that is now entirely exhausted.","detail":"The council created an Adult Social Care reserve in December 2024 to fund 'ASC/CS demographic pressures' with an opening balance of \u00a31.500m. This entire reserve is being drawn down in 2026-27. Additionally, the Adult Social Care & Health section is drawing down \u00a38.078m from other established ASC reserves: Better Care Fund (\u00a35.772m), Market Sustainability Funding (\u00a30.693m), ASC - Health integration funding (\u00a31.204m), Adults safeguarding reserve (\u00a30.400m), and ASC grants (\u00a30.009m). This substantial drawdown suggests demographic cost pressures are materialising faster than anticipated.","category":"demand","matters":"Adult Social Care is a major service facing demographic pressures from an ageing population. The rapid exhaustion of a reserve created specifically for these pressures just months after establishment signals that ASC cost growth is acute and may force the council to increase levies, reduce services, or seek additional borrowing.","figures":"ASC demographic reserve created Dec 2024 with \u00a31.500m: entirely drawn down. Better Care Fund \u00a35.772m drawn; Market Sustainability \u00a30.693m; ASC-Health integration \u00a31.204m; Adults safeguarding \u00a30.400m. Total ASC drawdown \u00a39.578m from starting balance of \u00a317.205m.","quote":"New Reserve created for ASC/CS demographic pressures as agreed at December 2024 Cabinet","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-16"},"name":"Thurrock UA","daily_post":{"iso":"2026-09-26","since_iso":"2026-08-27","distress":true,"headline":"Agency staffing indicators deteriorating despite improvements in permanent staff recruitment","lead":"Agency staff typically costs 20-30% more than permanent equivalents; deteriorating indicators suggest cost pressures that may undermine savings from improved permanent recruitment","also":["118 other findings in this window","9 papers caught"],"watch":"Audit Committee on 2026-10-05","n_findings":119,"n_documents":9,"top_paper_title":"Briefing Note - Corporate and Improvement Plan - 202526 Q4 and End of Year Performance Report and Annual Report - Corporate OS Comments","top_paper_url":"https://thurrock.moderngov.co.uk/documents/s54571/54571.pdf","draft":true},"findings_total":174,"news_drafts_total":3}}