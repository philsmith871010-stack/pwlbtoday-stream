_date":"2025-07-15","published":"2025-07-07","filename":"E07000008-cambridge-2025-07-15-cabinet-69664-item-10-20250715-cabinet-report-budget-s.pdf"},{"id":70084,"title":"Item 10. 20250715 Cabinet - REPORT - Budget Setting Context 2026-27, 15/07/2025 Cabinet","url":"https://democracy.cambridge.gov.uk/documents/s70084/item-10-20250715-cabinet-report-budget-setting-context-2026.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Performance, Assets and Strategy Overview and Scrutiny Committee","meeting_id":4641,"meeting_date":"2025-09-09","published":"2025-09-01","filename":"E07000008-cambridge-2025-09-09-performance-assets-and-str-70084-item-10-20250715-cabinet-report-budget-s.pdf"},{"id":71622,"title":"Budget Setting Report 2026-27 with Appendices","url":"https://democracy.cambridge.gov.uk/documents/s71622/budget-setting-report-2026-27-with-appendices.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Performance, Assets and Strategy Overview and Scrutiny Committee","meeting_id":4643,"meeting_date":"2026-01-27","published":"2026-01-19","filename":"E07000008-cambridge-2026-01-27-performance-assets-and-str-71622-budget-setting-report-2026-27-with-appen.pdf"},{"id":71664,"title":"Supplementary for Budget","url":"https://democracy.cambridge.gov.uk/documents/s71664/supplementary-for-budget.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Performance, Assets and Strategy Overview and Scrutiny Committee","meeting_id":4643,"meeting_date":"2026-01-27","published":"2026-01-19","filename":"E07000008-cambridge-2026-01-27-performance-assets-and-str-71664-supplementary-for-budget.pdf"},{"id":71636,"title":"5. HRA Budget (Coversheet)","url":"https://democracy.cambridge.gov.uk/documents/s71636/5-hra-budget-coversheet.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Housing Advisory Board","meeting_id":4650,"meeting_date":"2026-02-02","published":"2026-01-23","filename":"E07000008-cambridge-2026-02-02-housing-advisory-board-71636-5-hra-budget-coversheet.pdf"},{"id":71637,"title":"5. HRA Budget 2026","url":"https://democracy.cambridge.gov.uk/documents/s71637/5-hra-budget-2026.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Housing Advisory Board","meeting_id":4650,"meeting_date":"2026-02-02","published":"2026-01-23","filename":"E07000008-cambridge-2026-02-02-housing-advisory-board-71637-5-hra-budget-2026.pdf"},{"id":71728,"title":"Budget Setting Report 2026-27 with Appendices","url":"https://democracy.cambridge.gov.uk/documents/s71728/budget-setting-report-2026-27-with-appendices.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Cabinet","meeting_id":4637,"meeting_date":"2026-02-10","published":"2026-02-02","filename":"E07000008-cambridge-2026-02-10-cabinet-71728-budget-setting-report-2026-27-with-appen.pdf"},{"id":71882,"title":"Budget Setting Report 2026-27 with Appendices (1)","url":"https://democracy.cambridge.gov.uk/documents/s71882/budget-setting-report-2026-27-with-appendices-1.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Council","meeting_id":4628,"meeting_date":"2026-02-26","published":"2026-02-18","filename":"E07000008-cambridge-2026-02-26-council-71882-budget-setting-report-2026-27-with-appen.pdf"},{"id":72244,"title":"Liberal Democrat Request for separate votes on Budget Setting report","url":"https://democracy.cambridge.gov.uk/documents/s72244/liberal-democrat-request-for-separate-votes-on-budget-settin.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Council","meeting_id":4628,"meeting_date":"2026-02-26","published":"2026-02-18","filename":"E07000008-cambridge-2026-02-26-council-72244-liberal-democrat-request-for-separate-vo.pdf"},{"id":73068,"title":"Budget Setting Context 2027-28","url":"https://democracy.cambridge.gov.uk/documents/s73068/budget-setting-context-2027-28.pdf","type":"budget","type_label":"Budget","weight":3,"committee":"Cabinet","meeting_id":4827,"meeting_date":"2026-07-07","published":"2026-06-29","filename":"E07000008-cambridge-2026-07-07-cabinet-73068-budget-setting-context-2027-28.pdf"}],"notes":{"gss":"E07000008","schema":2,"council":"Cambridge","facts":[{"key":"cfr","value":"not stated \u2014 the covering report carries no treasury figures at all","as_at":"2025-03-31","source":{"title":"Statement of Accounts 2024/25 (covering report) \u2014 Civic Affairs and Audit Committee, 23 February 2026","url":"https://democracy.cambridge.gov.uk/documents/s71847/statement-of-accounts-2024-25.pdf","doc_id":71847,"text":"papers/E07000008/71847.txt"},"note":"Everything sits in Appendix 1 (the Statement of Accounts itself) and Appendix 2 (the EY Audit Results Report), neither of which we hold. NO RECONCILIATION POSSIBLE."},{"key":"external_debt","value":"not stated in the covering report","as_at":"2025-03-31","source":{"title":"Statement of Accounts 2024/25 (covering report) \u2014 Civic Affairs and Audit Committee, 23 February 2026","url":"https://democracy.cambridge.gov.uk/documents/s71847/statement-of-accounts-2024-25.pdf","doc_id":71847,"text":"papers/E07000008/71847.txt"},"note":"5.7 refers to 'internal borrowing, which avoids the cost of interest on external borrowing' \u2014 an under-borrowing stance, but no figure."},{"key":"interest_income","value":"\u00a35.9m (2023/24: \u00a37.8m)","as_at":"2024/25","source":{"title":"Statement of Accounts 2024/25 (covering report), paragraph 5.7","url":"https://democracy.cambridge.gov.uk/documents/s71847/statement-of-accounts-2024-25.pdf","doc_id":71847,"text":"papers/E07000008/71847.txt","page":4},"note":"Explained as: reduction in interest rates and use of surplus cash to finance the capital programme through internal borrowing."},{"key":"usable_reserves","value":"\u00a3116m","as_at":"2025-03-31","source":{"title":"Statement of Accounts 2024/25 (covering report), paragraph 5.2","url":"https://democracy.cambridge.gov.uk/documents/s71847/statement-of-accounts-2024-25.pdf","doc_id":71847,"text":"papers/E07000008/71847.txt","page":3},"note":"Down \u00a31.5m on the year."},{"key":"total_net_assets","value":"\u00a31,060.6m","as_at":"2025-03-31","source":{"title":"Statement of Accounts 2024/25 (covering report), paragraph 5.8","url":"https://democracy.cambridge.gov.uk/documents/s71847/statement-of-accounts-2024-25.pdf","doc_id":71847,"text":"papers/E07000008/71847.txt","page":4},"note":"Down \u00a346.6m."},{"key":"audit_opinion","value":"disclaimed (proposed) \u2014 sector 'reset and recovery'","as_at":"2024/25","source":{"title":"Statement of Accounts 2024/25 (covering report), paragraphs 4.1, 7.2","url":"https://democracy.cambridge.gov.uk/documents/s71847/statement-of-accounts-2024-25.pdf","doc_id":71847,"text":"papers/E07000008/71847.txt","page":5},"note":"Second disclaimed year in a row, anticipated by the assurance build-back process."}],"signals":[{"code":"audit-delay","headline":"Second disclaimed opinion in a row on 2024/25 accounts, plus a new VFM significant weakness on finance-team capacity (7.5)","why_it_matters":"Backstop met (27 February 2026), and the two 2023/24 VFM weaknesses are cleared, but the finance team was 'not back to full strength until January 2026' (4.5) and the new weakness reflects that. This is a sector-wide 'reset and recovery' pattern, not a Cambridge-specific solvency signal."}],"threads":[],"meetings":{},"summary":{"written":"15 August 2026","text":"<p>A short covering report on the Statement of Accounts 2024/25 with <b>no treasury figures at all</b>. Everything a treasury reader would want &mdash; CFR, external borrowing, PWLB loan book, maturity profile, weighted rate, prudential indicators, liability benchmark &mdash; sits in Appendix 1 (the Statement of Accounts itself) and Appendix 2 (EY's Audit Results Report), neither of which is held. Nothing about Cambridge's PWLB position may be asserted from this paper.</p><p>What the covering report does say: usable reserves \u00a3116m at 31 March 2025 (down \u00a31.5m); total net assets \u00a31,060.6m (down \u00a346.6m); interest income \u00a35.9m (down from \u00a37.8m), explained by lower rates and by using surplus cash to fund capital 'through internal borrowing, which avoids the cost of interest on external borrowing' (5.7) &mdash; an explicit under-borrowing stance, but no number. EY are issuing a second disclaimed opinion in a row as part of the sector-wide 'reset and recovery' process; the two 2023/24 VFM weaknesses are cleared and one new one added on finance-team capacity, tied to staff turnover (4.5).</p><p>Our loan file holds 20 PWLB MATURITY loans totalling \u00a3213,572,000 at a weighted 3.51% &mdash; the fingerprint of the 28 March 2012 HRA self-financing settlement (20 &times; \u00a310.6786m, maturity ladder 2038-2057). The Start-field on every row is 2026-03-28, which is the known bc-loans drift documented in the pipeline notes; the loans are the 2012 originals. None of that goes in an email, because there is no printed Cambridge figure to reconcile it against. <b>No draft written &mdash; fetch Appendix 1 before anything is sent.</b></p>"},"courses":{"scored":false,"read":[],"text_held":true},"contacts":[{"name":"Matthew Fernandez-Graham","role":"Head of Finance (report author on this covering report)","email":"matthew.fernandezgraham@cambridge.gov.uk","phone":"01223 458134","note":"Named on page 1 of the covering report. NOT the Section 151 Officer of record. Recommendation 3 delegates authority to 'the Chief Finance Officer' (S151) without naming them. Do not put Matthew on an S151 line."},{"role":"Chief Finance Officer (Section 151 Officer)","note":"Referred to in recommendation 3 but not named in this covering report. Do not guess."},{"name":"Jody Etherington","role":"Director (Director Approval on page 1)","note":"Director sign-off only; not the S151."}],"status":{"state":"read-thin","written_up":true,"contact":false,"as_at":"15 August 2026","source_text_held":true,"note":"Covering report only. Appendix 1 (Statement of Accounts) and Appendix 2 (EY Audit Results Report) hold every treasury figure and neither is held. No email drafted \u2014 there is nothing to write about that would land with an S151. Fetch Appendix 1 before drafting."},"emails":{}}}