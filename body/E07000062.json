.moderngov.co.uk/documents/s58416/2026-27-budget-appendices-v1-3.pdf","committee":"Full Council","date":"11/02/2026","key":true},{"title":"Cabinet Budget Report 2026-27 v2.1","url":"http://hastings.moderngov.co.uk/documents/s58279/cabinet-budget-report-2026-27-v2-1.pdf","committee":"Cabinet","date":"02/02/2026","key":true},{"title":"2026-27 Budget Appendices - Cabinet","url":"http://hastings.moderngov.co.uk/documents/s58281/2026-27-budget-appendices-cabinet.pdf","committee":"Cabinet","date":"02/02/2026","key":true},{"title":"Reserves Policy 2026-27 v1.1","url":"http://hastings.moderngov.co.uk/documents/s58200/reserves-policy-2026-27-v1-1.pdf","committee":"Overview and Scrutiny Committee","date":"21/01/2026","key":true},{"title":"O&S Budget Report 2026-27 v1.3","url":"http://hastings.moderngov.co.uk/documents/s58196/o-s-budget-report-2026-27-v1-3.pdf","committee":"Overview and Scrutiny Committee","date":"21/01/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-23","committee":"Full Council","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-11-02","committee":"Cabinet","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-11-18","committee":"Full Council","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-12-02","committee":"Overview and Scrutiny Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-12-10","committee":"Audit Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"}],"recent":[{"date":"2026-07-15","committee":"Full Council","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-07-20","committee":"Overview and Scrutiny Committee","time":"6.00 pm","status":"Confirmed; Annual","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-09-02","committee":"Overview and Scrutiny Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-09-07","committee":"Cabinet","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"},{"date":"2026-09-10","committee":"Audit Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://hastings.moderngov.co.uk"}]},"news":[],"news_drafts":[{"headline":"Hastings Council reschedules \u00a311m debt for \u00a32.3m lifetime savings","lead":"Hastings Council has identified \u00a32.3 million in lifetime savings by refinancing six loans worth \u00a311 million, the Full Council heard on Wednesday. The council will take advantage of early repayment discounts worth \u00a35 million to reduce replacement funding to less than \u00a36 million, generating annual savings of around \u00a3515,000 in the first two years. The Treasury Management Update reported an additional \u00a32.9 million net present value benefit from the restructuring. The move is part of efforts to strengthen financial resilience ahead of Local Government Reorganisation in April 2028. The council's longer-term pooled fund investments, meanwhile, have declined by approximately \u00a3562,000 from their initial cost, though the funds continue to generate dividend income of nearly 5 per cent and 3 per cent respectively.","iso":"2026-09-23","paper_title":"1. Treasury Management Update 2026-27 Q1","paper_url":"https://hastings.moderngov.co.uk/documents/s60019/60019.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-23","committee":"Full Council","paper_title":"1. Treasury Management Update 2026-27 Q1","paper_url":"https://hastings.moderngov.co.uk/documents/s60019/60019.pdf","headline":"CCLA pooled fund investments have declined by approximately \u00a3562,000 from initial cost","detail":"The council's longer-term pooled investments held with CCLA show significant mark-to-market depreciation. The Property Fund is now worth \u00a31.788 million, down 10.60% from \u00a32.0 million invested. The Better World Cautious Fund is worth \u00a32.649 million, down 11.69% from \u00a33.0 million invested. Though funds continue generating dividend income (4.71% and 2.87% yields), the unrealised losses reduce balance sheet asset values.","category":"reserves","matters":"Deterioration in investment asset values reduces financial resilience and reflects market stress in the council's longer-term portfolio; material if forced to liquidate","figures":"Property Fund: \u00a3211,920 loss (10.60% of \u00a32.0m); Better World Cautious Fund: \u00a3350,533 loss (11.69% of \u00a33.0m); total unrealised loss ~\u00a3562,000","quote":"The value of the Property Fund as 30 June 2026 was \u00a31,788,079. This is \u00a3211,920 (10.60%) below the initial investment amount of \u00a32,000,000.","material":true},{"iso":"2026-09-23","committee":"Full Council","paper_title":"1. Treasury Management Update 2026-27 Q1","paper_url":"https://hastings.moderngov.co.uk/documents/s60019/60019.pdf","headline":"Council identified \u00a32.3 million lifetime savings through rescheduling six PWLB loans worth \u00a311 million","detail":"Six existing PWLB loans totalling \u00a311.0 million at 2.484% average coupon can be refinanced by taking a 5.57% early repayment discount of \u00a35.048 million. Less than \u00a36 million replacement funding extinguishes the \u00a311 million debt. The restructuring generates \u00a32.311 million lifetime cash savings and \u00a32.862 million NPV benefit, with \u00a3515,000 annual savings in years 1 and 2. The proposal strengthens financial resilience ahead of Local Government Reorganisation in April 2028.","category":"borrowing","matters":"Material financial improvement in the council's position during a period of budget pressures and immediately before merger into a unitary authority, showing proactive debt management","figures":"\u00a311.0m outstanding debt; 2.484% average coupon; \u00a35.048m early repayment discount; <\u00a36.0m replacement funding; \u00a32.311m lifetime savings; \u00a32.862m NPV benefit; ~\u00a3515k annual savings years 1\u20132","quote":"The Council has identified an opportunity to reschedule six loans totalling \u00a311.0 million, taking advantage of favourable market conditions and a \u00a35.048 million early repayment discount to reduce replacement funding to less than \u00a36.0 million. The proposal is expected to generate lifetime savings of \u00a32.311 million and an NPV benefit of \u00a32.862 million","material":true},{"iso":"2026-09-10","committee":"Audit Committee","paper_title":"1. Treasury Management Update 2026-27 Q1","paper_url":"https://hastings.moderngov.co.uk/documents/s59925/59925.pdf","headline":"All assets and borrowing liabilities transferring to East Sussex unitary authority from 1 April 2028","detail":"Six East Sussex councils including Hastings will be replaced by single unitary authority from 1 April 2028. Government proposals indicate all assets, liabilities, reserves, borrowing and treasury obligations will transfer to successor authority. Final structure and implementation arrangements currently being finalised. Proposed debt rescheduling positioned to improve financial position transferred to new authority, with benefit of front-loaded savings (\u00a3515k per annum years 1-2) realised during transition period.","category":"governance","matters":"Structural change creates fixed 19-month window for financial optimisation; lenders must understand council will cease to exist and all borrowing obligations transfer; timing of refinancing opportunity specifically aligned to strengthen inherited position.","figures":"1 April 2028 vesting date for unitary authority","quote":"Under current Government proposals, the existing six East Sussex councils are expected to be replaced by a new unitary authority from 1 April 2028. Whilst the final structure and implementation arrangements are currently being finalised, it is anticipated that all assets, liabilities, reserves, borrowing, and treasury management obligations will transfer to the successor authority.","material":true},{"iso":"2026-09-10","committee":"Audit Committee","paper_title":"1. Treasury Management Update 2026-27 Q1","paper_url":"https://hastings.moderngov.co.uk/documents/s59925/59925.pdf","headline":"CCLA property investments marked down 10.6% and 11.7% respectively","detail":"Council holds longer-term strategic investments with CCLA: Property Fund valued at \u00a31.788m (down from \u00a32m initial investment) and Better World Cautious Fund at \u00a32.649m (down from \u00a33m initial investment). Total unrealised loss approximately \u00a3562k. Properties continue to generate dividend yields of 4.71% and 2.87% respectively. Losses reflect market valuations as at 30 June 2026.","category":"reserves","matters":"Material reduction in strategic investment reserves available for deployment; identifies cash buffer weaker than headline figures; however positive ongoing yields suggest assets continue income-generating function despite losses.","figures":"Property Fund: \u00a32,000,000 initial \u2192 \u00a31,788,079 current (loss \u00a3211,920 or 10.60%), Better World Cautious Fund: \u00a33,000,000 initial \u2192 \u00a32,649,446 current (loss \u00a3350,533 or 11.69%), dividend yields 4.71% and 2.87%","quote":"The value of the Property Fund as 30 June 2026 was \u00a31,788,079. This is \u00a3211,920 (10.60%) below the initial investment amount of \u00a32,000,000. The value of the Better World Cautious Fund as 30 June 2026 was \u00a32,649,446. This is \u00a3350,533 (11.69%) below the initial investment amount of \u00a33,000,000.","material":true},{"iso":"2026-09-10","committee":"Audit Committee","paper_title":"1. Treasury Management Update 2026-27 Q1","paper_url":"https://hastings.moderngov.co.uk/documents/s59925/59925.pdf","headline":"Council anticipates \u00a315.9m external borrowing requirement for 2026/27 capital programme","detail":"Q1 report forecasts borrowing of \u00a315.9m will be required during financial year to fund capital programme expenditure. Actual requirement depends on capital programme progress, capital receipts from asset sales, and availability of cash balances for internal borrowing. Current external debt stands at \u00a362.2m from 20 PWLB loans. Borrowing to be undertaken at 'most advantageous time' having regard to market conditions.","category":"capital","matters":"Material quantum of new borrowing signals significant capital investment plans; quantum relative to existing \u00a362.2m debt base and \u00a3135m authorised limit shows headroom, but signals ongoing reliance on external funding.","figures":"\u00a315.9 million anticipated borrowing, \u00a362.2 million existing external debt, \u00a3135 million authorised borrowing limit, 20 existing PWLB loans at average rate 2.82%","quote":"It is anticipated that borrowing of \u00a315.9m will be required this financial year to fund expenditure on the capital programme. This figure is however dependant on progress made on the capital programme, any capital receipts received within the year from asset sales and the availability of cashflows and reserve balances to facilitate internal borrowing.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-23"},"name":"Hastings","daily_post":{"iso":"2026-09-23","since_iso":"2026-08-24","distress":false,"headline":"CCLA pooled fund investments have declined by approximately \u00a3562,000 from initial cost","lead":"Deterioration in investment asset values reduces financial resilience and reflects market stress in the council's longer-term portfolio; material if forced to liquidate","also":["18 other findings in this window"],"watch":"Full Council on 2026-09-23","n_findings":19,"n_documents":0,"top_paper_title":"1. Treasury Management Update 2026-27 Q1","top_paper_url":"https://hastings.moderngov.co.uk/documents/s60019/60019.pdf","draft":true},"findings_total":95,"news_drafts_total":1}}