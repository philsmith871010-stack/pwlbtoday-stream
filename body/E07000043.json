lse},{"title":"Annual Treasury Management Report 2025/26","url":"https://democracy.northdevon.gov.uk/documents/s38224/annual-treasury-management-report-2025-26.pdf","committee":"Council","date":"22/07/2026","key":true},{"title":"2026.07.13 - Minute extract of S&PD - Annual Treasury Management","url":"https://democracy.northdevon.gov.uk/documents/s38336/2026-07-13-minute-extract-of-s-pd-annual-treasury-management.pdf","committee":"Council","date":"22/07/2026","key":true},{"title":"2026.07.13 - Item 16(b) Minute extract of S&R - Annual Treasury Management (final)","url":"https://democracy.northdevon.gov.uk/documents/s38395/2026-07-13-item-16-b-minute-extract-of-s-r-annual-treasury-m.pdf","committee":"Council","date":"22/07/2026","key":true},{"title":"Annual Treasury Management Report 2025/26","url":"https://democracy.northdevon.gov.uk/documents/s38162/annual-treasury-management-report-2025-26.pdf","committee":"Strategy and Resources Committee","date":"13/07/2026","key":true},{"title":"Item 9 Annual Treasury Management Report 2025-26 - Minute Extract of Scrutiny and Policy Developement Committee","url":"https://democracy.northdevon.gov.uk/documents/s38313/item-9-annual-treasury-management-report-2025-26-minute-extr.pdf","committee":"Strategy and Resources Committee","date":"13/07/2026","key":true},{"title":"Annual Treasury Management Report 2025/26","url":"https://democracy.northdevon.gov.uk/documents/s38160/annual-treasury-management-report-2025-26.pdf","committee":"Scrutiny and Policy Development Committee","date":"02/07/2026","key":true},{"title":"Draft Annual Governance Statement","url":"https://democracy.northdevon.gov.uk/documents/s37017/draft-annual-governance-statement.pdf","committee":"Governance Committee","date":"16/06/2026","key":true},{"title":"Appendix A Draft Annual Governance Statement","url":"https://democracy.northdevon.gov.uk/documents/s37018/appendix-a-draft-annual-governance-statement.pdf","committee":"Governance Committee","date":"16/06/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-10-08","committee":"Scrutiny and Policy Development Committee","time":"6.15 pm","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-10-19","committee":"Strategy and Resources Committee","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-10-23","committee":"Joint Planning Policy Committee","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-11-05","committee":"Scrutiny and Policy Development Committee","time":"6.15 pm","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-11-10","committee":"Governance Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-11-16","committee":"Strategy and Resources Committee","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"}],"recent":[{"date":"2026-08-06","committee":"Scrutiny and Policy Development Committee","time":"6.15 pm","status":"Cancelled; Reserved Date","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-09-03","committee":"Scrutiny and Policy Development Committee","time":"6.15 pm","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-09-14","committee":"Strategy and Resources Committee","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-09-15","committee":"Governance Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"},{"date":"2026-09-23","committee":"Council","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.northdevon.gov.uk"}]},"news":[],"news_drafts":[{"headline":"North Devon auditors clear accounts with no sustainability concerns","lead":"North Devon Council's external auditors have found no significant weaknesses in its financial arrangements and anticipate issuing a clean audit opinion on the 2025/26 accounts. Bishop Fleming, the council's auditors, said the council has sound governance and sustainability arrangements in place. The council has meanwhile established a Councillor Budget Working Group to address a gap identified in its medium-term financial strategy \u2014 the plan showing expected spending and income over the next three to five years \u2014 but auditors did not flag this as a significant concern about the council's ability to balance its books. The council is also entering social housing provision as a Local Authority Registered Provider for the first time in over 20 years, a move that creates new statutory obligations; the council has engaged external consultants to ensure the governance arrangements are in place from the start.","iso":"2026-09-23","paper_title":"Appendix A Annual Governance Statement 2025/26","paper_url":"https://democracy.northdevon.gov.uk/documents/s39918/39918.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-23","committee":"Council","paper_title":"Appendix A Annual Governance Statement 2025/26","paper_url":"https://democracy.northdevon.gov.uk/documents/s39918/39918.pdf","headline":"Council Budget Working Group established to address gap in five-year Medium Term Financial Strategy.","detail":"Council has established a Councillor Budget Working Group to proactively review options for addressing a budget gap identified in the Medium Term Financial Strategy. External auditors did not flag this as a significant weakness in financial sustainability arrangements.","category":"budget","matters":"Budget gap indicates financial pressures that lenders should monitor, but proactive management suggests the council is addressing the challenge.","figures":"Not quantified in this statement","quote":"Councillor Budget Working Group to proactively review options for addressing the budget gap in Medium Term Financial Strategy","material":true},{"iso":"2026-09-23","committee":"Council","paper_title":"Appendix A Annual Governance Statement 2025/26","paper_url":"https://democracy.northdevon.gov.uk/documents/s39918/39918.pdf","headline":"Council entering first direct social housing provision as Local Authority Registered Provider in over 20 years.","detail":"North Devon Council is taking on a new statutory role as a Local Authority Registered Provider, delivering direct social housing provision for the first time in over 20 years. This creates new governance and statutory obligations, for which the council has engaged an external consultant to ensure safe and legal delivery from day one.","category":"governance","matters":"New housing role creates capital investment and governance burden that lenders must assess alongside the council's other responsibilities.","figures":"First provision in over 20 years","quote":"we be making our first direct provision of social housing, as a Local Authority Registered Provider, for over 20 years and so we need to ensure that all the governance arrangement are in place to ensure safe and legal delivery and to meet our new statutory obligations","material":true},{"iso":"2026-09-23","committee":"Council","paper_title":"Appendix A Annual Governance Statement 2025/26","paper_url":"https://democracy.northdevon.gov.uk/documents/s39918/39918.pdf","headline":"External auditors found no significant weaknesses in financial sustainability arrangements and anticipate an unmodified audit opinion.","detail":"Bishop Fleming's 2025/26 external audit found no significant weaknesses in financial sustainability, governance, or efficiency arrangements. The auditors anticipate issuing an unmodified (clean) audit opinion on the financial statements.","category":"audit","matters":"Clean external audit opinion provides lender confidence that council financial position and governance are sound.","figures":"Not quantified in document","quote":"The draft External Auditor's Annual Report for 2025/26 found no significant weaknesses in the arrangements we have in place for financial sustainability, our governance arrangements and in our arrangements for improving economy, efficiency and effectiveness. External auditors anticipate issuing an unmodified audit opinion on the financial statements","material":true},{"iso":"2026-09-15","committee":"Governance Committee","paper_title":"NDC DAP Internal Audit Progress Report September 2026 - Final","paper_url":"https://democracy.northdevon.gov.uk/documents/s39825/39825.pdf","headline":"Full internal control assurance opinion cannot be provided at this stage of the year","detail":"The Head of Internal Audit is unable to provide a comprehensive opinion on the adequacy and effectiveness of the council's internal control framework. This will be provided later in the year when the audit plan is further progressed. The 2026-27 plan is in early stages with 40 audits planned, 8 reported, 14 in progress, 15 not yet due, and 3 cancelled.","category":"governance","matters":"The absence of a full assurance opinion limits stakeholder confidence in the overall control environment and means governance assessment is incomplete","figures":"40 audits planned; 8 completed; 14 in progress; 3 cancelled","quote":"The Head of Internal Audit is currently unable to provide an Opinion on the adequacy and effectiveness of the Authority's internal control framework at this stage of the year. This will be provided later in the year when the plan is further progressed.","material":true},{"iso":"2026-09-15","committee":"Governance Committee","paper_title":"NDC DAP Internal Audit Progress Report September 2026 - Final","paper_url":"https://democracy.northdevon.gov.uk/documents/s39825/39825.pdf","headline":"Payroll control weaknesses identified including reliance on single technician and review process gaps","detail":"Internal audit identified control weaknesses in payroll system parameter changes, sole reliance on one Payroll Technician, use of an informal checklist, and gaps in payrun review and verification. While assessed as Reasonable Assurance, the report flags that 'there is a risk that this position could deteriorate if appropriate strengthening actions are not implemented', indicating the current control state depends on these actions being taken.","category":"governance","matters":"Key person dependency in financial controls creates operational risk and contingency planning concerns that affect governance resilience","figures":"One Payroll Technician; controls assessed as Reasonable not Substantial","quote":"While control weaknesses were identified relating to system parameter changes (Pay Scales), reliance on a single Payroll Technician, use of a Payroll (Payrun) Checklist, and aspects of Payrun review, verification processes and independent oversight these do not currently undermine the overall assurance opinion. However, there is a risk that this position could deteriorate if appropriate strengthening actions are not implemented.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-23"},"name":"North Devon","daily_post":{"iso":"2026-09-26","since_iso":"2026-08-27","distress":false,"headline":"Council Budget Working Group established to address gap in five-year Medium Term Financial Strategy.","lead":"Budget gap indicates financial pressures that lenders should monitor, but proactive management suggests the council is addressing the challenge.","also":["10 other findings in this window"],"watch":"Scrutiny and Policy Development Committee on 2026-10-08","n_findings":11,"n_documents":0,"top_paper_title":"Appendix A Annual Governance Statement 2025/26","top_paper_url":"https://democracy.northdevon.gov.uk/documents/s39918/39918.pdf","draft":true},"findings_total":65,"news_drafts_total":1}}