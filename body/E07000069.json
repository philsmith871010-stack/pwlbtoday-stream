21-22":6285.0,"2022-23":4220.0,"2023-24":11261.0,"2024-25":14207.0},"prov":{"description":"NET current expenditure - NET REVENUE EXPENDITURE (TOTAL OF LINES 800 TO 804)","form":"RS","row":"805","col":"1"}}]}],"context":[{"label":"Resident population","value":90524,"year":"2020 est.","kind":"int"},{"label":"GVA (balanced, total)","value":1282000.0,"year":"2023","kind":"money"},{"label":"GVA per head","value":14267,"year":"2023","kind":"gbp"},{"label":"GDP per head","value":17563,"year":"2023","kind":"gbp"},{"label":"Band D council tax (area bill)","value":2318.63,"year":"2026-27","kind":"gbp"},{"label":"Band D \u2014 council's own element","value":298.8,"year":"2026-27","kind":"gbp"}]}},"dossier":{"summary":null,"compliance":null,"documents":[],"read_documents":[],"calendar":null,"news":[],"news_drafts":[{"headline":"Castle Point admits unquantified financial risk in housing enforcement policy","lead":"Castle Point Council has adopted a housing enforcement policy that allows it to carry out remedial works on properties where landlords have breached safety standards, then recharged the costs to the responsible party. However, the council's own papers acknowledge \"an unknown unquantified risk from the individuals not being able to pay,\" creating potential bad debts that could fall back on the council. The policy was approved without an estimate of this exposure, and the council asserts the policy requires no new budget provision, despite the admitted liability risk. The three-year policy covers 2026 to 2029.","iso":"2026-09-16","paper_title":"Item 9 Report: Private Sector Housing Enforcement and Civil Financial Penalties Policies 2026 to 2029 - 16/09/2026","paper_url":"https://castlepoint.cmis.uk.com/Castlepoint/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=p%2bMg%2fu0NgkpkQOM841DbFo3AFc4cuTV6WZdiMmVTGqh%2fYs%2flaa5LmQ%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-16","committee":"16 September 2026","paper_title":"Item 9 Report: Private Sector Housing Enforcement and Civil Financial Penalties Policies 2026 to 2029 - 16/09/2026","paper_url":"https://castlepoint.cmis.uk.com/Castlepoint/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=p%2bMg%2fu0NgkpkQOM841DbFo3AFc4cuTV6WZdiMmVTGqh%2fYs%2flaa5LmQ%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"The council faces an unknown and unquantified financial risk if landlords cannot pay for works undertaken in default","detail":"The policy permits Castle Point to carry out remedial works ('works in default') to fix housing violations, with costs recharged to the responsible person. However, the policy explicitly states there is an 'unknown unquantified risk from the individuals not being able to pay.' This represents a potential bad debt exposure that is not reflected in the policy's assertion of 'no new budget requirements.'","category":"other","matters":"A lender assessing council finances needs to understand unquantified financial exposures and potential bad debts that could impact council cash flow and reserves","figures":"Risk amount unknown and unquantified; no estimate provided","quote":"Should works in default be required, all costs incurred will then be recharged to the relevant individuals. There is an unknown unquantified risk from the individuals not being able to pay.","material":true},{"iso":"","committee":"","paper_title":"Item 3 Report: External Audit Statutory Recommendation - Annual Council - 20/05/2026","paper_url":"https://castlepoint.cmis.uk.com/Castlepoint/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=f0wFyj6uSSFJ7Q4BO5VLfXP852O1BAEiMgj2o4lAb6GViAv2P%2bztYA%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"Invoice verification checks extended beyond original deadline to 31 May 2026","detail":"Testing of invoices against Schedule of Rates\u2014a core External Investigation control recommendation\u2014was originally due 31 March 2026 but extended to 31 May 2026. The extension is to ensure the council was not overcharged. This is a fundamental financial control that remains incomplete five months after the investigation report.","category":"audit","matters":"An extension to complete basic invoice verification suggests unresolved control deficiencies in procurement and payments, core financial processes","figures":"Original due date 31 March 2026; extended to 31 May 2026","quote":"The identified checks will be completed by 31-May-2026 to ensure the Council has been appropriately charged.","material":true},{"iso":"","committee":"","paper_title":"Item 3 Report: External Audit Statutory Recommendation - Annual Council - 20/05/2026","paper_url":"https://castlepoint.cmis.uk.com/Castlepoint/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=f0wFyj6uSSFJ7Q4BO5VLfXP852O1BAEiMgj2o4lAb6GViAv2P%2bztYA%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"Private Sector Leases procurement delayed to autumn 2026; policy still in final governance stages","detail":"PSL procurement, a key remediation item from the External Investigation, has been delayed pending finalisation of PSL policy. As of 12 May 2026, policy remains in final stages of governance and procurement for temporary accommodation is only at early planning stage, with target completion in autumn 2026.","category":"procurement","matters":"Remediation delays in core housing operations suggest ongoing capacity or governance constraints; housing procurement is material to HRA financial performance","figures":"Autumn 2026 target completion","quote":"This action has been delayed by the need for a PSL policy to be put in place. The policy for PSLs has been updated and is in final stages of governance. Procurement for Temporary Accommodation, including PSLs, is at the early planning stage and will be completed autumn 2026.","material":true},{"iso":"","committee":"","paper_title":"Item 3 Report: External Audit Statutory Recommendation - Annual Council - 20/05/2026","paper_url":"https://castlepoint.cmis.uk.com/Castlepoint/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=f0wFyj6uSSFJ7Q4BO5VLfXP852O1BAEiMgj2o4lAb6GViAv2P%2bztYA%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"Escalation pathway to MHCLG intervention if council rejects recommendation","detail":"If the council does not accept the Statutory Recommendation, External Auditors can issue a Public Interest Report, triggering escalation to the Ministry of Housing, Communities and Local Government. MHCLG has the power to appoint independent commissioners to run the council, potentially including suspension of democratic processes and all elected members' decision-making roles.","category":"governance","matters":"The severity of potential consequences demonstrates the material nature of identified weaknesses; commissioners taking control would represent an extreme loss of governance and raise existential viability concerns","figures":"One month deadline from 25 March 2026 letter to respond to recommendation","quote":"This could result in the External Auditor exercising their further powers with potential for a Public Interest Report. In turn, this could lead to a further escalation and potential intervention by the Ministry of Housing, Communities and Local Government who have the ultimate sanction of appointing independent commissioners to run the Council.","material":true},{"iso":"","committee":"","paper_title":"Item 3 Report: External Audit Statutory Recommendation - Annual Council - 20/05/2026","paper_url":"https://castlepoint.cmis.uk.com/Castlepoint/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=f0wFyj6uSSFJ7Q4BO5VLfXP852O1BAEiMgj2o4lAb6GViAv2P%2bztYA%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"External Auditors issued formal Statutory Recommendation due to significant value for money weaknesses","detail":"Ernst & Young's audit identified significant weaknesses in the council's value for money arrangements, specifically related to a C4 regulatory judgement by the Regulator of Social Housing and an External Investigator's findings on governance, procurement and financial management in the Housing Revenue Account. The council is required to consolidate recommendations into an action plan and report quarterly.","category":"audit","matters":"A formal Statutory Recommendation from external auditors signals material governance and control failures that directly affect lending decisions and the council's financial management capability","figures":"C4 regulatory judgement from Regulator of Social Housing; 18 External Investigation recommendations; 5 peer challenge priority areas","quote":"The Statutory Recommendation is in recognition of EY's assessment of significant weaknesses in the Council's value for money arrangements, specifically in relation to the C4 regulatory judgement by the Regulator of Social Housing and a subsequent External Investigator's report looking at governance, procurement and financial management within the Housing Revenue Account.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-16"},"name":"Castle Point","daily_post":{"iso":"2026-09-23","since_iso":"2026-08-24","distress":false,"headline":"The council faces an unknown and unquantified financial risk if landlords cannot pay for works undertaken in default","lead":"A lender assessing council finances needs to understand unquantified financial exposures and potential bad debts that could impact council cash flow and reserves","also":[],"watch":null,"n_findings":1,"n_do