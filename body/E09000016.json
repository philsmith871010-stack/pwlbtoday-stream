ocracy.havering.gov.uk/documents/s83090/6-0-final-tmss-annual-investment-strategy.pdf","committee":"Council","date":"04/03/2026","key":true},{"title":"7.0 5 Year Capital Programme & Strategy","url":"https://democracy.havering.gov.uk/documents/s83089/7-0-5-year-capital-programme-strategy.pdf","committee":"Council","date":"04/03/2026","key":true},{"title":"0-1 - Budget report cabinet 2026 (2)","url":"https://democracy.havering.gov.uk/documents/s83059/0-1-budget-report-cabinet-2026-2.pdf","committee":"Council","date":"04/03/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-24","committee":"Overview & Scrutiny Board","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-09-29","committee":"Pensions Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-10-08","committee":"Joint Health Overview & Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-10-13","committee":"Audit Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-10-14","committee":"Cabinet","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-10-22","committee":"Governance Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-11-03","committee":"Pensions Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-11-10","committee":"Place Overview & Scrutiny Sub Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"}],"recent":[{"date":"2026-08-19","committee":"Governance Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-09-02","committee":"Council","time":"7.30 pm","status":"Confirmed","webcast":true,"url":"https://democracy.havering.gov.uk"},{"date":"2026-09-08","committee":"People Overview & Scrutiny Sub Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-09-15","committee":"Place Overview & Scrutiny Sub Committee","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"},{"date":"2026-09-16","committee":"Cabinet","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.havering.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Havering seeks \u00a354m bailout to balance budget as schools costs surge","lead":"Havering council will require \u00a354.2m of exceptional financial support, a government bailout for day-to-day spending, to balance its 2026/27 budget, the cabinet learned this week. The figure is down from a worst-case assumption of \u00a377m at budget setting but represents an enduring structural gap: the government's allocation is based on outdated metrics that do not reflect Havering's rapid demographic change and rising costs. The schools funding block is the largest driver, with the dedicated schools grant high needs budget \u2014 which funds support for children with special educational needs and disabilities \u2014 forecasting a \u00a345m in-year overspend. The cumulative shortfall in schools funding is expected to reach \u00a3110m by 2027/28. The council says the government formula does not cover actual demand across England.","iso":"2026-09-16","paper_title":"5.0 R J Mitchell Nursery and SEND Unit 2026 FINAL","paper_url":"https://democracy.havering.gov.uk/documents/s85537/85537.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Havering needs \u00a354m rescue to balance budget despite underspend forecast","lead":"Havering Council needs \u00a354.2m of exceptional financial support (extra government borrowing permission) to balance its 2026/27 budget, even though it is forecasting a general underspend of \u00a322.8m. The figure is down from \u00a377m worst-case assumptions at budget-setting but reflects a structural funding gap: the council says the government's allocation is based on outdated metrics and does not cover the reality of rapid demographic change. The chief financial pressure is schools funding, where the High Needs Block (support for children with special educational needs and disabilities) is forecasting a \u00a345m overspend in year, with cumulative deficit expected to reach \u00a3110m by 2027/28. The council attributes the overspend to rising demand that the government's national formula does not cover for Havering and other local authorities.","iso":"2026-09-16","paper_title":"5.0 R J Mitchell Nursery and SEND Unit 2026 FINAL","paper_url":"https://democracy.havering.gov.uk/documents/s85537/85537.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-16","committee":"Cabinet","paper_title":"10.1 Appendix 1 revenue monitoring quarter 1","paper_url":"https://democracy.havering.gov.uk/documents/s85580/85580.pdf","headline":"Housing Benefit subsidy income is under pressure due to the final transfer of clients to Universal Credit and ineligible landlord claims.","detail":"Resources is forecasting an overspend of \u00a31m (4% of budget), with Housing Benefit subsidy identified as the main risk. The shortfall is caused by the final transfer of clients from HB to Universal Credit and also by shortfalls where HB has been claimed at Supported/Exempt Accommodation rates but the landlord is not eligible.","category":"income","matters":"HB subsidy income losses indicate the council may face unexpected income shortfalls as government policy shifts towards Universal Credit, reducing the predictability of revenue.","figures":"Housing Benefit subsidy shortfall contributing to \u00a31m Resources overspend","quote":"The main risk in Resources is the Housing Benefit Subsidy where there is a shortfall leading to a pressure. This is caused by the final transfer of clients from HB to Universal Credit and also by shortfalls where HB has been claimed at Supported/Exempt Accommodation rates but the landlord is not eligible.","material":false},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"10.1 Appendix 1 revenue monitoring quarter 1","paper_url":"https://democracy.havering.gov.uk/documents/s85580/85580.pdf","headline":"The Dedicated Schools Grant shows a cumulative deficit forecast to reach \u00a3110m by 2027-28, with a \u00a334.2m overspend this year.","detail":"There is a significant continuing overspend in the High Needs Block of the DSG, with a forecasted overspend of \u00a334.2m (100% of the \u00a345.14m block budget). This reflects increasing demand for support that the central government formula does not cover for Havering and other local authorities. Though MHCLG has announced a write-off of up to 90% of deficits due to High Needs pressures, this remains a significant structural pressure dependent on the council submitting an approved SEND Reform Plan.","category":"demand","matters":"A \u00a3110m accumulated deficit, even with a planned write-off, indicates structural pressure on SEND/High Needs that the council cannot control. The write-off is discretionary and dependent on continued compliance, creating future risk.","figures":"\u00a334.2m overspend in High Needs Block (100% of block), cumulative deficit forecast \u00a3110m by end 2027-28, planned write-off up to 90%","quote":"The cumulative overall DSG deficit forecasted to be carried forward to 2027-28 is expected to be up to \u00a3110m.","material":true},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"10.1 Appendix 1 revenue monitoring quarter 1","paper_url":"https://democracy.havering.gov.uk/documents/s85580/85580.pdf","headline":"Savings delivery is at risk, with \u00a31.3m rated Amber and \u00a31.14m unlikely to deliver this year.","detail":"The budget assumes \u00a310.01m of savings, of which \u00a37.57m are forecast to be delivered. A further \u00a31.3m are rated Amber or uncertain, and \u00a31.14m is rated Red (unlikely to deliver in year). Additionally, \u00a30.25m is at risk of non-delivery, relating to the Extra Care review.","category":"savings","matters":"When planned savings are not materializing, it indicates either the council's delivery capability is weaker than planned, or the assumptions behind the savings are wrong\u2014both increase budget risk.","figures":"\u00a310.01m total savings, \u00a37.57m forecast delivered, \u00a31.3m Amber, \u00a31.14m Red, \u00a30.25m at risk of non-delivery","quote":"\u00a31.3m are rated Amber or uncertain.  This includes removal of costs from Mercury House and a range of savings initiatives in Adult Social care such as Direct Payment clawbacks, targeted reviews and the Better Living Programme.","material":true},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"10.1 Appendix 1 revenue monitoring quarter 1","paper_url":"https://democracy.havering.gov.uk/documents/s85580/85580.pdf","headline":"Adult Social Care costs are rising faster than expected even with stable client numbers, driven by increasing care complexity.","detail":"Living Well (Adult Social Care) is forecasting a \u00a31.95m overspend. The paper notes that whilst client numbers have remained relatively stable overall, the average weekly cost of care has increased significantly, reflecting both greater support needs and contractual inflationary uplifts awarded to providers.","category":"overspend","matters":"Cost inflation outpacing both client number growth and inflation provision suggests either demographic complexity is worsening or provider rates are being driven up by market conditions, both limiting the council's cost control.","figures":"\u00a31.95m Living Well overspend, part of \u00a36.34m People overspend","quote":"Whilst client numbers have remained relatively stable overall, the average weekly cost of care has increased significantly in several placement types, reflecting both greater support needs and the impact of contractual inflationary uplifts awarded to providers.","material":true},{"iso":"2026-09-16","committee":"Cabinet","paper_title":"10.1 Appendix 1 revenue monitoring quarter 1","paper_url":"https://democracy.havering.gov.uk/documents/s85580/85580.pdf","headline":"Home to School Transport demand has exceeded the budget by 143 applications (1,169 vs 1,026), creating an overspend that budget growth will not cover.","detail":"Education is forecasting a \u00a31.3m overspend, with Home to School Transport being the main driver. The number of children forecast to require transport has increased from 1,026 to 1,169. The paper explicitly states that budget growth 'will not extinguish the overspend'.","category":"demand","matters":"Demand-driven overspends in transport services indicate the council is experiencing demographic changes it did not anticipate and cannot easily control.","figures":"1,169 applications forecast vs 1,026 budget (143 additional), part of \u00a31.3m Education overspend","quote":"Budget growth has not been allocated yet but will not extinguish the overspend as the growth bid was based on 1,026 transport applications and this year's estimate is 1,169.","material":true}],"editorial":{"headline":"Havering's structural deficit forces \u00a337.7m exceptional support; \u00a3240m borrowing conversion ahead","standfirst":"July cabinet papers show Havering's structural deficit requiring exceptional support, as \u00a3240m internal borrowing converts to external next year.","body":"Havering's 2025/26 accounts, presented to July's cabinet, reveal structural revenue collapse. The council's net expenditure reached \u00a3242.11m against available funding, \"necessitating the use [of] Exceptional Financial Support\" of \u00a337.7m. This is not a one-off overspend. The council's own papers describe it as \"an underlying budget gap\" that already requires further exceptional support budgeted for 2026/27.\n\nThe deficit masks systemic failure across core services. Within Living Well, Learning Disabilities overspent by \u00a31.95m despite receiving \u00a34.9m additional growth. The council identifies \"complexity pressures\" as the culprit\u2014spending on high-cost transition cases and client complexity outpacing new resource. Schools have deteriorated sharply: from a \u00a31.86m surplus at the end of 2024/25 to an overall deficit of \u00a30.72m, with 15 schools now in individual deficit totalling \u00a36.3m.\n\nCapital spending has become the council's chronic drag. Outturn was \u00a3135.4m against a \u00a3163.7m forecast\u2014a \u00a328.4m shortfall the council attributes to \"delayed start on site at four schemes approved to start in 2025/26\" across Mercury Land Holdings' housing programme. SEND school expansions were hit by \"delays in the procurement process and appointment of contractors.\" Transport for London schemes went undelivered due to \"resourcing constraints,\" leaving grant funding unclaimed. The council requested \u00a3125m carry-forward.\n\nRevenue savings delivery collapsed: \u00a31.2m went unachieved, \u00a32.0m delayed to 2026/27.\n\nThe 2026/27 outlook will be defined by debt. The council holds \u00a3240m of internal borrowing. Papers note \"it is highly likely therefore that further new external borrowing will be needed in 2026/27 both to finance that year's capital programme but also to reduce the level of internal borrowing as those funds are needed for other purposes.\" This conversion will materially increase debt service costs. The Dedicated Schools Grant deficit stands at \u00a369m; a required \u00a36.9m local contribution hinges on DfE SEND Reform Plan approval.","pull_quote":"increasing levels of client complexity, despite adding in \u00a34.9m of growth","watch_next":"The 2026/27 budget setting will formally confirm the external borrowing requirement and DfE SEND Reform Plan approval status.","based_on_iso":"2026-07-08"},"freshness":{"last_paper_iso":"2026-09-16"},"name":"Havering","daily_post":{"iso":"2026-09-19","since_iso":"2026-08-20","distress":true,"headline":"Housing Benefit subsidy income is under pressure due to the final transfer of clients to Universal Credit and ineligible landlord claims.","lead":"HB subsidy income losses indicate the council may face unexpected income shortfalls as government policy shifts towards Universal Credit, reducing the predictability of revenue.","also":["23 other findings in this window"],"watch":"The 2026/27 budget setting will formally confirm the external borrowing requirement and DfE SEND Reform Plan approval status.","n_findings":24,"n_documents":0,"top_paper_title":"10.1 Appendix 1 revenue monitoring quarter 1","top_paper_url":"https://democracy.havering.gov.uk/documents/s85580/85580.pdf","draft":true},"findings_total":88,"news_drafts_total":2}}