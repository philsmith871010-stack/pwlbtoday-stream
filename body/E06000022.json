91214/alice-park-trust-2025-26-draft-outturn-report.pdf","committee":"Alice Park Trust Sub-Committee","date":"15/05/2026","key":false},{"title":"Treasury Management Policy 2026","url":"http://democracy.bathnes.gov.uk/documents/s90770/treasury-management-policy-2026.pdf","committee":"Avon Pension Fund Committee","date":"27/03/2026","key":false},{"title":"Appendix 3 Budget and Cash Flow Forecast","url":"http://democracy.bathnes.gov.uk/documents/s90767/appendix-3-budget-and-cash-flow-forecast.pdf","committee":"Avon Pension Fund Committee","date":"27/03/2026","key":false},{"title":"Investment Strategy Statement","url":"http://democracy.bathnes.gov.uk/documents/s90758/investment-strategy-statement.pdf","committee":"Avon Pension Fund Committee","date":"27/03/2026","key":false},{"title":"2025 Valuation Outcome","url":"http://democracy.bathnes.gov.uk/documents/s90760/2025-valuation-outcome.pdf","committee":"Avon Pension Fund Committee","date":"27/03/2026","key":false},{"title":"Appendix 1 - Scope of Avon Pension Fund - Summary table","url":"http://democracy.bathnes.gov.uk/documents/s90764/appendix-1-scope-of-avon-pension-fund-summary-table.pdf","committee":"Avon Pension Fund Committee","date":"27/03/2026","key":false},{"title":"Appendix 6 - Audit Update Report Pension Board March 2026","url":"http://democracy.bathnes.gov.uk/documents/s90784/appendix-6-audit-update-report-pension-board-march-2026.pdf","committee":"Avon Pension Fund Committee","date":"27/03/2026","key":false}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-10-12","committee":"Children, Adults, Health and Wellbeing Policy Development and Scrutiny Panel","time":"9.30 am","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-11-09","committee":"Children, Adults, Health and Wellbeing Policy Development and Scrutiny Panel","time":"9.30 am","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-11-12","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-11-17","committee":"Corporate Policy Development and Scrutiny Panel","time":"4.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-11-25","committee":"Audit Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-11-26","committee":"Avon Pension Fund Committee Investment Panel","time":"1.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-11-26","committee":"Climate Emergency and Sustainability Policy Development and Scrutiny Panel","time":"10.00 am","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-12-01","committee":"Pension Board","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://democracy.bathnes.gov.uk"}],"recent":[{"date":"2026-09-17","committee":"Council","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-09-18","committee":"Avon Pension Fund Committee","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-09-22","committee":"Corporate Policy Development and Scrutiny Panel","time":"4.00 pm","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-09-23","committee":"Audit Committee","time":"5.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.bathnes.gov.uk"},{"date":"2026-09-24","committee":"Climate Emergency and Sustainability Policy Development and Scrutiny Panel","time":"10.00 am","status":"Confirmed","webcast":true,"url":"https://democracy.bathnes.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Bath and North East Somerset faces \u00a346.5m schools funding crisis threatening council reserves","lead":"Bath and North East Somerset's audited accounts for 2025\u201326 received a clean opinion, but the council faces a significant underlying weakness: a \u00a346.5m deficit in dedicated schools grant funding, which pays for schools and support for children with special needs. If unresolved by 31 March 2028, the shortfall may require the council to draw on its reserve cushions, risking the council's medium-to-longer term financial stability. The council is managing the deficit under a Department for Education Safety Valve Agreement, a formal intervention triggered by unsustainable school deficits. Separately, the council's pension fund improved its funding position from 106 per cent to 109 per cent over the past year, moving employers out of deficit, and holds \u00a36.2bn in assets.","iso":"2026-09-23","paper_title":"9z Audit Findings Reports &amp; audited Statement of Accounts 202526 Appendix 2","paper_url":"https://democracy.bathnes.gov.uk/documents/s94110/94110.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-23","committee":"Audit Committee","paper_title":"9zz Page 124 of Agenda Pack - Appendix 3 - Updated Balance Sheet","paper_url":"https://democracy.bathnes.gov.uk/documents/s94236/94236.pdf","headline":"Short-term creditors increased 13% to \u00a371.7m, the largest proportional movement in current liabilities.","detail":"Short-term creditors rose from \u00a363.4m to \u00a371.7m (increase of \u00a38.3m), driving current liabilities from \u00a3157.8m to \u00a3173.0m overall. These represent obligations due within 12 months. Cash and cash equivalents declined slightly from \u00a323.5m to \u00a322.2m, a 5.7% decrease.","category":"other","matters":"A material increase in current liabilities, combined with a slight decline in the most liquid asset, affects the council's short-term financial flexibility and cash flow management.","figures":"Short Term Creditors: \u00a363,377k to \u00a371,699k (increase of \u00a38,322k); Current Liabilities total: \u00a3157,845k to \u00a3173,021k; Cash and Cash Equivalents: \u00a323,548k to \u00a322,203k","quote":"(63,377)                                Short Term Creditors (71,699)","material":true},{"iso":"2026-09-23","committee":"Audit Committee","paper_title":"9zz Page 124 of Agenda Pack - Appendix 3 - Updated Balance Sheet","paper_url":"https://democracy.bathnes.gov.uk/documents/s94236/94236.pdf","headline":"Long-term borrowing increased by \u00a312.4m (5.8%) to \u00a3225.1m in parallel with a 35% jump in assets under construction.","detail":"Long-term debt rose from \u00a3212.7m to \u00a3225.1m, adding \u00a312.4m of new borrowing. Assets under Construction surged from \u00a353.4m to \u00a372.2m (35% increase), and Infrastructure assets grew 7% to \u00a3166.1m, indicating substantial capital programme activity.","category":"borrowing","matters":"Lenders need to understand whether increased debt is supporting productive capital investment (a positive indicator of strategic deployment) or reflects financial pressure.","figures":"Long Term Borrowing: \u00a3212,719k to \u00a3225,094k; Assets under Construction: \u00a353,356k to \u00a372,245k (increase of \u00a318,889k); Infrastructure: \u00a3155,248k to \u00a3166,053k","quote":"(212,719)                             Long Term Borrowing (225,094)","material":true},{"iso":"2026-09-23","committee":"Audit Committee","paper_title":"9zz Page 124 of Agenda Pack - Appendix 3 - Updated Balance Sheet","paper_url":"https://democracy.bathnes.gov.uk/documents/s94236/94236.pdf","headline":"Net assets increased by \u00a328.7m (5.7%) to \u00a3527.6m, with asset growth outpacing liability increases.","detail":"The council's net asset position grew from \u00a3498.9m in March 2025 to \u00a3527.6m in March 2026. Long-term assets increased by \u00a337.9m (4.4%) while long-term borrowing grew by \u00a312.4m (5.8%), resulting in a net strengthening of the balance sheet position.","category":"other","matters":"A strengthening balance sheet indicates improving financial resilience and demonstrates that the council is building asset value faster than it is accumulating debt.","figures":"Net Assets: \u00a3498,936k to \u00a3527,632k (increase of \u00a328,696k); Long-Term Assets: \u00a3863,436k to \u00a3901,379k; Long-Term Borrowing: \u00a3212,719k to \u00a3225,094k","quote":"498,936                        Net Assets 527,632","material":true},{"iso":"2026-09-23","committee":"Audit Committee","paper_title":"12 Treasury Management Outturn Report 2025-26Sept","paper_url":"https://democracy.bathnes.gov.uk/documents/s94141/94141.pdf","headline":"Council deliberately funding \u00a397m of capital needs from internal reserves rather than external borrowing, maintaining borrowing below Capital Financing Requirement.","detail":"External borrowing of \u00a3288.977m is \u00a397.023m below the Capital Financing Requirement of \u00a3386m. Council deliberately limits external borrowing because internal cash and reserves can be deployed more cost-effectively than external borrowing, reducing net debt service costs. This strategy demonstrates confidence in reserves position but means borrowing will likely increase materially as internal balances are gradually depleted to fund capital expenditure. Borrowing is almost in line with the calculated Liability Benchmark and projected to fall below it.","category":"borrowing","matters":"Demonstrates significant internal reserves and confident reserve management strategy. Lender should understand sustainability of this approach and project when council may need to return to higher external borrowing if capital spending is front-loaded or revenue pressure emerges.","figures":"CFR \u00a3386m, borrowing \u00a3288.977m, internal funding gap \u00a397.023m; borrowing at 75% of CFR","quote":"The difference between the CFR of \u00a3386m and the Borrowing Portfolio of \u00a3288.977m represents re-investment of the internal balances including reserves, reducing the in -year borrowing costs in excess of the potential investment returns .","material":true},{"iso":"2026-09-23","committee":"Audit Committee","paper_title":"12 Treasury Management Outturn Report 2025-26Sept","paper_url":"https://democracy.bathnes.gov.uk/documents/s94141/94141.pdf","headline":"Liquid investments fell \u00a311.9m from \u00a333.2m to \u00a321.3m while council took \u00a320m additional borrowing to maintain liquidity threshold.","detail":"Short-term liquid investments fell from \u00a333.200m at 31 December 2025 to \u00a321.300m at 31 March 2026 as cash was used for capital and revenue operations. Council took \u00a320m new borrowing (beyond \u00a370m for replacing maturities) to cover annual pension contribution prepayment and maintain minimum liquidity above \u00a315m threshold. Council maintained liquidity of \u00a318.400m, only \u00a33.4m above minimum. This reflects strategic use of internal cash where cost-effective while maintaining prudent liquidity buffers.","category":"reserves","matters":"Significant drawdown in liquid reserves combined with only modest buffer above minimum threshold indicates tighter working capital position than prior year. While this reflects good treasury strategy (using internal balances before external borrowing), it leaves limited headroom for unexpected cash demands.","figures":"Liquid investments \u00a333.200m (31 Dec 2025) to \u00a321.300m (31 March 2026); minimum liquidity maintained at \u00a318.400m vs \u00a315.000m threshold; \u00a320m new borrowing taken","quote":"This includes \u00a390.000m of borrowing taken out during the year, which breaks down as \u00a320.000m of new loans taken out to cover the annual pension contribution prepayment and to maintain the Council's liquidity indicator above \u00a315.000m, as well as \u00a370.000m of borrowing to replace maturing loans.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-23"},"name":"Bath & North East Somerset UA","daily_post":{"iso":"2026-09-25","since_iso":"2026-08-26","distress":false,"headline":"Short-term creditors increased 13% to \u00a371.7m, the largest proportional movement in current liabilities.","lead":"A material increase in current liabilities, combined with a slight decline in the most liquid asset, affects the council's short-term financial flexibility and cash flow management.","also":["49 other findings in this window"],"watch":"Children, Adults, Health and Wellbeing Policy Development and Scrutiny Panel on 2026-10-12","n_findings":50,"n_documents":0,"top_paper_title":"9zz Page 124 of Agenda Pack - Appendix 3 - Updated Balance Sheet","top_paper_url":"https://democracy.bathnes.gov.uk/documents/s94236/94236.pdf","draft":true},"findings_total":115,"news_drafts_total":1}}