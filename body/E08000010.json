escription":"Unallocated financial reserves level - end","form":"RS","row":"916","col":"3"}},{"label":"Other earmarked reserves","code":"RS_resoth_end_cy","by_year":{"2017-18":84839.0,"2018-19":63970.0,"2019-20":68926.0,"2020-21":175628.0,"2021-22":161414.0,"2022-23":112222.0,"2023-24":78646.0,"2024-25":60940.0},"prov":{"description":"Other earmarked financial reserves level - end","form":"RS","row":"915","col":"3"}}]},{"id":"council_tax_ratio","label":"Council tax requirement","unit":"pct","ratio":{"2017-18":48.25,"2018-19":44.02,"2019-20":44.34,"2020-21":49.7,"2021-22":48.81,"2022-23":43.22,"2023-24":44.65,"2024-25":46.68},"parts":[{"label":"Council tax requirement","code":"RS_ctrtot_net_exp","by_year":{"2017-18":110020.0,"2018-19":115205.0,"2019-20":116707.0,"2020-21":121399.0,"2021-22":126788.0,"2022-23":132694.0,"2023-24":142866.0,"2024-25":152174.0},"prov":{"description":"Financing - COUNCIL TAX REQUIREMENT (TOTAL OF LINES 805 TO 885)","form":"RS","row":"890","col":"1"}},{"label":"Net revenue expenditure","code":"RS_netrevexp_net_exp","by_year":{"2017-18":228024.0,"2018-19":261709.0,"2019-20":263227.0,"2020-21":244283.0,"2021-22":259761.0,"2022-23":307018.0,"2023-24":319950.0,"2024-25":326005.0},"prov":{"description":"NET current expenditure - NET REVENUE EXPENDITURE (TOTAL OF LINES 800 TO 804)","form":"RS","row":"805","col":"1"}}]}],"context":[{"label":"Resident population","value":330712,"year":"2020 est.","kind":"int"},{"label":"GVA (balanced, total)","value":6705000.0,"year":"2023","kind":"money"},{"label":"GVA per head","value":19769,"year":"2023","kind":"gbp"},{"label":"GDP per head","value":22869,"year":"2023","kind":"gbp"},{"label":"Band D council tax (area bill)","value":2152.68,"year":"2026-27","kind":"gbp"},{"label":"Band D \u2014 council's own element","value":1712.29,"year":"2026-27","kind":"gbp"}]}},"dossier":{"summary":{"summary":"Wigan's year-end treasury review shows a compliant but growing debt book: loan debt rose \u00a352.2m to \u00a3440.2m in 2025/26 (\u00a367m of new loans at 4.34%-4.74%), against a borrowing need (CFR) of \u00a3623.3m, leaving the council \u00a3137.2m under-borrowed \u2014 running on internal cash rather than external debt. Treasury investments rose to \u00a343.2m earning 5.17%, and all borrowing stayed inside the \u00a3678.7m authorised limit. The new borrowing was deliberately short-dated (all four 2025/26 loans mature by June 2027) to avoid locking in long-term rates above 5%, so the council returns to the market to refinance from late 2026 onward.","fy":"2025/26","as_of_doc":"Treasury Management Annual Review 2025/26","as_of_url":"https://wigan.moderngov.co.uk/documents/s103126/Treasury Management Annual Review 202526.pdf?a=1","as_of_date":"2026-07-23","signals":[{"code":"borrowing-increase","headline":"Loan debt up \u00a352.2m to \u00a3440.2m in 2025/26; \u00a367m of new loans taken at 4.34%-4.74%","why":"Wigan is steadily externalising a borrowing need that still sits \u00a3137m above its external debt, making it a recurring borrower."},{"code":"refinancing-risk","headline":"\u00a3101.5m of PWLB debt matures within 24 months of 31 March 2026 (\u00a326.2m under 12 months, \u00a375.3m in 12-24 months), plus the \u00a320m and \u00a337m 2025/26 loans falling due Oct 2026-Jun 2027","why":"The deliberate short-dating strategy defers rate risk rather than removing it \u2014 this debt rolls over at whatever rates prevail from late 2026."}],"key_figures":[{"name":"cfr","value":"\u00a3623.341m total","as_at":"31 March 2026","page":9},{"name":"borrowing","value":"\u00a3440.167m loan debt (PWLB \u00a3438.201m at avg 4.05%); gross position incl PFI and IFRS16 leases \u00a3486.151m","as_at":"31 March 2026","page":9},{"name":"investments","value":"\u00a343.173m at 5.17% return (from \u00a329.890m a year earlier)","as_at":"31 March 2026","page":9},{"name":"internal borrowing","value":"\u00a3137.190m under-borrowed against the CFR","as_at":"31 March 2026","page":9},{"name":"maturity under 12m","value":"\u00a326.197m (5.98% of PWLB debt); a further \u00a375.284m matures in 12-24 months (17.18%)","as_at":"31 March 2026","page":9},{"name":"new borrowing in year","value":"\u00a367m \u2014 PWLB \u00a37m HRA @4.34% and \u00a330m GF @4.74% (both to 01/06/2027), \u00a320m GF @4.37% (to 29/10/2026), Coventry City Council \u00a310m @4.50%","as_at":"2025/26","page":11},{"name":"interest and repayments","value":"PWLB interest paid \u00a315.806m (GF \u00a34.536m, HRA \u00a311.270m); principal repaid \u00a35.152m; no rescheduling","as_at":"2025/26","page":13},{"name":"limits","value":"authorised limit \u00a3678.652m; operational boundary \u00a3646.335m; peak in-year gross borrowing \u00a3445.158m","as_at":"2025/26","page":8}],"commercial":null,"tms_components":null},"compliance":null,"documents":[],"read_documents":[{"title":"Treasury Management Annual Review 2025/26","url":"https://wigan.moderngov.co.uk/documents/s103126/Treasury Management Annual Review 202526.pdf?a=1","committee":"Audit, Governance and Standards Committee","date":"2026-07-23","category":"treasury","fy":"2025/26"}],"calendar":null,"news":[],"news_drafts":[{"headline":"Wigan cuts capital spending by \u00a349m as major building projects face delays","lead":"Wigan Council has reduced its capital programme by \u00a348.78m, about a fifth of its planned spending, due to widespread delays across major schemes including schools, housing, and town centre regeneration. The 2026/27 budget was revised from \u00a3239.5m to \u00a3190.7m, with slippages in projects such as Haigh Hall (\u00a311.1m rephased to 2028/29), Hope School relocation (\u00a39.9m) and Wood Fold school (\u00a35.3m), reflecting constraints from re-procurement, planning processes and pending external funding approvals. The council is undertaking a three-year capital programme totalling \u00a3464.6m to 2028/29, heavily reliant on prudential borrowing \u2014 money a council borrows against future income \u2014 with the town centre regeneration framework alone requiring \u00a396.4m in new debt. Spending is heavily concentrated in 2026/27, placing substantial cash-flow demands on the coming year.","iso":"2026-09-23","paper_title":"Capital Programme Monitoring - Quarter 1","paper_url":"https://wigan.moderngov.co.uk/documents/s104198/104198.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Medium-Term Financial Plan 2027/28 - 2029/30","paper_url":"https://wigan.moderngov.co.uk/documents/s104269/104269.pdf","headline":"General Fund balances being rebuilt with \u00a32.5m added in 2026/27 and \u00a31m annual contributions planned 2027/28 onwards, but still modest relative to budget gaps.","detail":"Council transferred \u00a32.5m into General Fund balances in 2026/27 and plans further \u00a31m annual contributions. This is intended to strengthen resilience and capacity to manage emerging risks. Earmarked reserves estimated at \u00a358.9m at 31 March 2027. Use of reserves for one-off expenditure reduced significantly in 2025/26, reflecting commitment to sustainable reserve levels. However, reserve building remains modest relative to \u00a38.5m\u2013\u00a318.9m annual savings requirements.","category":"reserves","matters":"Deliberate attempt to strengthen financial resilience, but constrained by budget gaps; shows management discipline but relative insufficiency.","figures":"\u00a32.5m transferred 2026/27; \u00a31m planned annual contributions 2027/28 onwards; \u00a358.9m earmarked reserves at 31 March 2027","quote":"the Council transferred \u00a32.5m into General Fund balances during 2026/27 and plans to make further contributions of \u00a31m in 2027/28 and subsequent years.","material":true},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Medium-Term Financial Plan 2027/28 - 2029/30","paper_url":"https://wigan.moderngov.co.uk/documents/s104269/104269.pdf","headline":"Extended Producer Responsibility income of \u00a36m per annum expected to reduce as packaging sector adapts; Deposit Return Scheme (October 2027) will further reduce recycling income.","detail":"EPR scheme currently yields council \u00a36m annually. As producers respond to EPR requirements through packaging reduction and substitution, this income stream is forecast to decline (amount unquantified). Separately, Deposit Return Scheme commencing October 2027 will remove valuable drinks containers from local authority recycling streams, reducing income further and increasing processing costs. Council has also accelerated collection of flexible plastics (April 2026), though national mandate was postponed to 2030.","category":"income","matters":"Material income source at risk; compound effect of two policy changes reducing recycling income and increasing costs; forecast impact on budget not yet quantified.","figures":"\u00a36m per annum from EPR (at risk); DRS commencing October 2027","quote":"Presently under this scheme we receive around \u00a36m per annum for dealing with this waste. This may reduce as the sector responds to the changes.","material":true},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Medium-Term Financial Plan 2027/28 - 2029/30","paper_url":"https://wigan.moderngov.co.uk/documents/s104269/104269.pdf","headline":"Maintained mainstream schools' financial position deteriorated, with 50 of 86 schools in in-year deficit and 11 in cumulative deficit in 2025/26.","detail":"Schools' aggregate balances fell \u00a30.669m in 2025/26 despite being the largest sector. Falling pupil numbers (149 fewer primary, 76 fewer secondary in October 2025 census) will reduce funding allocations further. Council is providing support to schools in cumulative deficit, but sector-wide pressure is evident and structural (not cyclical), given demographic decline.","category":"other","matters":"Delegated budget sector in stress; indicates schools cannot absorb cost pressures; falling pupil numbers are structural not temporary; potential for growing council support requirement.","figures":"50 of 86 schools in in-year deficit; 11 in cumulative deficit; balances down \u00a30.669m in 2025/26; 149 fewer primary pupils, 76 fewer secondary pupils in October 2025 census","quote":"In 2025/26 Maintained mainstream schools' balances reduced by \u00a30.669m, with 50 of the 86 schools reporting in-year deficits.","material":false},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Medium-Term Financial Plan 2027/28 - 2029/30","paper_url":"https://wigan.moderngov.co.uk/documents/s104269/104269.pdf","headline":"Fair Funding Review delivered lower funding growth to Wigan than comparable authorities; Business Rates Retention reset redistributed 13 years of accumulated growth.","detail":"The December 2025 Fair Funding Review reassessed resource allocation across councils using updated needs assessment. Wigan's outcome was lower funding growth than many peers, reflecting lower relative needs assessment. Business Rates Retention Scheme was reset for the first time since April 2013; accumulated business rates growth since 2013 was redistributed to other councils in line with new assessment. This is a structural change in Wigan's funding trajectory relative to peers.","category":"income","matters":"Structural weakening of Wigan's funding position relative to comparators; limits council's flexibility versus peer councils; no recovery mechanism.","figures":"Lower funding growth than comparable authorities (specific differential not disclosed); business rates reset after 13 years of retention.","quote":"the revised funding arrangements have resulted in Wigan receiving a lower level of funding growth than many comparable authorities.","material":true},{"iso":"2026-09-24","committee":"Cabinet","paper_title":"Medium-Term Financial Plan 2027/28 - 2029/30","paper_url":"https://wigan.moderngov.co.uk/documents/s104269/104269.pdf","headline":"High Needs Block projected to overspend \u00a317.5m (2026/27) and \u00a317.9m (2027/28), driven by EHCP growth and out-of-borough independent school placements.","detail":"High Needs overspend is driven by rising numbers and complexity of pupils at maintained special schools, EHCP growth, high-cost out-of-borough independent school placements, and post-16 SEND. The council is implementing an Inclusion and SEND Strategic Plan, but full impact will take time. These are recurring annual overspends, not one-off pressures.","category":"overspend","matters":"Ongoing structural overspend; indicates capacity and pricing challenge in SEND provision; feeds DSG deficit tracked separately but will merge into General Fund post-2028.","figures":"\u00a317.547m projected overspend 2026/27; \u00a317.979m projected overspend 2027/28","quote":"The current projection is for an overspend in 26/27 of \u00a317.547m and an overspend of \u00a317.979m in 27/28.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-24"},"name":"Wigan MBC","daily_post":{"iso":"2026-09-24","since_iso":"2026-08-25","distress":false,"headline":"General Fund balances being rebuilt with \u00a32.5m added in 2026/27 and \u00a31m annual contributions planned 2027/28 onwards, but still modest relative to budget gaps.","lead":"Deliberate attempt to strengthen financial resilience, but constrained by budget gaps; shows management discipline but relative insufficiency.","also":["24 other findings in this window"],"watch":null,"n_findings":25,"n_documents":0,"top_paper_title":"Medium-Term Financial Plan 2027/28 - 2029/30","top_paper_url":"https://wigan.moderngov.co.uk/documents/s104269/104269.pdf","draft":true},"findings_total":69,"news_drafts_total":1}}