Ff55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"Social care demand forecast at 5% with Very High risk rating; care home rate inflation unknown beyond 2026/27","detail":"The outlook assumes 5% annual social care demand growth (rated Very High risk) and assumes 10% annual care home rate inflation, though the actual 2026/27 increase was only 5.76%. National Care Home Rate remains unconfirmed for years beyond 2026/27, creating significant budget uncertainty.","category":"demand","matters":"Care demand is rising faster than population growth; if rates increase beyond 10% or demand beyond 5%, the partnership faces immediate material cost overruns","figures":"5% demand growth assumed; 10% care home rate assumed; 2026/27 actual rate increase 5.76%; \u00a35.342m pressure from care homes in 2027/28; \u00a34.086m from demand growth","quote":"Demand for social care services continues to increase and a provision of 5% annual growth has been included throughout the planning period. This results in a pressure of \u00a34.086m in 2027/28.","material":true},{"iso":"2026-09-16","committee":"16 September 2026","paper_title":"Medium Term Financial Outlook 2027-2030","paper_url":"https://northlanarkshire.cmis.uk.com/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=mcTfeTOlNcigpl1De1NouN9E63TFZoPaClO%2bTmPxhKZr9DRkOtj8GQ%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"Prescribing remains most significant financial risk with 5% annual growth assumption and volatile history","detail":"Prescribing is identified as the partnership's most significant financial risk, driven by national pricing, market conditions and clinical activity levels. A 5% annual growth assumption generates \u00a34.432m pressure in 2027/28 alone, despite marginal underspend in 2025/26.","category":"demand","matters":"Prescribing is demand-driven and outside the partnership's control; if growth exceeds forecast the budget gap immediately widens by the variance","figures":"5% assumed annual growth; \u00a34.432m forecast pressure in 2027/28; \u00a313.971m across three years; marginal underspend \u00a30.014m in 2025/26","quote":"Prescribing expenditure remains one of the Partnership's most significant financial risks. A growth assumption of 5% per annum has therefore been retained within the outlook, generating a pressure of \u00a34.432m in 2027/28.","material":true},{"iso":"2026-09-16","committee":"16 September 2026","paper_title":"Medium Term Financial Outlook 2027-2030","paper_url":"https://northlanarkshire.cmis.uk.com/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=mcTfeTOlNcigpl1De1NouN9E63TFZoPaClO%2bTmPxhKZr9DRkOtj8GQ%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"2026/27 savings programme delayed in delivery; new recurring pressures identified through in-year monitoring","detail":"The partnership's 2026/27 savings and transformation programme has not been fully embedded, with service redesign initiatives taking longer than planned to deliver recurring benefits. In-year financial monitoring has also identified new recurring cost pressures that require sustainable funding solutions.","category":"savings","matters":"Delayed savings delivery widens the current-year deficit and compounds future-year pressures; new recurring costs must be addressed alongside existing savings shortfalls","figures":"Not separately quantified; included in 2027/28-2029/30 forecast pressures","quote":"Local cost pressures within both Health and Social Care also reflect the phased implementation of elements of the 2026/27 savings and transformation programme, recognising that service redesign initiatives can take time to be fully embedded. In addition, the outlook includes recurring pressures identified through in-year financial monitoring which will require sustainable funding solutions going forward.","material":true},{"iso":"2026-09-16","committee":"16 September 2026","paper_title":"Medium Term Financial Outlook 2027-2030","paper_url":"https://northlanarkshire.cmis.uk.com/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=mcTfeTOlNcigpl1De1NouN9E63TFZoPaClO%2bTmPxhKZr9DRkOtj8GQ%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","headline":"Reserves finite and cannot be relied upon for recurring budget pressures; transformation programmes essential","detail":"The partnership holds \u00a342.135m useable reserves but explicitly states these are finite and unsustainable for addressing recurring budget pressures. Delivery of ongoing service redesign, transformation and efficiency programmes is described as critical to long-term financial sustainability.","category":"reserves","matters":"Reserves provide short-term cover but their depletion is accelerating; without structural cost reductions, reserves will be exhausted within a few years","figures":"Useable reserves \u00a342.135m (of total \u00a3102.817m); ring-fenced reserves \u00a314.985m, earmarked \u00a345.697m","quote":"reserves are a finite resource and cannot be relied upon as a sustainable solution to recurring budget pressures. Consequently, the development and delivery of recurring service redesign, transformation and efficiency programmes will remain essential to achieving long-term financial sustainability.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-16"},"name":"North Lanarkshire","daily_post":{"iso":"2026-09-17","since_iso":"2026-08-18","distress":false,"headline":"Chief Finance Officer role being restructured with explicit focus on succession planning","lead":"CFO role changes and restructuring can signal forthcoming personnel transitions or governance improvements; the explicit mention of succession planning suggests potential finance leadership changes ahead","also":["13 other findings in this window"],"watch":null,"n_findings":14,"n_documents":0,"top_paper_title":"Performance, Finance and Audit Committee - Minute of Meeting held on 20 May 2026","top_paper_url":"https://northlanarkshire.cmis.uk.com/Document.ashx?czJKcaeAi5tUFL1DTL2UE4zNRBcoShgo=QZ%2fEx5yJY0A8ndJsKvCRoEDvvmR9xRl%2bgiOk94RMFL1KIGVnwCky4w%3d%3d&amp;rUzwRPf%2bZ3zd4E7Ikn8Lyw%3d%3d=pwRE6AGJFLDNlh225F5QMaQWCtPHwdhUfCZ%2fLUQzgA2uL5jNRG4jdQ%3d%3d&amp;mCTIbCubSFfXsDGW9IXnlg%3d%3d=hFflUdN3100%3d&amp;kCx1AnS9%2fpWZQ40DXFvdEw%3d%3d=hFflUdN3100%3d&amp;uJovDxwdjMPoYv%2bAJvYtyA%3d%3d=ctNJFf55vVA%3d&amp;FgPlIEJYlotS%2bYGoBi5olA%3d%3d=NHdURQburHA%3d&amp;d9Qjj0ag1Pd993jsyOJqFvmyB7X0CSQK=ctNJFf55vVA%3d&amp;WGewmoAfeNR9xqBux0r1Q8Za60lavYmz=ctNJFf55vVA%3d&amp;WGewmoAfeNQ16B2MHuCpMRKZMwaG1PaO=ctNJFf55vVA%3d","draft":true},"findings_total":85,"news_drafts_total":3}}