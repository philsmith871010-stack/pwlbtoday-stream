mocracy.salford.gov.uk/documents/s91533/mm-school-budgets-2026-27-cabinet-report.pdf","committee":"Cabinet","date":"10/03/2026","key":true},{"title":"Treasury Management Q3 update Report for 2025-26 OSB v4","url":"https://sccdemocracy.salford.gov.uk/documents/s91382/treasury-management-q3-update-report-for-2025-26-osb-v4.pdf","committee":"Overview and Scrutiny Board","date":"04/03/2026","key":true},{"title":"SCC statement of accounts 2024-25 final AA 250226 (1)","url":"https://sccdemocracy.salford.gov.uk/documents/s91183/scc-statement-of-accounts-2024-25-final-aa-250226-1.pdf","committee":"Audit and Accounts Committee","date":"25/02/2026","key":true},{"title":"07b Capital Strategy and Programme 2026-27 - 2028-29","url":"https://sccdemocracy.salford.gov.uk/documents/s91195/07b-capital-strategy-and-programme-2026-27-2028-29.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07bii Appx A ROD Capital Programme 2627 to 2829","url":"https://sccdemocracy.salford.gov.uk/documents/s91166/07bii-appx-a-rod-capital-programme-2627-to-2829.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07e MTFS 2627 to 2829","url":"https://sccdemocracy.salford.gov.uk/documents/s91198/07e-mtfs-2627-to-2829.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07 Summary of proposed Revenue Budget 2026-27","url":"https://sccdemocracy.salford.gov.uk/documents/s91191/07-summary-of-proposed-revenue-budget-2026-27.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07a Revenue Budget 2026-27","url":"https://sccdemocracy.salford.gov.uk/documents/s91194/07a-revenue-budget-2026-27.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07aii Appx A Record of Decision (Cabinet) - Proposed 2026-27 Revenue Budget","url":"https://sccdemocracy.salford.gov.uk/documents/s91167/07aii-appx-a-record-of-decision-cabinet-proposed-2026-27-rev.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07f SCC Budget 2026-27 - Conservative Group Amendment","url":"https://sccdemocracy.salford.gov.uk/documents/s91201/07f-scc-budget-2026-27-conservative-group-amendment.pdf","committee":"Council","date":"25/02/2026","key":true},{"title":"07g SCC Budget 2026-27 - Liberal Democrat Group","url":"https://sccdemocracy.salford.gov.uk/documents/s91245/07g-scc-budget-2026-27-liberal-democrat-group.pdf","committee":"Council","date":"25/02/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-23","committee":"Audit and Accounts Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-23","committee":"Audit and Accounts Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-28","committee":"Growth & Prosperity Scrutiny Panel","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-07","committee":"Overview and Scrutiny Board","time":"2.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-07","committee":"Health and Adults Scrutiny Panel","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-13","committee":"Cabinet","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-14","committee":"Children's Scrutiny Panel","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-10-19","committee":"Community and Neighbourhoods Scrutiny Panel","time":"2.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"}],"recent":[{"date":"2026-09-08","committee":"Cabinet","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-09","committee":"Children's Scrutiny Panel","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-14","committee":"Community and Neighbourhoods Scrutiny Panel","time":"2.00 pm","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-16","committee":"Council","time":"9.30 am","status":"Confirmed","webcast":true,"url":"https://sccdemocracy.salford.gov.uk"},{"date":"2026-09-22","committee":"Cabinet","time":"10.00 am","status":"Confirmed","webcast":false,"url":"https://sccdemocracy.salford.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Salford misses accounts deadline for second year as auditors plan third disclaimer of opinion","lead":"Salford City Council has failed to publish its draft accounts for 2025/26, missing the 30 June statutory deadline by nearly three months. The council faced the same delay last year, when accounts were published on 25 September due to problems valuing its property, plant and equipment (long-lived assets such as buildings). Auditors plan to issue a disclaimer of opinion for the third consecutive year, meaning they will not have completed enough work to confirm the accounts are correct. The council's auditors have identified a new risk of significant weakness in how it manages statutory financial reporting. The council is transitioning to a new financial system during 2026/27, and auditors have engaged specialists to verify that data transfers correctly before the next audit begins.","iso":"2026-09-23","paper_title":"Salford City Council Audit Progress Report Sept 2026","paper_url":"https://salford.moderngov.co.uk/documents/s97289/97289.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Salford's cash reserves fall 32% as council relies more on internal borrowing","lead":"Salford's available investment balances fell from \u00a3106.2m to \u00a372.7m in the year to March 2026, a decline of nearly a third, while the council simultaneously increased its internal borrowing (using its own reserves to fund capital projects rather than taking loans) from \u00a3224.7m to \u00a3256.6m. The council attributes higher-than-forecast cash balances to slippage in its capital programme, with actual capital spending reaching only \u00a3103.9m against a forecast of \u00a3113.6m. The combination means the council is drawing down its liquidity cushion while depending more on its reserves to bridge the gap between planned spending and external borrowing. The council also holds \u00a3163m in LOBO loans, representing 59 per cent of its total external debt. During 2025-26, one lender exercised its option to propose a higher interest rate; the council declined multiple prepayment offers.\n\n---","iso":"2026-09-16","paper_title":"11 Treasury Management Annual Report 2025-26","paper_url":"https://salford.moderngov.co.uk/documents/s97038/97038.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-28","committee":"Growth & Prosperity Scrutiny Panel","paper_title":"Report - Q1 - Place Directorate budget report - LMB HAP","paper_url":"https://salford.moderngov.co.uk/documents/s97474/97474.pdf","headline":"Housing capital programme reprofs \u00a316.95m with acknowledged risks to future programme delivery from staffing","detail":"Housing Strategy and Enabling capital programme reduced by \u00a316.950m following review, reflecting 'revised cashflow forecasts while main contract arrangements are finalised.' The paper acknowledges broader capital programme risk: 'further likelihood of re-profiles... due to the scale, complexity, fluidity, and broad aspect of the portfolio' with specific risks from 'staff retention and recruitment, as well as interdependencies on third parties.'","category":"capital","matters":"Major capital reprofiling and acknowledged risks to delivery signal either slippage or reprioritisation of significant investment, with staffing constraints limiting delivery capacity.","figures":"\u00a316.950m net decrease to Housing Strategy and Enabling; in-year capital programme \u00a390.431m (approved \u00a399.997m, adjusted down \u00a39.566m)","quote":"Following a detailed review of the housing delivery programme, a net reduction of \u00a316.950m has been made. This reflects revised cashflow forecasts while main contract arrangements are finalised.","material":true},{"iso":"2026-09-28","committee":"Growth & Prosperity Scrutiny Panel","paper_title":"Report - Q1 - Place Directorate budget report - LMB HAP","paper_url":"https://salford.moderngov.co.uk/documents/s97474/97474.pdf","headline":"\u00a32.724m Q1 revenue overspend managed through planned reserve drawdown of \u00a35.085m","detail":"Place Directorate forecasts year-end revenue overspend of \u00a32.724m after drawing down \u00a35.085m from reserves. While reserves are within MTFP and no additional drawdown is flagged, the underlying overspend before reserves is \u00a37.809m, reflecting significant budget pressure. Reserves are being consumed to maintain budget.","category":"reserves","matters":"The council is drawing planned reserves to manage an overspend at Q1, consuming resources intended for flexibility or future priorities.","figures":"\u00a32.724m overspend after \u00a35.085m reserve drawdown; \u00a37.809m underlying overspend before reserves","quote":"The forecast outturn expenditure at Quarter 1 is an overspend of \u00a32.724m which includes an approved use of earmarked reserves of \u00a35.085m.","material":true},{"iso":"2026-09-28","committee":"Growth & Prosperity Scrutiny Panel","paper_title":"Report - Q1 - Place Directorate budget report - LMB HAP","paper_url":"https://salford.moderngov.co.uk/documents/s97474/97474.pdf","headline":"Leisure services \u00a30.900m overspend driving Cabinet-level escalation for Salford Community Leisure","detail":"Leisure Services forecasts \u00a30.900m overspend from 'ongoing financial support for Salford Community Leisure (SCL).' The paper states 'A Cabinet report is being prepared for August 2026', indicating this is a known structural issue escalated for senior decision-making and future strategy.","category":"overspend","matters":"An arm's length body requires material ongoing financial support and has been escalated to Cabinet, signalling either strategic uncertainty or structural deficits requiring policy decisions.","figures":"\u00a30.900m overspend in Leisure services attributed to Salford Community Leisure","quote":"Leisure Services is currently forecasting a \u00a30.900m overspend driven by ongoing financial support for Salford Community Leisure (SCL). A Cabinet report is being prepared for August 2026.","material":false},{"iso":"2026-09-28","committee":"Growth & Prosperity Scrutiny Panel","paper_title":"Report - Q1 - Place Directorate budget report - LMB HAP","paper_url":"https://salford.moderngov.co.uk/documents/s97474/97474.pdf","headline":"Commercial properties portfolio generating \u00a33.017m shortfall covered by reserve drawdown","detail":"The commercial portfolio forecasts a \u00a33.017m shortfall against budget at Q1, managed through the Incentive Reserve established to support the commercial operating model. The paper notes the drawdown 'aligns with the reserve's intended purpose', but the magnitude of shortfall at Q1 indicates material underperformance against commercial strategy assumptions.","category":"income","matters":"Commercial assets are underperforming budget expectations and requiring planned reserve use, raising questions about the soundness of commercial strategy assumptions.","figures":"\u00a33.017m shortfall in commercial properties covered by Incentive Reserve","quote":"A forecast shortfall within the commercial portfolio is being proactively managed through the approved use of the Incentive Reserve. This reserve was established to support the Council's commercial operating model through market fluctuations. The proposed drawdown of \u00a33.017m aligns with the reserve's intended purpose.","material":true},{"iso":"2026-09-28","committee":"Growth & Prosperity Scrutiny Panel","paper_title":"Report - Q1 - Place Directorate budget report - LMB HAP","paper_url":"https://salford.moderngov.co.uk/documents/s97474/97474.pdf","headline":"Housing service forecasts \u00a33.583m overspend and cannot deliver \u00a31.000m planned savings target","detail":"Housing transferred to Place Directorate mid-year and is experiencing leadership transition. It forecasts \u00a33.583m overspend from Housing Benefit Subsidy Loss and demand pressures in Supported Housing and Housing Options. The budgeted \u00a31.000m savings target is undeliverable: the service states it is 'not yet sufficiently embedded within the directorate to identify, develop and deliver sustainable savings of this scale without risking service performance' and will require 'further work' to develop a plan once new leadership is in place.","category":"overspend","matters":"A material \u00a318.7m service recently reorganized cannot deliver budgeted savings and is consuming reserves, requiring future transformation work of uncertain outcome.","figures":"\u00a33.583m overspend, \u00a31.759m reserve draw, net \u00a31.824m overspend after reserves; \u00a31.000m savings target at risk","quote":"the service is not yet sufficiently embedded within the directorate to identify, develop and deliver sustainable savings of this scale without risking service performance. It is therefore anticipated that further work will be required once the new leadership arrangements are in place to develop a robust and deliverable savings plan.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-23"},"name":"Salford","daily_post":{"iso":"2026-09-23","since_iso":"2026-08-24","distress":false,"headline":"Income generation scheme for scrap materials has control weaknesses at both council depots","lead":"A lender financing the council needs to assess whether budgeted income from revenue-raising schemes is reliable. Limited assurance findings in an income generation function suggest planned income may not be achieved and proper controls over cash handling\u2026","also":["49 other findings in this window","2 papers caught"],"watch":"Audit and Accounts Committee on 2026-09-23","n_findings":50,"n_documents":2,"top_paper_title":"Internal Audit Quarterly Progress Report July to Sept 26","top_paper_url":"https://salford.moderngov.co.uk/documents/s97288/97288.pdf","draft":true},"findings_total":121,"news_drafts_total":2}}