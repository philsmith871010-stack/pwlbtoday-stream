:[],"calendar":{"upcoming":[{"date":"2026-09-28","committee":"Audit, Governance and Standards Committee","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-09-30","committee":"Council","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-10-06","committee":"Climate Transition, Corporate and Environmental Services Policy Advisory Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-10-07","committee":"Planning and Healthier Stronger Communities Policy Advisory Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-10-13","committee":"Housing and Community Cohesion Policy Advisory Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-10-20","committee":"Overview & Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-10-21","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-11-03","committee":"Climate Transition, Corporate and Environmental Services Policy Advisory Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"}],"recent":[{"date":"2026-09-02","committee":"Planning and Healthier Stronger Communities Policy Advisory Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-09-03","committee":"Cabinet","time":"10.00 am","status":"Confirmed; Extraordinary","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-09-08","committee":"Housing and Community Cohesion Policy Advisory Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-09-09","committee":"Overview & Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"},{"date":"2026-09-16","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://services.maidstone.gov.uk/meetings"}]},"news":[],"news_drafts":[{"headline":"Financing costs ratio swung from negative to break-even, with investment income no longer offsetting borrowing costs.","lead":"This indicates the council's financial position is tightening. The loss of a cash cushion that previously offset borrowing costs signals either lower cash balances or declining investment returns, both relevant to financial resilience.","iso":"2026-07-27","paper_title":"Appendix B Treasury Management Annual Review 2025/26","paper_url":"https://maidstone.moderngov.co.uk/documents/s105641/105641.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"External debt increased by \u00a319.4m to \u00a384.074m following \u00a320m Aviva borrowing in February 2026.","lead":"The material increase in leverage and the timing of the borrowing decision are credit-relevant. A council borrowing more than its capital spending indicates either forward-funding strategy or cash-management concerns.","iso":"2026-07-27","paper_title":"Appendix B Treasury Management Annual Review 2025/26","paper_url":"https://maidstone.moderngov.co.uk/documents/s105641/105641.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Capital expenditure significantly underspent, delivering only \u00a334.532m against a forecast of \u00a341.375m.","lead":"Capital programme delivery is a key indicator of the council's ability to execute its financial plans. Consistent underperformance against forecast affects service investment and signals execution risk to lenders.","iso":"2026-07-27","paper_title":"Appendix B Treasury Management Annual Review 2025/26","paper_url":"https://maidstone.moderngov.co.uk/documents/s105641/105641.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-07-27","committee":"Audit, Governance and Standards Committee","paper_title":"Appendix B Treasury Management Annual Review 2025/26","paper_url":"https://maidstone.moderngov.co.uk/documents/s105641/105641.pdf","headline":"Financing costs ratio swung from negative to break-even, with investment income no longer offsetting borrowing costs.","detail":"The ratio of financing costs to net revenue stream shifted from -1.84% in 2024/25 (investment income exceeding borrowing costs by \u00a3635k) to 0.04% in 2025/26 (borrowing costs exceeding investment income by \u00a310k). The council went from having surplus cash returns to near-neutral on its net external financing position.","category":"other","matters":"This indicates the council's financial position is tightening. The loss of a cash cushion that previously offset borrowing costs signals either lower cash balances or declining investment returns, both relevant to financial resilience.","figures":"Ratio of Financing Costs to Net Revenue Stream: 2024/25 Actual (1.84)%, 2025/26 Actual 0.04%; in monetary terms: (\u00a3635k) to \u00a310k","quote":"Ratio of Financing Costs to Net Revenue Stream 2024/25 Actual (1.84)% 2025/26 Actual 0.04%","material":true},{"iso":"2026-07-27","committee":"Audit, Governance and Standards Committee","paper_title":"Appendix B Treasury Management Annual Review 2025/26","paper_url":"https://maidstone.moderngov.co.uk/documents/s105641/105641.pdf","headline":"External debt increased by \u00a319.4m to \u00a384.074m following \u00a320m Aviva borrowing in February 2026.","detail":"The council's total external debt rose from \u00a364.634m (2024/25) to \u00a384.074m (2025/26), driven by \u00a320m of Aviva borrowing received in February 2026. The statement that 'no further borrowing required during the year' suggests the borrowing was front-loaded. Yet capital spending underperformed by \u00a36.8m, meaning the council borrowed significantly in advance of deployment.","category":"borrowing","matters":"The material increase in leverage and the timing of the borrowing decision are credit-relevant. A council borrowing more than its capital spending indicates either forward-funding strategy or cash-management concerns.","figures":"External Debt 2024/25 \u00a364.634m, 2025/26 \u00a384.074m (increase \u00a319.44m); Aviva borrowing \u00a320m","quote":"\u00a320m Aviva borrowing was received in February 2026, however there was no further borrowing required during the year.","material":true},{"iso":"2026-07-27","committee":"Audit, Governance and Standards Committee","paper_title":"Appendix B Treasury Management Annual Review 2025/26","paper_url":"https://maidstone.moderngov.co.uk/documents/s105641/105641.pdf","headline":"Capital expenditure significantly underspent, delivering only \u00a334.532m against a forecast of \u00a341.375m.","detail":"The council's capital programme came in \u00a36.8m (16.6%) below forecast in 2025/26. This represents a material variance that could indicate either delivery challenges in the capital programme or over-optimistic forecasting. A council claiming to have a \u00a341.375m capital programme but only delivering \u00a334.532m is worth understanding.","category":"capital","matters":"Capital programme delivery is a key indicator of the council's ability to execute its financial plans. Consistent underperformance against forecast affects service investment and signals execution risk to lenders.","figures":"Capital Expenditure 2025/26: Estimate \u00a341.375m, Actual \u00a334.532m (\u00a36.843m or 16.6% shortfall)","quote":"Capital Expenditure 2025/26 Estimate \u00a341.375m Actual \u00a334.532m","material":true},{"iso":"2026-07-27","committee":"Audit, Governance and Standards Committee","paper_title":"Enc. 1 for Budget Risks","paper_url":"https://maidstone.moderngov.co.uk/documents/s105636/105636.pdf","headline":"Housing Investment Fund is under-resourced to deliver strategic affordable housing objective.","detail":"The quality housing programme, a key element of capital strategy, can only deliver approximately 240 units as currently resourced and requires ongoing revenue subsidy. The council's strategic housing objective is constrained by funding availability.","category":"capital","matters":"Shows strategic objective (affordable housing) is constrained by available resources; requires ongoing revenue support that competes with other services.","figures":"Impact range \u00a3200\u20131,000k (midpoint \u00a3600k); 50% likelihood; Weighted impact \u00a3300k; Currently funded for approximately 240 units only","quote":"The quality housing programme, a key element of the capital programme, can only deliver social/affordable housing with the support of a revenue subsidy through the Housing Investment Fund, which is currently only funded to deliver approximately 240 units.","material":true},{"iso":"2026-07-27","committee":"Audit, Governance and Standards Committee","paper_title":"Enc. 1 for Budget Risks","paper_url":"https://maidstone.moderngov.co.uk/documents/s105636/105636.pdf","headline":"General Fund reserves stand at \u00a317m at start of 2025/26, with \u00a34m minimum floor policy.","detail":"The council operates with unallocated reserves of \u00a317m, providing \u00a313m above the \u00a34m policy floor. This reserve cushion must cover unexpected costs, demographic shifts, and service pressures.","category":"reserves","matters":"Reserve position determines financial resilience and flexibility; \u00a313m above floor is modest buffer against the scale of identified risks (capital \u00a3675k, inflation \u00a3563k).","figures":"Unallocated General Fund reserves \u00a317 million (as at start of 2025/26); Lower limit floor \u00a34 million","quote":"At the beginning of the 2025/26 financial year unallocated General Fund reserves stood at \u00a317 million.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-07-27"},"name":"Maidstone","findings_total":109,"news_drafts_total":3}}