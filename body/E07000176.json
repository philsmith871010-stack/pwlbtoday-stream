acy.rushcliffe.gov.uk"},{"date":"2026-07-23","committee":"Communities Scrutiny Group","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.rushcliffe.gov.uk"},{"date":"2026-09-08","committee":"Cabinet","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.rushcliffe.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Staff recruitment and retention pressures increasing due to LGR uncertainty, driving up agency and recruitment costs","lead":"Rising staff costs during a period of budget constraint reduces flexibility to respond to other pressures and signals potential service delivery risk.","iso":"2026-07-14","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Gamston Community Hall income has failed to recover to pre-COVID levels, creating ongoing deficit","lead":"Failed demand recovery suggests revenue resilience may be weaker across council services than pre-pandemic, with implications for other income-generating services.","iso":"2026-07-14","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Multi-asset pooled fund investments \u00a30.749m below cost with statutory protection expiring 2028/29","lead":"Unrealised losses on investment portfolio will impact general fund after 2028/29 unless portfolio recovers, consuming reserves or requiring service cuts.","iso":"2026-07-14","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-07-14","committee":"Cabinet","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","headline":"Staff recruitment and retention pressures increasing due to LGR uncertainty, driving up agency and recruitment costs","detail":"Staff turnover and recruitment already challenging in local government sector and 'increasing due to the pressures and uncertainty around LGR'. Agency and recruitment costs are rising and pressuring pay budgets at a time when the council faces budget constraints and cannot easily absorb additional people costs.","category":"people","matters":"Rising staff costs during a period of budget constraint reduces flexibility to respond to other pressures and signals potential service delivery risk.","figures":"Not quantified","quote":"Staff turnover and recruitment continue to be challenging in the sector and this is increasing due to the pressures and uncertainty around LGR. Costs of recruitment and agency costs increase the pressure on the pay budgets","material":true},{"iso":"2026-07-14","committee":"Cabinet","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","headline":"Gamston Community Hall income has failed to recover to pre-COVID levels, creating ongoing deficit","detail":"West Bridgford Community Halls had an overspend of \u00a314.5k relating to income shortfall at Gamston, which 'has failed to return to pre-covid usage'. This contributed to the West Bridgford special expenses area running a deficit of \u00a30.089m, indicating persistent post-COVID demand recovery weakness in council facilities.","category":"demand","matters":"Failed demand recovery suggests revenue resilience may be weaker across council services than pre-pandemic, with implications for other income-generating services.","figures":"Gamston income shortfall \u00a314.5k, West Bridgford special expenses deficit \u00a30.089m","quote":"income shortfall at Gamston which has failed to return to pre-covid usage","material":true},{"iso":"2026-07-14","committee":"Cabinet","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","headline":"Multi-asset pooled fund investments \u00a30.749m below cost with statutory protection expiring 2028/29","detail":"Council's Multi Asset/Pooled Funds currently valued at \u00a314.3m, a reduction of \u00a30.749m against original investment and below purchase price. Statutory override currently prevents these losses being charged to general fund but extends only until 2028/29. Council holds \u00a31.31m reserve to mitigate future impact but protection window is closing.","category":"other","matters":"Unrealised losses on investment portfolio will impact general fund after 2028/29 unless portfolio recovers, consuming reserves or requiring service cuts.","figures":"\u00a30.749m reduction against original investment, current value \u00a314.3m, mitigation reserve \u00a31.31m, statutory override expires 2028/29","quote":"as at 31 March 2026 this was \u00a314.3m a reduction of \u00a30.749m against the original investment... statutory override (extended to 2028/29) which prevents this being charged to the general fund","material":true},{"iso":"2026-07-14","committee":"Cabinet","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","headline":"Business rates reform has reduced core funding income with only short-term transition funding","detail":"Business rates reset and fairer funding reforms have resulted in reduction in council income. Transition funding is stated to be only short term, providing no permanent replacement for the lost income. This represents a structural reduction in core funding source.","category":"income","matters":"Structural reduction in primary council funding source with no permanent replacement creates baseline budget pressure for all future years.","figures":"Not quantified in detail","quote":"Business rates reset and fairer funding reforms have resulted in a reduction in income for the Council and transition funding is only short term","material":true},{"iso":"2026-07-14","committee":"Cabinet","paper_title":"Financial Outturn 2025-26","paper_url":"https://democracy.rushcliffe.gov.uk/documents/s19522/19522.pdf","headline":"Local Government Reorganisation from April 2028 with financial implications acknowledged as significant but unknown","detail":"Unitary councils expected operational from 1 April 2028. Council awaiting decision on preferred option (expected July 2026). Council states that financial implications and impact on staff retention 'remain largely unknown but are expected to be significant'. Costs to end March 2026 total \u00a30.220m (\u00a30.123m government funded); \u00a30.635m further approved from 2025/26 underspends bringing reserve to \u00a31.199m, but future implementation costs unquantified.","category":"governance","matters":"A major transformation during constrained financial period with acknowledged unknown costs and confirmed staff retention risks that will pressure pay budgets during transition.","figures":"\u00a30.220m spent to end March 2026, \u00a31.199m reserve balance, costs described as 'significant' and 'largely unknown'","quote":"The financial implications of implementation, together with the impact on staff attraction and retention during the transition period, remain largely unknown but are expected to be significant","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-07-14"},"name":"Rushcliffe","findings_total":69,"news_drafts_total":3}}