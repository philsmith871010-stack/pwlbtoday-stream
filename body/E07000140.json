"2026-11-12","committee":"Governance and Audit Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.sholland.gov.uk"}],"recent":[{"date":"2026-07-02","committee":"Governance and Audit Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.sholland.gov.uk"},{"date":"2026-07-15","committee":"South Holland District Council","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.sholland.gov.uk"},{"date":"2026-09-09","committee":"Policy Development Panel","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.sholland.gov.uk"},{"date":"2026-09-10","committee":"Governance and Audit Committee","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.sholland.gov.uk"},{"date":"2026-09-15","committee":"Joint Performance Monitoring Panel and Policy Development Panel","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democracy.sholland.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Housing Revenue Account executed early repayment of borrowing, generating a \u00a3458,032 discount","lead":"Early debt repayment demonstrates the HRA's financial flexibility and capacity to manage long-term housing funding, which signals long-term sustainability and lender confidence","iso":"2026-09-10","paper_title":"2026/27 Q1 Treasury Update","paper_url":"https://democracy.sholland.gov.uk/documents/s48064/48064.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Capital programme slippage from 2025/26 into 2026/27 has left the council with higher cash balances for investment","lead":"Capital programme delays affect the council's ability to deliver strategic objectives and can signal delivery, planning, or resource constraints","iso":"2026-09-10","paper_title":"2026/27 Q1 Treasury Update","paper_url":"https://democracy.sholland.gov.uk/documents/s48064/48064.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"South Holland Local Housing CIC fair value exceeds cost by 12,780 times","lead":"Large unexplained fair value movements on subsidiary equity raise questions about valuation methodology and asset substance; for a lender assessing Council financial position, the real value of these holdings matters","iso":"2026-09-10","paper_title":"Appendix 1 for 2026/27 Q1 Treasury Update","paper_url":"https://democracy.sholland.gov.uk/documents/s48065/48065.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-09-10","committee":"Governance and Audit Committee","paper_title":"2026/27 Q1 Treasury Update","paper_url":"https://democracy.sholland.gov.uk/documents/s48064/48064.pdf","headline":"Housing Revenue Account executed early repayment of borrowing, generating a \u00a3458,032 discount","detail":"The HRA repaid some of its borrowing before the scheduled maturity date and received a \u00a3458,032 discount. This demonstrates the HRA's capacity to generate surplus cash and manage its debt opportunistically. The HRA also outperformed budget on interest payable by \u00a320,810 in Q1.","category":"borrowing","matters":"Early debt repayment demonstrates the HRA's financial flexibility and capacity to manage long-term housing funding, which signals long-term sustainability and lender confidence","figures":"Discount on premature repayment \u00a3458,032; HRA Interest Payable variance \u00a320,810 favorable (actual \u00a3564,449 vs budget \u00a3585,259)","quote":"HRA discount received on premature repayment of borrowing and brokers fees","material":true},{"iso":"2026-09-10","committee":"Governance and Audit Committee","paper_title":"2026/27 Q1 Treasury Update","paper_url":"https://democracy.sholland.gov.uk/documents/s48064/48064.pdf","headline":"Capital programme slippage from 2025/26 into 2026/27 has left the council with higher cash balances for investment","detail":"The council's capital spending has not followed the planned 2025/26 schedule, with spending rolling into 2026/27. This slippage left the council with \u00a3606,738 more cash available for investment than budgeted for the year. The paper does not explain what caused the capital programme to slip or when it is expected to catch up.","category":"capital","matters":"Capital programme delays affect the council's ability to deliver strategic objectives and can signal delivery, planning, or resource constraints","figures":"Forecast investment income variance \u00a3606,738 favorable to budget; total capital programme slippage not quantified in main report","quote":"balances available for investment being higher due to slippage in the capital programme from 2025/26","material":true},{"iso":"2026-09-10","committee":"Governance and Audit Committee","paper_title":"Appendix 1 for 2026/27 Q1 Treasury Update","paper_url":"https://democracy.sholland.gov.uk/documents/s48065/48065.pdf","headline":"South Holland Local Housing CIC fair value exceeds cost by 12,780 times","detail":"The South Holland Local Housing Community Interest Company is shown with equity cost of \u00a3100 but fair value of \u00a31,278,077 as of 31 March 2026. No explanation is provided for how this valuation was derived or what asset backs it.","category":"other","matters":"Large unexplained fair value movements on subsidiary equity raise questions about valuation methodology and asset substance; for a lender assessing Council financial position, the real value of these holdings matters","figures":"Cost \u00a3100; Fair value \u00a31,278,077","quote":"South Holland Local Housing Community Interest Company 100 1,278,077","material":true},{"iso":"2026-09-10","committee":"Governance and Audit Committee","paper_title":"Appendix 1 for 2026/27 Q1 Treasury Update","paper_url":"https://democracy.sholland.gov.uk/documents/s48065/48065.pdf","headline":"UK Municipal Bond Agency equity investment written down to zero","detail":"The Council's \u00a350,000 equity investment in the UK Municipal Bond Agency is recorded at zero fair value as of 31 March 2026. The paper provides no explanation for when or why this write-down occurred.","category":"other","matters":"Investment write-downs without explanation indicate either failed investment vehicles or poor Council decision-making; a lender would want to understand what this signals about investment governance","figures":"Cost \u00a350,000; Fair value \u00a30","quote":"UK Municipal Bond Agency 50,000 0","material":false},{"iso":"2026-09-10","committee":"Governance and Audit Committee","paper_title":"Internal Audit September 26 SHDC Progress Report","paper_url":"https://democracy.sholland.gov.uk/documents/s48082/48082.pdf","headline":"Financial Skills, Capacity & Management audit issued three months late; identifies four medium findings on finance team capacity and capability","detail":"The Financial Skills, Capacity & Management audit was due in December 2025 but the draft was not issued until March 2026, suggesting significant delay. The audit identified four medium findings on financial team capacity and skills.","category":"people","matters":"If the finance team lacks capacity or skills, the council may struggle to deliver financial control, reporting, and forecasting. A lender needs confidence that the finance function is adequately resourced.","figures":"4 Medium and 1 Low findings","quote":"Financial Skills, Capacity & Management December 2025(Draft issued March 2026) 4 Medium and 1 Low","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-10"},"name":"South Holland","daily_post":{"iso":"2026-09-20","since_iso":"2026-08-21","distress":false,"headline":"Housing Revenue Account executed early repayment of borrowing, generating a \u00a3458,032 discount","lead":"Early debt repayment demonstrates the HRA's financial flexibility and capacity to manage long-term housing funding, which signals long-term sustainability and lender confidence","also":["8 other findings in this window"],"watch":"Cabinet on 2026-09-29","n_findings":9,"n_documents":0,"top_paper_title":"2026/27 Q1 Treasury Update","top_paper_url":"https://democracy.sholland.gov.uk/documents/s48064/48064.pdf","draft":true},"findings_total":59,"news_drafts_total":3}}