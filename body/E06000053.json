ents":[{"title":"Appendix C Project Evaluation Report","url":"http://committees.scilly.gov.uk/documents/s32360/appendix-c-project-evaluation-report.pdf","committee":"FULL COUNCIL","date":"18/06/2026","key":true},{"title":"Appendix B Learner Evaluation Report 2024-25","url":"http://committees.scilly.gov.uk/documents/s32187/appendix-b-learner-evaluation-report-2024-25.pdf","committee":"Scrutiny Committee","date":"23/04/2026","key":true},{"title":"Budget report 2026-27 v1","url":"http://committees.scilly.gov.uk/documents/s32126/budget-report-2026-27-v1.pdf","committee":"FULL COUNCIL","date":"10/03/2026","key":true},{"title":"Statement of Accounts and AGS Report 2024-25","url":"http://committees.scilly.gov.uk/documents/s32017/statement-of-accounts-and-ags-report-2024-25.pdf","committee":"FULL COUNCIL","date":"27/01/2026","key":true},{"title":"Appendix 1 Statement of Accounts 2024-25 to Full Council 27.1.26","url":"http://committees.scilly.gov.uk/documents/s32018/appendix-1-statement-of-accounts-2024-25-to-full-council-27.pdf","committee":"FULL COUNCIL","date":"27/01/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-10-01","committee":"Scrutiny Committee","time":"10.45 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"},{"date":"2026-10-15","committee":"FULL COUNCIL","time":"10.45 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"},{"date":"2026-11-05","committee":"Governance Committee","time":"10.45 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"},{"date":"2026-11-19","committee":"FULL COUNCIL","time":"10.45 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"}],"recent":[{"date":"2026-06-10","committee":"Governance Committee","time":"11.00 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"},{"date":"2026-06-12","committee":"Scrutiny Committee","time":"10.45 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"},{"date":"2026-06-18","committee":"FULL COUNCIL","time":"10.45 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"},{"date":"2026-07-30","committee":"FULL COUNCIL","time":"10.45 am","status":"Moved","webcast":false,"url":"https://committees.scilly.gov.uk"},{"date":"2026-09-24","committee":"FULL COUNCIL","time":"10.45 am","status":"Confirmed","webcast":false,"url":"https://committees.scilly.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Culture Centre project amber-rated with cost pressures and funding application pending","lead":"A large capital project representing 14% of the annual programme with amber status and known cost pressures suggests delivery and value-for-money risks. The need for additional funding after compensation events indicates the project may not be fully\u2026","iso":"2026-07-30","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Supplier payment performance falling below statutory targets across all metrics","lead":"Poor payment performance indicates either cash flow constraints or process control weaknesses. For a small council, consistent failure to meet statutory payment targets suggests systemic operational issues that could affect supplier relationships and the\u2026","iso":"2026-07-30","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Airport income shortfall due to Skybus passenger numbers 30% below budget","lead":"The airport is a key income generator for a small island council. A 30% passenger shortfall in Q1 suggests either structural demand issues or a temporary seasonal effect, but either way represents material income risk that cannot be made up through cost\u2026","iso":"2026-07-30","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-07-30","committee":"FULL COUNCIL","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","headline":"Culture Centre project amber-rated with cost pressures and funding application pending","detail":"The \u00a36.7 million Culture Centre project is rated AMBER with key risks including programme slippage, cost pressures, and coordination challenges. The council has submitted an application for additional National Lottery Heritage Fund (NLHF) support following clearance of previous compensation events and cost uplifts. Completion is now planned for 28 April 2027, with enhanced scrutiny and contingency management ongoing.","category":"capital","matters":"A large capital project representing 14% of the annual programme with amber status and known cost pressures suggests delivery and value-for-money risks. The need for additional funding after compensation events indicates the project may not be fully controlled or scoped.","figures":"\u00a36.7m Museum & Culture Centre project spend to date (17% of approved budget); total programme \u00a347.7m; additional NLHF funding sought","quote":"RAG status remained AMBER, with key risks including programme slippage, cost pressures linked to extension, coordination with fit-out, and operational readiness alignment.","material":true},{"iso":"2026-07-30","committee":"FULL COUNCIL","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","headline":"Supplier payment performance falling below statutory targets across all metrics","detail":"The council's payment performance in Q1 fell below target across all indicators: only 86.5% of invoices paid within 30 days (target 92%), only 84.46% of local SME payments made within 30 days (target 95%), and only 69.59% paid within 14 days (target 75%). Of 148 local SME invoices, 23 were paid outside the 30-day target. The council acknowledges that a review of processes and staff training is needed.","category":"governance","matters":"Poor payment performance indicates either cash flow constraints or process control weaknesses. For a small council, consistent failure to meet statutory payment targets suggests systemic operational issues that could affect supplier relationships and the local economy. This is also a governance and compliance concern.","figures":"86.5% vs 92% target for 30-day payments; 84.46% vs 95% target for local SME 30-day payments; 69.59% vs 75% for 14-day SME payments; 23 of 148 SME invoices paid late","quote":"For the period April to June 2026, the Council processed 200 invoices, of which 173 were paid within the 30-day payment target. Of these invoices, 148 related to local SME suppliers. For local SME invoices, 103 were paid within 14 days and 125 were paid within 30 days, meaning 23 local SME invoices were paid outside the 30-day target.","material":true},{"iso":"2026-07-30","committee":"FULL COUNCIL","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","headline":"Airport income shortfall due to Skybus passenger numbers 30% below budget","detail":"The airport is forecasting an overspend of \u00a355,439, driven by Skybus passenger numbers being significantly lower than budgeted (approximately 30% below forecast). This is directly impacting income, with actual Q1 passenger volumes of 14,733 against a budget of 21,100. Despite some underspend on expenditure, the income shortfall is not being fully offset.","category":"income","matters":"The airport is a key income generator for a small island council. A 30% passenger shortfall in Q1 suggests either structural demand issues or a temporary seasonal effect, but either way represents material income risk that cannot be made up through cost control alone.","figures":"Q1 actual 14,733 Skybus passengers vs budget 21,100 (approximately 30% lower); \u00a355,439 forecast overspend","quote":"Airport \u00a355,439 overspend \u2013 passenger numbers are significantly lower than budget for Skybus (c30% lower), which is impacting income.","material":true},{"iso":"2026-07-30","committee":"FULL COUNCIL","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","headline":"Adult Social Care overspend with savings delivery plans still in development","detail":"Adult services is overspending by \u00a3180,964 due to transition costs to a new care home and high agency staff costs. The forecast assumes planned savings will be delivered, but the council is only in the process of continuing to develop action plans. The savings plan includes multiple red-flagged items (\u00a3100,000 for changing care criteria, \u00a360,000 for reassessing financial assessments, \u00a320,000 for care plan reviews) indicating execution risk.","category":"overspend","matters":"A critical service with a major overspend that depends entirely on unproven savings plans being delivered mid-year. This is a high-risk item in a small council's budget. If savings do not materialise, the overspend will exceed the contingency buffer.","figures":"\u00a3180,964 overspend; \u00a3110,000 + \u00a3200,000 + \u00a335,000 in amber-flagged adult care savings; multiple \u00a320,000-\u00a3100,000 red-flagged items","quote":"Adult Social Care overspend of \u00a3180,964 \u2013 primarily due to the transition costs of moving across to the new care home and continued increased cost of employing agency workers. The forecast assumes that saving delivery plans will be delivered in the current financial year, the service is continuing to develop action plans to deliver the savings and a further update on progress against the plans will need to be provided as part of the quarter 2 reporting.","material":true},{"iso":"2026-07-30","committee":"FULL COUNCIL","paper_title":"1st Quarter 26-27 Finance report to members","paper_url":"http://committees.scilly.gov.uk/documents/s32417/32417.pdf","headline":"Pay award dispute unresolved with additional cost pressure factored in","detail":"The council budgeted a 3% pay award but received a 3.3% offer from National Employers. Trade unions rejected this offer and negotiations remain ongoing. The council has already factored the higher 3.3% into its forecast, adding approximately \u00a323,000 to costs. The uncertainty around final settlement presents risk of further cost pressures.","category":"overspend","matters":"Unresolved pay disputes can escalate costs beyond the current forecast, particularly in a small council where payroll is a significant proportion of budget, and could also lead to industrial action affecting service delivery.","figures":"3% budgeted vs 3.3% offered; c.\u00a323,000 impact already factored","quote":"The budgeted pay award for 2026-27 was 3%, however the National Employers have made a full and final offer of a 3.3% increase on all NJC pay points and allowances with effect from 1 April 2026. This offer was rejected by the trade unions and negotiations remain unresolved.","material":false}],"editorial":null,"freshness":{"last_paper_iso":"2026-07-30"},"name":"Isles of Scilly","findings_total":63,"news_drafts_total":3}}