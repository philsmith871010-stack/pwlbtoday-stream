lendar":{"upcoming":[{"date":"2026-09-30","committee":"Standing Advisory Council for Religious Education","time":"7.30 pm","status":"Confirmed","webcast":false,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-10-01","committee":"Council","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-10-15","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-10-22","committee":"Pension Board","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-11-04","committee":"Standing Advisory Council for Religious Education","time":"4.30 pm","status":"New; Moved from 30 Sep 2026","webcast":false,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-11-10","committee":"Overview and Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-11-12","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-11-16","committee":"Pension Fund Committee","time":"6.30 pm","status":"Postponed","webcast":true,"url":"https://moderngov.harrow.gov.uk"}],"recent":[{"date":"2026-07-30","committee":"Pension Board","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-07","committee":"Pension Fund Committee","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-09","committee":"Planning Policy Advisory Panel","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-10","committee":"Overview and Scrutiny Committee","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"},{"date":"2026-09-24","committee":"Cabinet","time":"6.30 pm","status":"Confirmed","webcast":true,"url":"https://moderngov.harrow.gov.uk"}]},"news":[],"news_drafts":[{"headline":"Harrow faces \u00a33m overspend as temporary accommodation and children's care costs surge","lead":"Harrow Council is forecasting a net overspend of \u00a33.039m for the current financial year after planned use of reserves, according to figures presented to cabinet on Wednesday. The shortfall is driven by two structural pressures: temporary accommodation for homeless households, which is costing the council \u00a315.7m a year more than government subsidy covers, and children's services placements, where 25 children in residential homes at an average \u00a37,000 per week are creating a \u00a37.249m overspend. The council has approved a savings programme of \u00a34.062m for the year, but nearly half of those savings depend on completing capital projects\u2014acquiring 50 new homes for temporary housing, selling properties at Sheldon House, and investing in residential care provision\u2014that are rated as at-risk and may not deliver on schedule.","iso":"2026-09-24","paper_title":"Appendix 2 - 2026-27 MTFS Tracker","paper_url":"https://harrow.moderngov.co.uk/documents/s201854/201854.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Harrow Council forecasts \u00a33m overspend on day-to-day spending for current year","lead":"Harrow Council's Cabinet was told on Thursday that the authority is forecasting a net overspend of \u00a33.039m on its revenue spending (day-to-day running costs) for 2026-27, which would consume its budget planning reserves if not contained by year-end. The largest single pressure is temporary accommodation for homeless households, where demand has tripled in three years to 726 households, creating a \u00a315.7m annual subsidy loss as government funding falls short of market costs. Children's services is overspending by \u00a37.2m, driven chiefly by residential placements at average costs of \u00a37,000 per week, while schools-related funding has a \u00a354.2m accumulated deficit that grows by \u00a324.6m this year. The council is relying on government support to cover 90 per cent of that deficit, though approval of its special educational needs reform plan remains conditional. The Cabinet also approved a savings programme of \u00a34.062m, but nearly half depends on capital projects succeeding.","iso":"2026-09-24","paper_title":"Appendix 2 - 2026-27 MTFS Tracker","paper_url":"https://harrow.moderngov.co.uk/documents/s201854/201854.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-10-01","committee":"Council","paper_title":"2.1 Appx 1 Draft Annual Report of the Pension Board 25-26, 30/07/2026 Pension Board","paper_url":"https://harrow.moderngov.co.uk/documents/s202122/202122.pdf","headline":"The Board has expressed concern about the investment performance of some appointed fund managers relative to their benchmarks.","detail":"The Board is concerned about the relative performance of some investment managers and has asked that the Pension Fund Committee push managers (through the London Collective Investment Vehicle and otherwise) to improve performance against their benchmarks.","category":"other","matters":"Underperformance of the pension fund increases the employer's (council's) future contribution requirements, raising budget obligations.","figures":"Specific performance gaps not quantified in report","quote":"We have expressed concern about the relative performance of some of the appointed investment managers and continue to ask that the Pension Fund Committee push investment managers, whether through the LCIV or otherwise, to improve performance against their benchmarks.","material":true},{"iso":"2026-10-01","committee":"Council","paper_title":"2.1 Appx 1 Draft Annual Report of the Pension Board 25-26, 30/07/2026 Pension Board","paper_url":"https://harrow.moderngov.co.uk/documents/s202122/202122.pdf","headline":"The pension administration team has lost key personnel and struggled to meet performance standards, with restructuring and training plans now in place.","detail":"The Board expressed concern about administration team performance measured through KPIs. After losing key personnel, the team struggled to meet expectations. The administration team has undergone significant restructuring, including creation of a new pensions administration manager role, with training plans implemented for 2025-26. The Board will continue to monitor.","category":"people","matters":"Failures in pension administration (missed deadlines, processing errors, regulatory breaches) could trigger enforcement action and financial penalties.","figures":"New pensions administration manager role created; team restructured","quote":"after the loss of key personnel the team has struggled to meet KPI expectations. The team has undergone significant restructuring and training plans have been put in place to improve the resilience and the performance of the team in 2025-26.","material":true},{"iso":"2026-10-01","committee":"Council","paper_title":"2.1 Appx 1 Draft Annual Report of the Pension Board 25-26, 30/07/2026 Pension Board","paper_url":"https://harrow.moderngov.co.uk/documents/s202122/202122.pdf","headline":"The Board has not completed a required review of the fund's compliance with the Pensions Regulator's Code of Practice due to insufficient meetings.","detail":"The Board was asked to consider the outputs of a review into compliance with the Pensions Regulator's Code of Practice. The Board met only twice in 2025-26 (31 July 2025 and 4 November 2025), preventing this review from happening. The Pension Regulator expects LGPS Pension Boards to meet four times per year.","category":"governance","matters":"Failure to complete a required compliance review leaves the council exposed to unidentified regulatory risks and potential enforcement action by the Pensions Regulator.","figures":"2 meetings held; 4 expected by regulator","quote":"The committee asked the board to consider in detail the outputs of the review into the fund's compliance with the Pensions Regulators Code of Practise and the failure to hold two meetings since November 2025 has meant this has not happened.","material":true},{"iso":"2026-10-01","committee":"Council","paper_title":"Recommendation to Council - Pension Board - 30 July 26","paper_url":"https://harrow.moderngov.co.uk/documents/s202120/202120.pdf","headline":"Vacant board position filled for 2026-27, addressing the underlying cause of quorum failures","detail":"The previously vacant position on the Pension Board has been filled for the 2026-27 municipal year, meaning all board seats are now filled. This directly addresses the cause of the prior year's quorum failures.","category":"governance","matters":"Full board capacity should enable completion of delayed compliance work and improve pension fund governance oversight going forward","figures":"All board seats filled for 2026/27","quote":"The vacant position on the Pension Board had been filled for the 2026-27 Municipal Year, which meant that the Board had all seats filled for 2026/27.","material":true},{"iso":"2026-10-01","committee":"Council","paper_title":"Recommendation to Council - Pension Board - 30 July 26","paper_url":"https://harrow.moderngov.co.uk/documents/s202120/202120.pdf","headline":"Pension Board only met twice in the year; two scheduled meetings failed due to quorum issues, leaving compliance review work incomplete","detail":"The Pension Board held only two meetings due to two scheduled meetings being inquorate and unable to proceed. Board members noted this was disappointing. As a result, a compliance review relating to the general code of practice that had been delegated to the Pension Board remains incomplete.","category":"governance","matters":"Governance failures in pension fund administration indicate weakness in the council's oversight of its significant pension liabilities","figures":"Board met only twice; two meetings were inquorate","quote":"The Board had only met twice; two meetings were inquorate and therefore unable to proceed. Board Members commented that this was disappointing.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-09-24"},"name":"Harrow","daily_post":{"iso":"2026-09-25","since_iso":"2026-08-26","distress":false,"headline":"Sancroft Community Care recovering from temporary refurbishment disruption and returning to profitability while expanding bed capacity.","lead":"Shows operational recovery and capacity expansion aligned with local needs, though audit of prior year accounts is still pending and may reveal issues.","also":["37 other findings in this window"],"watch":"Cabinet on 2026-10-15","n_findings":38,"n_documents":0,"top_paper_title":"Appendix 4 - Trading Company Update as at Quarter 1 2026-27","top_paper_url":"https://harrow.moderngov.co.uk/documents/s201856/201856.pdf","draft":true},"findings_total":119,"news_drafts_total":2}}