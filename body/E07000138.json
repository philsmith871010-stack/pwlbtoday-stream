:true},{"title":"Appendix A - Treasury Management Strategy 2026-27 - FINAL","url":"https://democratic.lincoln.gov.uk/documents/s78935/appendix-a-treasury-management-strategy-2026-27-final.pdf","committee":"Executive","date":"24/02/2026","key":true}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-21","committee":"Audit Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-09-22","committee":"Council","time":"6.30 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-09-23","committee":"Housing Scrutiny Sub-Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-09-24","committee":"Performance Scrutiny Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-09-29","committee":"Community Leadership Scrutiny Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-09-29","committee":"Select Scrutiny Committee","time":"6.00 pm","status":"Confirmed; Acting as Crime and Disorder Committee","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-10-06","committee":"Policy Scrutiny Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-10-13","committee":"Executive","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"}],"recent":[{"date":"2026-08-11","committee":"Policy Scrutiny Committee","time":"6.00 pm","status":"Cancelled","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-08-13","committee":"Performance Scrutiny Committee","time":"6.00 pm","status":"Confirmed; Quarterly Reports","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-08-17","committee":"Housing Scrutiny Sub-Committee","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-08-18","committee":"Executive","time":"6.00 pm","status":"Confirmed; Quarterly Reports","webcast":false,"url":"https://democratic.lincoln.gov.uk"},{"date":"2026-09-15","committee":"Executive","time":"6.00 pm","status":"Confirmed","webcast":false,"url":"https://democratic.lincoln.gov.uk"}]},"news":[],"news_drafts":[{"headline":"HRA further borrowing is anticipated, with HRA financing costs at 30.64% of revenue - substantially higher than General Fund at 15.18%.","lead":"HRA borrowing is often constrained by rent-setting limits and welfare benefit caps. At 30.64% financing costs to revenue, the HRA has limited flexibility; anticipated further borrowing will tighten position further.","iso":"2026-08-18","paper_title":"Treasury Management Q1 26.27 Exec","paper_url":"https://lincoln.moderngov.co.uk/documents/s80928/80928.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Council has \u00a342m under-borrowing against its Capital Financing Requirement, with additional borrowing deferred to end of financial year.","lead":"A lender needs to understand borrowing trajectory. Deferred \u00a342m borrowing suggests either strong cash position or intentional rate timing; the deferral to year-end creates lumpy refinancing risk if rates move.","iso":"2026-08-18","paper_title":"Treasury Management Q1 26.27 Exec","paper_url":"https://lincoln.moderngov.co.uk/documents/s80928/80928.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"HRA Rental income deficit from rising voids not fully offset by stock growth","lead":"Rising void levels in HRA reduce rental income and suggest either lettability problems, turnover delays, or stock management issues. This is a leading indicator of deeper housing portfolio problems.","iso":"2026-08-18","paper_title":"Q1 Monitoring Report - EXEC last blank page deleted","paper_url":"https://lincoln.moderngov.co.uk/documents/s80962/80962.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-08-18","committee":"Executive","paper_title":"Treasury Management Q1 26.27 Exec","paper_url":"https://lincoln.moderngov.co.uk/documents/s80928/80928.pdf","headline":"HRA further borrowing is anticipated, with HRA financing costs at 30.64% of revenue - substantially higher than General Fund at 15.18%.","detail":"The paper explicitly notes 'Further borrowing is anticipated and will be reported as part of the MTFS and Treasury Management Strategy' for the Housing Revenue Account. The HRA CFR is \u00a380.484m and financing costs consume 30.64% of HRA net revenue, compared to 15.18% for the General Fund, indicating significant debt servicing pressure.","category":"borrowing","matters":"HRA borrowing is often constrained by rent-setting limits and welfare benefit caps. At 30.64% financing costs to revenue, the HRA has limited flexibility; anticipated further borrowing will tighten position further.","figures":"HRA financing costs 30.64% of net revenue stream; General Fund 15.18%; HRA CFR \u00a380.484m vs General Fund CFR \u00a379.948m","quote":"The HRA borrowing requirement is considered independently from that of the General Fund. Further borrowing is anticipated and will be reported as part of the MTFS and Treasury Management Strategy.","material":true},{"iso":"2026-08-18","committee":"Executive","paper_title":"Treasury Management Q1 26.27 Exec","paper_url":"https://lincoln.moderngov.co.uk/documents/s80928/80928.pdf","headline":"Council has \u00a342m under-borrowing against its Capital Financing Requirement, with additional borrowing deferred to end of financial year.","detail":"The Council's CFR is \u00a3160.432m but actual external debt is \u00a3118.395m, leaving \u00a342.037m under-borrowed. Officers are using internal cash reserves rather than borrowing currently, with plans to borrow 'inline with the Councils cashflow and spending requirements'. Capital expenditure has been revised upward to \u00a354.508m, a 61% increase from the original estimate.","category":"borrowing","matters":"A lender needs to understand borrowing trajectory. Deferred \u00a342m borrowing suggests either strong cash position or intentional rate timing; the deferral to year-end creates lumpy refinancing risk if rates move.","figures":"CFR \u00a3160.432m, actual debt \u00a3118.395m, under-borrowing \u00a342.037m; capital expenditure revised to \u00a354.508m from original \u00a333.662m","quote":"Currently forecasting actual external debt at year end to be inline with the original budget, albeit additional borrowing pushed to the end of the financial year.","material":true},{"iso":"2026-08-18","committee":"Executive","paper_title":"Q1 Monitoring Report - EXEC last blank page deleted","paper_url":"https://lincoln.moderngov.co.uk/documents/s80962/80962.pdf","headline":"HRA Rental income deficit from rising voids not fully offset by stock growth","detail":"HRA rental income is forecast at \u00a358k shortfall due to increased void numbers, only partially offset by higher opening stock than budgeted (\u00a329.8k gain). This indicates turnover/letting issues in the housing stock that are creating income loss.","category":"income","matters":"Rising void levels in HRA reduce rental income and suggest either lettability problems, turnover delays, or stock management issues. This is a leading indicator of deeper housing portfolio problems.","figures":"\u00a358k rental income shortfall from voids; \u00a329.8k gain from higher opening stock","quote":"Rental income deficit due to increased level of void numbers within housing stock, partially offset by increased rental income...Opening housing stock level higher than budgeted.","material":false},{"iso":"2026-08-18","committee":"Executive","paper_title":"Q1 Monitoring Report - EXEC last blank page deleted","paper_url":"https://lincoln.moderngov.co.uk/documents/s80962/80962.pdf","headline":"Income forecasts flagged as subject to significant uncertainty across General Fund","detail":"The council explicitly states concern about 'our ability to achieve income forecasts' and that the General Fund remains 'subject to a level of uncertainty' around service demands and income. This applies to multiple income streams where budgets assume continued performance despite market pressures (crematorium, car parking, building regulations, leisure).","category":"income","matters":"A council expressing concern about income forecast reliability suggests either conservative budgeting or genuine risk that actual income will be lower than assumed.","figures":"General Fund forecast variance to date is \u00a364k underspend, but with 'concern about our ability to achieve income forecasts'","quote":"While the forecast outturn for the General Fund is currently a budget underspend, there still remains uncertainty in terms of service demands and concern about our ability to achieve income forecasts. As such the final outturn position for the year is still subject to further change and will continue to be carefully monitored.","material":false},{"iso":"2026-08-18","committee":"Executive","paper_title":"Q1 Monitoring Report - EXEC last blank page deleted","paper_url":"https://lincoln.moderngov.co.uk/documents/s80962/80962.pdf","headline":"General Fund relying on one-off non-recurrent business rates transitional relief","detail":"The General Fund's forecast position includes \u00a3193.7k from one-off transitional business rates relief following the 2026 revaluation. The council explicitly labels this 'a non-recurrent benefit this year' and is using it for revenue contributions to capital to avoid borrowing. This masks underlying structural position and will not be available next year.","category":"income","matters":"One-off reliefs inflate apparent financial flexibility. Next year the baseline budget will need either cuts or new borrowing to replace this \u00a3194k.","figures":"\u00a3193.7k one-off business rates transitional relief; described as 'non-recurrent benefit'","quote":"the Council has also received a one-off transitional relief against this years budgeted increase in business rates following the Valuation Offices 2026 revaluation list, which significantly impacted Central Car Park. Whilst a relief was anticipated, this could not be quantified prior to the Medium Term Financial Strategy (MTFS) being approved...this relief is a non-recurrent benefit this year.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-08-18"},"name":"Lincoln City","daily_post":{"iso":"2026-09-17","since_iso":"2026-08-18","distress":false,"headline":"HRA further borrowing is anticipated, with HRA financing costs at 30.64% of revenue - substantially higher than General Fund at 15.18%.","lead":"HRA borrowing is often constrained by rent-setting limits and welfare benefit caps. At 30.64% financing costs to revenue, the HRA has limited flexibility; anticipated further borrowing will tighten position further.","also":["13 other findings in this window","1 paper caught"],"watch":"Audit Committee on 2026-09-21","n_findings":14,"n_documents":1,"top_paper_title":"Treasury Management Q1 26.27 Exec","top_paper_url":"https://lincoln.moderngov.co.uk/documents/s80928/80928.pdf","draft":true},"findings_total":68,"news_drafts_total":3}}