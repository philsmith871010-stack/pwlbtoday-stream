re.moderngov.co.uk/documents/s208258/appendix-1-annual-governance-statement-2025-26.pdf","committee":"Audit and Standards Committee","date":"07/07/2026","key":true},{"title":"7. Agenda Item 7 (26 June 2026) Business Plan Outturn Report 2025-2026","url":"https://Staffordshire.moderngov.co.uk/documents/s208115/7-agenda-item-7-26-june-2026-business-plan-outturn-report-20.pdf","committee":"Pensions Committee","date":"26/06/2026","key":false}],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-24","committee":"Economy, Infrastructure and Communities Overview and Scrutiny Committee","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-25","committee":"Pensions Committee","time":"10:00am","status":"Confirmed","webcast":false,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-25","committee":"Pensions Board","time":"1:30pm","status":"Confirmed","webcast":false,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-28","committee":"County Council","time":"10:00am","status":"Confirmed; Extraordinary Meeting","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-29","committee":"Audit and Standards Committee","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-10-05","committee":"Corporate Overview and Scrutiny Committee","time":"10:00am","status":"Provisional; Reserved for call-in","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-10-08","committee":"County Council","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-10-15","committee":"Safeguarding and Education Overview and Scrutiny Committee","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"}],"recent":[{"date":"2026-09-07","committee":"Corporate Overview and Scrutiny Committee","time":"10:00am","status":"Provisional; Reserved for call-in","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-08","committee":"Corporate Overview and Scrutiny Committee","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-10","committee":"Safeguarding and Education Overview and Scrutiny Committee","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-14","committee":"Health and Care Overview and Scrutiny Committee","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"},{"date":"2026-09-16","committee":"Cabinet","time":"10:00am","status":"Confirmed","webcast":true,"url":"https://staffordshire.moderngov.co.uk"}]},"news":[],"news_drafts":[{"headline":"Authorized borrowing of \u00a3580m but forecast only \u00a3330m\u201443% gap","lead":"Large gaps between authorized and forecast borrowing raise questions about whether capital plans are at risk or whether assumptions have shifted. A lender would need to understand why actual deployment falls so far short of authorization.","iso":"2026-07-28","paper_title":"Appendix 7 - Prudential Indicators","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208747/208747.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Long-term investment forecast cut 88% from budget: \u00a3245m to \u00a330m","lead":"A dramatic cut in planned investment signifies either tighter liquidity or deferred capital schemes. Either would concern a lender assessing the council's cash flow and capital programme delivery.","iso":"2026-07-28","paper_title":"Appendix 7 - Prudential Indicators","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208747/208747.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"LOBO loans with uncertain call dates create refinancing risk the council cannot quantify with standard limits","lead":"LOBO calls create refinancing risk that is not fully predictable; if called, the council must refinance at prevailing market rates regardless of the interest rate environment.","iso":"2026-07-28","paper_title":"Appendix 3 - Prudential Indicators","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208751/208751.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-07-28","committee":"Corporate Overview and Scrutiny Committee","paper_title":"Appendix 7 - Prudential Indicators","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208747/208747.pdf","headline":"Authorized borrowing of \u00a3580m but forecast only \u00a3330m\u201443% gap","detail":"The council's authorized limit for external debt borrowing is set at \u00a3580m, yet the 2026/27 forecast is \u00a3330m, against a budgeted \u00a3497m for external debt loans. This consistent pattern across debt categories suggests either conservative forecasting or constraints on executing planned capital schemes.","category":"borrowing","matters":"Large gaps between authorized and forecast borrowing raise questions about whether capital plans are at risk or whether assumptions have shifted. A lender would need to understand why actual deployment falls so far short of authorization.","figures":"Authorized \u00a3580m, Forecast \u00a3330m, Budgeted loans \u00a3497m","quote":"External Debt \u2013 Authorised Limit for borrowing 580 330","material":true},{"iso":"2026-07-28","committee":"Corporate Overview and Scrutiny Committee","paper_title":"Appendix 7 - Prudential Indicators","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208747/208747.pdf","headline":"Long-term investment forecast cut 88% from budget: \u00a3245m to \u00a330m","detail":"The upper limit for principal sums to be invested for longer than a year is forecast at \u00a330m, down sharply from the budgeted \u00a3245.0m. This 88% reduction suggests either significantly constrained cash deployment or major deferrals of planned investment.","category":"capital","matters":"A dramatic cut in planned investment signifies either tighter liquidity or deferred capital schemes. Either would concern a lender assessing the council's cash flow and capital programme delivery.","figures":"Budget \u00a3245.0m, Forecast \u00a330m","quote":"Upper limit for total principal sums invested for longer than a year 245.0 30","material":true},{"iso":"2026-07-28","committee":"Corporate Overview and Scrutiny Committee","paper_title":"Appendix 3 - Prudential Indicators","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208751/208751.pdf","headline":"LOBO loans with uncertain call dates create refinancing risk the council cannot quantify with standard limits","detail":"The council holds LOBO loans (Lender Option Borrower Option) where the lender can force early repayment at specified points. This creates uncertainty that prevents using the standard practice of limiting debt maturity to 15% per year. Instead, the council manages exposure via a stress-test graph, acknowledging 'the actual pattern of repayment, although uncertain, will not be of this magnitude.'","category":"borrowing","matters":"LOBO calls create refinancing risk that is not fully predictable; if called, the council must refinance at prevailing market rates regardless of the interest rate environment.","figures":"No breakdown given for LOBO holdings; limits are shown in graph at Appendix 1","quote":"LOBO loans with uncertain call dates and the use of internal cash, specific indicators have not been set. Instead, the County Council will manage its exposures within the limits shown in the graph at Appendix 1.","material":true},{"iso":"2026-07-15","committee":"Cabinet","paper_title":"Treasury Management Report for the Year Ended 31 March 2026","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208344/208344.pdf","headline":"Lender exercised call option on \u00a315 million LOBO, forcing refinancing at higher rates","detail":"The council was forced to repay a \u00a315 million LOBO early when the lender exercised call options due to rising interest rates. This demonstrates the refinancing risk embedded in LOBO structures where the lender controls timing.","category":"borrowing","matters":"Shows the council carries LOBOs with embedded lender options that could force refinancing at adverse rates when markets move against the council","figures":"\u00a315.000 million LOBO repaid early","quote":"the County Council repaid a \u00a315.000 million LOBO loan early due to the lender exercising their call options and increasing the interest rate.","material":true},{"iso":"2026-07-15","committee":"Cabinet","paper_title":"Treasury Management Report for the Year Ended 31 March 2026","paper_url":"https://staffordshire.moderngov.co.uk/documents/s208344/208344.pdf","headline":"Gilt yields spiked sharply in March 2026 due to Middle East conflict and remain elevated","detail":"PWLB rates rose significantly in March 2026 following geopolitical events and have remained high. Treasury advisers forecast Bank Rate will stay at 3.75% through 2026/27, but markets expect rates may hold or increase to combat inflation.","category":"borrowing","matters":"The council's strategy of using internal cash to avoid borrowing depends on access to reasonable future rates; persistent higher rates would increase costs for any future borrowing","figures":"Bank Rate reduced to 3.75% in December 2025 and held at that level; PWLB rates spiked in March 2026","quote":"Gilt yields rose significantly in March 2026 at the start of the Middle East conflict and have remained elevated since.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-08-12"},"name":"Staffordshire CC","findings_total":100,"news_drafts_total":3}}