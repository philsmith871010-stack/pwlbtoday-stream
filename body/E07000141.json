r.","fy":"2025/26","as_of_doc":"Treasury Management Annual Report 2025/26","as_of_url":"https://moderngov.southkesteven.gov.uk/documents/s51933/Treasury Management Annual Report 202526.pdf","as_of_date":"2026-07-23","signals":[{"code":"reserves-drawdown","headline":"Investments fell \u00a319.6m in 2025/26 (\u00a362.767m to \u00a343.141m) as capital spend was funded wholly from reserves; council flags cashflow management getting harder as reserves keep decreasing","why":"The internal cash that currently substitutes for \u00a326.174m of borrowing is shrinking, bringing forward the point where external borrowing is needed."}],"key_figures":[{"name":"cfr","value":"\u00a3102.722m (up from \u00a3100.113m a year earlier)","as_at":"31/3/26","page":4},{"name":"borrowing","value":"\u00a376.548m, wholly HRA debt, average rate 2.57%","as_at":"31/3/26","page":4},{"name":"internal borrowing","value":"under-borrowed by \u00a326.174m (CFR \u00a3102.722m vs debt \u00a376.548m)","as_at":"31/3/26","page":4},{"name":"maturity under 12m","value":"\u00a33.221m of the \u00a376.548m debt repayable within 12 months; \u00a373.327m long-term","as_at":"31/3/26","page":4},{"name":"investments","value":"\u00a343.141m at average 4.30%, down from \u00a362.767m at 31/3/25","as_at":"31/3/26","page":4},{"name":"treasury outturn vs budget","value":"investment returns \u00a32.718m vs \u00a32.748m budget (\u00a30.030m adverse, lower balances after HRA reserve drawdown)","as_at":"2025/26","page":5},{"name":"ccla property fund","value":"\u00a33m invested; value \u00a32.619m (notional loss \u00a30.381m) vs cumulative dividends \u00a30.748m; IFRS 9 statutory override in place until 1 April 2029","as_at":"31/3/26","page":5}],"commercial":null,"tms_components":null},"compliance":null,"documents":[{"title":"LeisureSK Finance Outturn 2025-26","url":"https://southkesteven.moderngov.co.uk/documents/s51983/leisuresk-finance-outturn-2025-26.pdf","committee":"Culture and Leisure Overview and Scrutiny Committee","dat