ear":"2020 est.","kind":"int"},{"label":"GVA (balanced, total)","value":1758000.0,"year":"2023","kind":"money"},{"label":"GVA per head","value":20864,"year":"2023","kind":"gbp"},{"label":"GDP per head","value":24524,"year":"2023","kind":"gbp"},{"label":"Band D council tax (area bill)","value":2465.98,"year":"2026-27","kind":"gbp"},{"label":"Band D \u2014 council's own element","value":276.46,"year":"2026-27","kind":"gbp"}]}},"dossier":{"summary":null,"compliance":null,"documents":[],"read_documents":[],"calendar":{"upcoming":[{"date":"2026-09-21","committee":"Audit Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-09-24","committee":"Council","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-10-12","committee":"Communities and Wellbeing Overview and Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-10-14","committee":"Special Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-10-21","committee":"Cabinet","time":"5.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-11-11","committee":"Resources Overview and Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-11-12","committee":"Council","time":"7.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-11-18","committee":"Special Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"}],"recent":[{"date":"2026-07-29","committee":"Resources Overview and Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-07-30","committee":"Communities and Wellbeing Overview and Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-08-04","committee":"Special Scrutiny Committee","time":"4.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-08-05","committee":"Cabinet","time":"5.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"},{"date":"2026-09-02","committee":"Cabinet","time":"5.00 pm","status":"Confirmed","webcast":false,"url":"https://democracy.hyndburnbc.gov.uk"}]},"news":[],"news_drafts":[{"headline":"The council is planning to draw down useable reserves over the MTFS period to support the revenue budget","lead":"Reserve drawdown to fund revenue is a sign of structural deficit; finite reserves depleting annually will eventually create a financial cliff unless underlying spending or income patterns change, creating risk for creditors.","iso":"2026-08-05","paper_title":"PIs Monitoring and TM strategy Q1 2026/27 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24142/24142.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"The ratio of financing costs to net revenue stream increased to 13.20% from the approved 9.30%, a 42% increase","lead":"A rising financing ratio reduces budgetary flexibility for service delivery and indicates tightening affordability; it is a key metric for lenders assessing whether the council can service debt while maintaining service levels.","iso":"2026-08-05","paper_title":"PIs Monitoring and TM strategy Q1 2026/27 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24142/24142.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true},{"headline":"Capital expenditure forecast has fallen to \u00a318.823m from \u00a344.265m budgeted in February\u2014a 57% reduction in the first quarter","lead":"Significant capital slippage can signal project delivery challenges, procurement delays, or inability to execute planned investment; it affects the CFR and medium-term financial sustainability.","iso":"2026-08-05","paper_title":"PIs Monitoring and TM strategy Q1 2026/27 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24142/24142.pdf","byline":"PWLBintel \u00b7 from committee papers","draft":true}],"findings":[{"iso":"2026-08-05","committee":"Cabinet","paper_title":"PIs Monitoring and TM strategy Q1 2026/27 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24142/24142.pdf","headline":"The council is planning to draw down useable reserves over the MTFS period to support the revenue budget","detail":"The Liability Benchmark revision explicitly includes 'the increased draw down of useable reserves anticipated to support the revenue budget over the MTFS period.' This indicates the council cannot balance current revenue spending from income and is relying on reserve depletion.","category":"reserves","matters":"Reserve drawdown to fund revenue is a sign of structural deficit; finite reserves depleting annually will eventually create a financial cliff unless underlying spending or income patterns change, creating risk for creditors.","figures":"Drawdown amount not quantified in this report","quote":"The inputs that determine the Liability Benchmark have been revised to include the increased capital expenditure relating to vehicle leasing and the increased draw down of useable reserves anticipated to support the revenue budget over the MTFS period.","material":true},{"iso":"2026-08-05","committee":"Cabinet","paper_title":"PIs Monitoring and TM strategy Q1 2026/27 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24142/24142.pdf","headline":"The ratio of financing costs to net revenue stream increased to 13.20% from the approved 9.30%, a 42% increase","detail":"The share of revenue budget consumed by financing costs has risen sharply from budget: 9.30% approved to 13.20% actual at Q1. This indicates either lower-than-expected revenue or higher-than-expected financing demands. The paper's treasury section does not explicitly explain the increase.","category":"other","matters":"A rising financing ratio reduces budgetary flexibility for service delivery and indicates tightening affordability; it is a key metric for lenders assessing whether the council can service debt while maintaining service levels.","figures":"Approved 9.30%, Q1 actual 13.20%; increase of 3.9 percentage points","quote":"Estimated Ratio of Financing Costs to Net Revenue Stream 9.30% 13.20%","material":true},{"iso":"2026-08-05","committee":"Cabinet","paper_title":"PIs Monitoring and TM strategy Q1 2026/27 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24142/24142.pdf","headline":"Capital expenditure forecast has fallen to \u00a318.823m from \u00a344.265m budgeted in February\u2014a 57% reduction in the first quarter","detail":"The council's capital expenditure forecast for 2026/27 has been substantially revised downward from the February budget. The council attributes this to 'additional slippage in the capital programme.' This reduction of \u00a325.4m represents a major change in planned capital investment within the first quarter of the financial year.","category":"capital","matters":"Significant capital slippage can signal project delivery challenges, procurement delays, or inability to execute planned investment; it affects the CFR and medium-term financial sustainability.","figures":"Budgeted \u00a344.265m (February 2026), forecast \u00a318.823m (30 June 2026)\u2014a reduction of \u00a325.442m","quote":"The current figure takes account of additional slippage in the capital programme where spend will now be incurred in 2026/27.","material":true},{"iso":"2026-08-05","committee":"Cabinet","paper_title":"Capital Programme Monitoring 2026/27 Q1 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24144/24144.pdf","headline":"Pride in Place grant of \u00a31.5m must be fully spent by 31 March 2027, requiring acceleration or risk of clawback","detail":"The council received \u00a31.5m in Pride in Place Impact Fund grant which must be spent by 31 March 2027. The council is already managing slippage by stating that \"funding may be allocated to alternative schemes if any approved scheme is not likely to complete by the deadline\". Additionally, \u00a3230k of a separate \u00a3270k parks grant will be shifted to 2027/28.","category":"income","matters":"Time-bound grant funding creates a hard deadline for expenditure and introduces execution risk. Failure to spend triggers grant clawback, which would require either reserve funding or project cancellation.","figures":"\u00a31.5m grant; \u00a3230k of \u00a3270k additional parks grant shifted to 2027/28; deadline 31 March 2027","quote":"The Council has received grant funding of \u00a31.5m which must be spent by 31 st March 2027. This funding has been allocated to several schemes which will be closely monitored to ensure completion by the deadline. Funding may be allocated to alternative schemes if any approved scheme is not likely to complete by the deadline.","material":true},{"iso":"2026-08-05","committee":"Cabinet","paper_title":"Capital Programme Monitoring 2026/27 Q1 - Main Report","paper_url":"http://democracy.hyndburnbc.gov.uk/documents/s24144/24144.pdf","headline":"Only 18% of rephased capital budget spent by Q1 despite \u00a325.923m of projects rephased into future years","detail":"As of 30 June 2026, the council had spent or committed only \u00a33.412m of the rephased \u00a318.824m budget for 2026/27, representing 18.12% of planned spend. Meanwhile, \u00a325.923m (58% of the approved capital budget) has been rephased into 2027/28. This combination suggests either slow project starts or significant delivery slippage beyond what has yet been formally recognized.","category":"capital","matters":"Consistently low Q1 spend relative to rephased budgets indicates either optimistic forecasting or execution constraints that will compound cash flow and borrowing requirements in future years.","figures":"\u00a33.412m spent/committed of \u00a318.824m budget at Q1; \u00a325.923m rephased to 2027/28; 18.12% spend rate","quote":"As of 30th June 2026, actual and committed expenditure totals \u00a33.412m, representing 18.12% of the rephased 2026/27 budget of \u00a318.824m.","material":true}],"editorial":null,"freshness":{"last_paper_iso":"2026-08-05"},"name":"Hyndburn BC","findings_total":54,"news_drafts_total":3}}